<?xml version="1.0" encoding="utf-8"?>
<!-- Test settings for every `dotnet test` run: check.bat, CI, IDEs and plain
     command lines. Wired in once, through RunSettingsFilePath in
     Directory.Build.props. -->
<RunSettings>
  <RunConfiguration>
    <!-- A test project that runs zero tests is a failure, not a pass. On
         2026-09-23 Windows Application Control blocked the Release
         OrdoSort.Wpf.Tests.dll: xUnit skipped all 2,364 tests, printed
         "No test is available", and check.bat still exited 0. -->
    <TreatNoTestsAsError>true</TreatNoTestsAsError>
  </RunConfiguration>
</RunSettings>
