<?xml version="1.0" encoding="utf-8"?>
<!-- Test settings for every `dotnet test` run: check.bat, CI, IDEs and plain
     command lines. Wired in once, through RunSettingsFilePath in
     Directory.Build.props. -->
<RunSettings>
  <RunConfiguration>
    <!-- A test project that runs zero tests is a failure, not a pass: when
         Windows Application Control blocks a test DLL, xUnit skips every
         test and would otherwise exit 0. -->
    <TreatNoTestsAsError>true</TreatNoTestsAsError>
  </RunConfiguration>
  <!-- A test that stops making progress for 15 minutes fails the run with a
       small dump in TestResults/, instead of hanging it (one hung for six
       hours on 2026-09-26). Everyday tests finish in well under a second,
       but GitHub's runner is slow on disk: the History stress tests take 2-5
       minutes there, and a 5-minute limit cut one off (2026-09-27). -->
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="blame" enabled="True">
        <Configuration>
          <CollectDumpOnTestSessionHang TestTimeout="15m" HangDumpType="mini" />
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
