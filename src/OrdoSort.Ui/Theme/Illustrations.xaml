<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Theme-aware empty-state pictures, in the 2026-09 brand style: the
         index-divider tabs of the app icon, flat shapes, one bronze accent
         each (Theme.AccentBronze, the brand accent), outlines in
         Theme.BorderStrong, "paper" in Theme.Surface. Theme.StatusGreen is
         kept for the two checkmarks that mean done/clear.

         Why a Viewbox of Path elements and not a DrawingImage: a
         GeometryDrawing's brush is a Freezable property, and Freezables don't
         re-resolve a DynamicResource when the theme changes. Path is a
         FrameworkElement, so its Stroke/Fill do.

         Each picture is a ControlTemplate for a bare ContentControl; the four
         call sites (ReadyView, DoneView, LabelMakerWindow, UnlockWindow) set
         only Template and Height. Shapes are drawn back to front, and every
         shape that overlaps another has an opaque fill, so nothing behind it
         shows through. -->

    <!-- inbox-clear: ReadyView's empty-inbox picture (104px). An open tray
         with its divider tabs standing up in it, the front tab bronze, and a
         check on the tray: the inbox, sorted and clear. -->
    <ControlTemplate x:Key="Illustration.InboxClear" TargetType="ContentControl">
        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="100" Height="100">
                <Path Data="M 20,48 L 20,26 L 40,26 L 40,48"
                      Fill="{DynamicResource Theme.Surface}" Stroke="{DynamicResource Theme.BorderStrong}"
                      StrokeThickness="3.5" StrokeLineJoin="Round" />
                <Path Data="M 40,48 L 40,33 L 60,33 L 60,48"
                      Fill="{DynamicResource Theme.Surface}" Stroke="{DynamicResource Theme.BorderStrong}"
                      StrokeThickness="3.5" StrokeLineJoin="Round" />
                <Path Data="M 60,48 L 60,40 L 80,40 L 80,48 Z"
                      Fill="{DynamicResource Theme.AccentBronze}" Stroke="{DynamicResource Theme.AccentBronze}"
                      StrokeThickness="3.5" StrokeLineJoin="Round" />
                <Path Data="M 12,48 L 88,48 L 88,82 A 4,4 0 0 1 84,86 L 16,86 A 4,4 0 0 1 12,82 Z"
                      Fill="{DynamicResource Theme.Surface}" Stroke="{DynamicResource Theme.BorderStrong}"
                      StrokeThickness="3.5" StrokeLineJoin="Round" />
                <Path Data="M 38,66 L 47,75 L 64,57"
                      Stroke="{DynamicResource Theme.StatusGreen}" StrokeThickness="5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- done: DoneView's completion picture (96px). A divider card, its
         bronze tab on top, with a check on it: filed. -->
    <ControlTemplate x:Key="Illustration.Done" TargetType="ContentControl">
        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="100" Height="100">
                <Path Data="M 50,20 L 72,20 L 72,30 L 50,30 Z"
                      Fill="{DynamicResource Theme.AccentBronze}" Stroke="{DynamicResource Theme.AccentBronze}"
                      StrokeThickness="3.5" StrokeLineJoin="Round" />
                <Path Data="M 18,30 L 82,30 L 82,82 A 4,4 0 0 1 78,86 L 22,86 A 4,4 0 0 1 18,82 Z"
                      Fill="{DynamicResource Theme.Surface}" Stroke="{DynamicResource Theme.BorderStrong}"
                      StrokeThickness="3.5" StrokeLineJoin="Round" />
                <Path Data="M 36,58 L 46,68 L 66,46"
                      Stroke="{DynamicResource Theme.StatusGreen}" StrokeThickness="5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- labels-empty: LabelMakerWindow's no-clients-yet picture (76px). The
         front of an archive box, the Box Labels icon's shape: lid, handle
         hole, and a label spot drawn dashed because nothing is on it yet.
         No green: "nothing here yet" is not a completed state. -->
    <ControlTemplate x:Key="Illustration.LabelsEmpty" TargetType="ContentControl">
        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="100" Height="100">
                <Path Data="M 16,34 L 84,34 L 84,82 A 4,4 0 0 1 80,86 L 20,86 A 4,4 0 0 1 16,82 Z"
                      Fill="{DynamicResource Theme.Surface}" Stroke="{DynamicResource Theme.BorderStrong}"
                      StrokeThickness="3.5" StrokeLineJoin="Round" />
                <Path Data="M 12,22 L 88,22 L 88,34 L 12,34 Z"
                      Fill="{DynamicResource Theme.Surface}" Stroke="{DynamicResource Theme.BorderStrong}"
                      StrokeThickness="3.5" StrokeLineJoin="Round" />
                <Path Data="M 43,44 L 57,44 A 4,4 0 0 1 57,52 L 43,52 A 4,4 0 0 1 43,44 Z"
                      Fill="{DynamicResource Theme.BorderStrong}" />
                <Path Data="M 35,62 L 70,62 L 70,76 L 35,76"
                      Stroke="{DynamicResource Theme.SubtleText}" StrokeThickness="2.5"
                      StrokeDashArray="2.5 2" StrokeLineJoin="Round" />
                <Path Data="M 30,62 L 35,62 L 35,76 L 30,76 Z"
                      Fill="{DynamicResource Theme.AccentBronze}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- unlock: UnlockWindow's no-files-yet picture (80px). A padlock with
         its shackle lifted open on the right. The shackle is drawn FIRST and
         the body over it with an opaque fill, so its left leg disappears into
         the body instead of showing through it (the old drawing did; pinned
         by IllustrationTests). Bronze keyhole. -->
    <ControlTemplate x:Key="Illustration.Unlock" TargetType="ContentControl">
        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="100" Height="100">
                <Path Data="M 34,56 L 34,30 A 16,16 0 0 1 66,30 L 66,38"
                      Stroke="{DynamicResource Theme.SubtleText}" StrokeThickness="5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path Data="M 24,48 L 76,48 L 76,82 A 4,4 0 0 1 72,86 L 28,86 A 4,4 0 0 1 24,82 Z"
                      Fill="{DynamicResource Theme.Surface}" Stroke="{DynamicResource Theme.BorderStrong}"
                      StrokeThickness="3.5" StrokeLineJoin="Round" />
                <Path Data="M 50,58 A 5,5 0 1 1 49.99,58 Z M 48,66 L 52,66 L 53,76 L 47,76 Z"
                      Fill="{DynamicResource Theme.AccentBronze}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

</ResourceDictionary>
