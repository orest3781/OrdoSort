<Window x:Class="OrdoSort.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:views="clr-namespace:OrdoSort.Wpf.Views"
        xmlns:vm="clr-namespace:OrdoSort.Wpf.ViewModels"
        Title="OrdoSort" Width="1280" Height="860"
        Icon="pack://application:,,,/OrdoSort;component/app.ico"
        Style="{StaticResource {x:Type Window}}">
    <Window.InputBindings>
        <KeyBinding Key="K" Modifiers="Ctrl" Command="{Binding SkipCommand}" />
        <KeyBinding Key="Z" Modifiers="Ctrl+Shift" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Escape" Command="{Binding StopCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <!-- The notification-rail item (Phase 3, Task 3.3 — approved
             mockup): icon · message (+ smaller detail run) · action link ·
             dismiss, one row per live notice in ShellViewModel.Notices. Kept
             as a KEYED resource (unlike the old floating toast, which lived
             fully inline) specifically so HighlightContrastTests can resolve
             the REAL production template by key — the exact technique
             Theme/Styles.xaml's KvpValueTemplate/FontChoiceTemplate already
             use — and apply it to a loose ContentPresenter, instead of
             needing a live, Show()n MainWindow with a connected
             PresentationSource just to force the ItemsControl to generate a
             container. Show()ing MainWindow starts a REAL WebView2/Edge
             process via _pdf.InitAsync on Loaded — the entire reason the
             original toast-icon test went out of its way to avoid it (see
             MainWindowToastIconContrast's own doc comment) — and this
             preserves that.

             The WARNING look (item bg Theme.Warning, text/icon
             Theme.WarningText — the pairing ThemeTests.
             EveryTextPairingMeetsWcagAa already enforces) is the template's
             own declared/base look; the ERROR look (item bg
             Theme.SurfaceRaised with a 1px Theme.Border, a
             Theme.StatusRedRaised icon — the exact pairing
             HighlightContrastTests.MainWindowToastIconContrast enforces,
             carried over unchanged from the old floating toast) is the ONE
             DataTrigger override below. TargetName Setters in a
             DataTemplate's own Triggers outrank the same element's
             template-declared values — the same precedence every
             ControlTemplate.Triggers block elsewhere in this file (the old
             banners/toast among them) already relies on. -->
        <DataTemplate x:Key="NoticeItemTemplate" DataType="{x:Type vm:NoticeVm}">
            <Border x:Name="Card" CornerRadius="4" Padding="10,8" Margin="0,0,0,6"
                    Background="{DynamicResource Theme.Warning}" BorderThickness="0"
                    SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="Slide" />
                </Border.RenderTransform>
                <!-- entrance: fade + 16px slide-up over 150ms, the same
                     vocabulary the old toast used — fires once per container,
                     i.e. once per genuinely NEW notice (see
                     ShellViewModel.RefreshNotices' own comment for why an
                     existing notice's text updates in place instead of
                     recreating this container and replaying this). -->
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.15" />
                                <DoubleAnimation Storyboard.TargetName="Slide"
                                                 Storyboard.TargetProperty="Y"
                                                 From="16" To="0" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="KindIcon" Grid.Column="0" Text="⚠" FontSize="16"
                               VerticalAlignment="Top" Margin="0,1,10,0"
                               Foreground="{DynamicResource Theme.WarningText}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="MessageText" Text="{Binding Message}"
                                   Style="{StaticResource EmphasisText}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Theme.WarningText}" />
                        <TextBlock x:Name="DetailText" Text="{Binding Detail}" TextWrapping="Wrap"
                                   FontSize="12" Margin="0,2,0,0" Opacity="0.85"
                                   Foreground="{DynamicResource Theme.WarningText}"
                                   Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- action link: the item's existing click behaviour
                         (ShellViewModel.NoticeActionFor reuses the exact same
                         command each old banner/toast already had), now an
                         explicit, real, focusable, underlined text link. -->
                    <Button Grid.Column="2" Command="{Binding ActionCommand}"
                            Cursor="Hand" VerticalAlignment="Center" Margin="12,0,10,0"
                            AutomationProperties.Name="{Binding ActionLabel}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <!-- Foreground carries a Style+DataTrigger,
                                     not a DataTemplate.Triggers TargetName
                                     Setter (MC4111 — this TextBlock lives in
                                     its OWN NameScope, one level down from
                                     the item template's). {Binding Kind}
                                     still resolves to the same NoticeVm:
                                     DataContext flows through a
                                     ControlTemplate uninterrupted. -->
                                <TextBlock x:Name="ActionText" Text="{Binding ActionLabel}"
                                           TextDecorations="Underline" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.WarningText}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:NoticeKind.Error}">
                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ActionText" Property="Opacity" Value="0.75" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- ✕ dismiss: hides this notice until its underlying
                         condition re-raises (ShellViewModel.NoticeDismissFor) —
                         a real Button, not a decoration, so it's reachable and
                         narratable like the action link beside it. -->
                    <Button x:Name="DismissButton" Grid.Column="3" Command="{Binding DismissCommand}"
                            Cursor="Hand" VerticalAlignment="Top" Padding="4"
                            AutomationProperties.Name="Dismiss">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <!-- Same NameScope reasoning as ActionText
                                     above: a local Style+DataTrigger, not a
                                     DataTemplate.Triggers TargetName Setter. -->
                                <TextBlock x:Name="DismissIcon" Text="&#xE711;" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.WarningText}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:NoticeKind.Error}">
                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.SubtleText}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="DismissIcon" Property="Opacity" Value="0.75" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <!-- Error-class (the old toast's job): carried over unchanged
                     from the floating toast this replaces — same background,
                     same border, same icon glyph/size/colour — the pairing
                     HighlightContrastTests.MainWindowToastIconContrast
                     enforces. -->
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:NoticeKind.Error}">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource Theme.SurfaceRaised}" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
                    <Setter TargetName="Card" Property="BorderThickness" Value="1" />
                    <Setter TargetName="KindIcon" Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                    <Setter TargetName="KindIcon" Property="Text" Value="&#xE7BA;" />
                    <Setter TargetName="KindIcon" Property="FontSize" Value="20" />
                    <Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource Theme.StatusRedRaised}" />
                    <Setter TargetName="MessageText" Property="Foreground" Value="{DynamicResource Theme.Text}" />
                    <Setter TargetName="DetailText" Property="Foreground" Value="{DynamicResource Theme.SubtleText}" />
                    <Setter TargetName="DetailText" Property="Opacity" Value="1" />
                    <!-- ActionText/DismissIcon are NOT targeted here: they
                         live inside their own Buttons' ControlTemplates, a
                         SEPARATE NameScope a DataTemplate's own Triggers
                         cannot reach by TargetName (MC4111) — see each
                         Button's own inline TextBlock.Style DataTrigger
                         instead, which reads {Binding Kind} directly since
                         DataContext still flows through the template
                         unbroken. -->
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <Grid DockPanel.Dock="Top" Background="{DynamicResource Theme.WindowBg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- rescan lives in the header, top-right — always in the same
                 spot, hidden while filing (Stop/Esc is the deliberate way
                 out of a session; a stray refresh must not end it) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
            <!-- one mode instead of stacked toggles: Active only (default),
                 All (tiles stay at zero), Hidden (section gone, sweep skipped) -->
            <TextBlock Text="Folders:" VerticalAlignment="Center" Margin="0,0,6,0"
                       Visibility="{Binding TileControlsVisible,
                                    Converter={StaticResource BoolToVis}}" />
            <ComboBox SelectedIndex="{Binding TileVisibilityIndex}"
                      Visibility="{Binding TileControlsVisible,
                                   Converter={StaticResource BoolToVis}}"
                      VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="104"
                      ToolTip="Monitored-folder tiles: only folders holding files, every folder even at zero, or none at all">
                <ComboBoxItem Content="Active only" />
                <ComboBoxItem Content="All" />
                <ComboBoxItem Content="Hidden" />
            </ComboBox>
            <Button Command="{Binding RescanCommand}"
                    Height="26" Padding="10,0" Margin="0,2,6,2"
                    ToolTip="Rescan the inbox now">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource Theme.SurfaceHover}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <!-- BodySmallText size — Icon style already sets
                         FontFamily; converting would drop it. -->
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;"
                               FontSize="12" Margin="0,0,6,0" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
            </StackPanel>

            <Menu Padding="4,2">
            <MenuItem Header="_File">
                <MenuItem Header="_Settings…" Click="OnSettings" InputGestureText="Ctrl+,">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE713;" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="_View history…" Click="OnViewHistory">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Export history to spreadsheet…"
                          Command="{Binding ExportHistoryCommand}">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="E_xit" Click="OnExit">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Unlock PDFs…" Click="OnUnlock">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE785;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Bulk rename…" Click="OnBulkRename">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8AC;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Match and merge…" Click="OnMatchMerge">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE721;" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Bo_x labels…" Click="OnLabelMaker">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8EC;" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            </Menu>
        </Grid>

        <!-- notification rail (Phase 3, Task 3.3 — approved mockup): the
             single replacement for the old set-aside banner, history-backup
             banner, and floating alert toast, which used to render (and
             animate, and hit-test) as three completely uncoordinated
             surfaces. One vertical stack of notice rows, docked at the
             window's bottom edge — it IS the bottom edge, there is no
             separate "banner slot" any more. Visibility is driven by
             HasNotices rather than the ItemsControl's own emptiness so the
             1px top separator/padding never renders as a bare strip when
             there is nothing to say. -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Theme.WindowBg}"
                BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,1,0,0"
                Padding="8,12"
                Visibility="{Binding HasNotices, Converter={StaticResource BoolToVis}}">
            <ItemsControl x:Name="NoticeRail" ItemsSource="{Binding Notices}"
                          ItemTemplate="{StaticResource NoticeItemTemplate}"
                          Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ViewerCol" Width="*" MinWidth="320" />
                <ColumnDefinition x:Name="SplitterCol" Width="5" />
                <ColumnDefinition x:Name="PanelCol" Width="430" MinWidth="370" />
            </Grid.ColumnDefinitions>
            <!-- data-entry tab order: the browser would trap Tab in the PDF
                 toolbar, and the splitter/ScrollViewer are focus-ring noise —
                 Tab goes menu → name box → buttons. Mouse still focuses the
                 viewer for keyboard scrolling inside the PDF. -->
            <wv2:WebView2 x:Name="Viewer" Grid.Column="0" Focusable="False" />
            <GridSplitter x:Name="Split" Grid.Column="1" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          IsTabStop="False" />
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Focusable="False"
                          Background="{DynamicResource Theme.WindowBg}">
                <Grid Margin="16,12">
                    <Grid.Resources>
                        <!-- screens fade in over 150 ms — enough to soften the
                             switch, never enough to make anyone wait -->
                        <Style x:Key="ScreenFade" TargetType="UserControl">
                            <Style.Triggers>
                                <Trigger Property="Visibility" Value="Visible">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Resources>
                    <views:ReadyView Style="{StaticResource ScreenFade}"
                                     Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}" />
                    <views:ProcessingView Style="{StaticResource ScreenFade}"
                                          Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}" />
                    <views:DoneView Style="{StaticResource ScreenFade}"
                                    Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
