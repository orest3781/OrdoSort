<Window x:Class="OrdoSort.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:views="clr-namespace:OrdoSort.Wpf.Views"
        Title="OrdoSort" Width="1280" Height="860"
        Icon="pack://application:,,,/OrdoSort;component/app.ico"
        Style="{StaticResource {x:Type Window}}">
    <Window.InputBindings>
        <KeyBinding Key="K" Modifiers="Ctrl" Command="{Binding SkipCommand}" />
        <KeyBinding Key="Z" Modifiers="Ctrl+Shift" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Escape" Command="{Binding StopCommand}" />
    </Window.InputBindings>
    <Grid>
    <DockPanel>
        <Grid DockPanel.Dock="Top" Background="{DynamicResource Theme.WindowBg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- rescan lives in the header, top-right — always in the same
                 spot, hidden while filing (Stop/Esc is the deliberate way
                 out of a session; a stray refresh must not end it) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
            <!-- one mode instead of stacked toggles: Active only (default),
                 All (tiles stay at zero), Hidden (section gone, sweep skipped) -->
            <TextBlock Text="Folders:" VerticalAlignment="Center" Margin="0,0,6,0"
                       Visibility="{Binding TileControlsVisible,
                                    Converter={StaticResource BoolToVis}}" />
            <ComboBox SelectedIndex="{Binding TileVisibilityIndex}"
                      Visibility="{Binding TileControlsVisible,
                                   Converter={StaticResource BoolToVis}}"
                      VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="104"
                      ToolTip="Monitored-folder tiles: only folders holding files, every folder even at zero, or none at all">
                <ComboBoxItem Content="Active only" />
                <ComboBoxItem Content="All" />
                <ComboBoxItem Content="Hidden" />
            </ComboBox>
            <Button Command="{Binding RescanCommand}"
                    Height="26" Padding="10,0" Margin="0,2,6,2"
                    ToolTip="Rescan the inbox now">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource Theme.SurfaceHover}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <!-- BodySmallText size — Icon style already sets
                         FontFamily; converting would drop it. -->
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;"
                               FontSize="12" Margin="0,0,6,0" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
            </StackPanel>

            <Menu Padding="4,2">
            <MenuItem Header="_File">
                <MenuItem Header="_Settings…" Click="OnSettings" InputGestureText="Ctrl+,">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE713;" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="_View history…" Click="OnViewHistory">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Export history to spreadsheet…"
                          Command="{Binding ExportHistoryCommand}">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="E_xit" Click="OnExit">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Unlock PDFs…" Click="OnUnlock">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE785;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Bulk rename…" Click="OnBulkRename">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8AC;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Match and merge…" Click="OnMatchMerge">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE721;" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Bo_x labels…" Click="OnLabelMaker">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8EC;" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            </Menu>
        </Grid>

        <!-- set-aside banner: a full-width filled warning bar on every screen
             while deferred files exist — the old thin status-bar text was too
             easy to miss. Clicking opens the folder. -->
        <!-- EmphasisText size — FontSize/FontWeight are set on the Button and
             inherit into the single TextBlock inside Button.Template below;
             EmphasisText/SectionText are TextBlock-only, and reaching into
             the template to move them would be template surgery for a
             rename-only pass. -->
        <Button DockPanel.Dock="Bottom"
                Command="{Binding OpenDeferredCommand}"
                Visibility="{Binding HasDeferred, Converter={StaticResource BoolToVis}}"
                Cursor="Hand" FontWeight="SemiBold" FontSize="15"
                AutomationProperties.Name="{Binding DeferredAlert}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bar" Background="{DynamicResource Theme.Warning}"
                            Padding="14,11" SnapsToDevicePixels="True">
                        <TextBlock Text="{Binding DeferredAlert}"
                                   Foreground="{DynamicResource Theme.WarningText}"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bar" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- history-backup banner: same full-width pattern as the set-aside
             bar above, for the same reason — a daily backup that keeps
             failing (permissions, a full disk, a disconnected share) used to
             fail silently forever (2026-08-07 QC sweep R1). Stays up for the
             rest of the session rather than a modal, which would either
             block startup or reappear on every single launch for as long as
             the underlying problem lasts. Clicking opens the backups folder
             so the user can see what's there (or isn't). -->
        <!-- EmphasisText size — same as the set-aside banner above: Button-
             level FontSize/FontWeight inherited by the template's one
             TextBlock; left literal rather than reaching into the template. -->
        <Button DockPanel.Dock="Bottom"
                Command="{Binding OpenHistoryBackupFolderCommand}"
                Visibility="{Binding HasHistoryBackupWarning, Converter={StaticResource BoolToVis}}"
                Cursor="Hand" FontWeight="SemiBold" FontSize="15"
                AutomationProperties.Name="{Binding HistoryBackupWarning}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bar" Background="{DynamicResource Theme.Warning}"
                            Padding="14,11" SnapsToDevicePixels="True">
                        <TextBlock Text="{Binding HistoryBackupWarning}"
                                   Foreground="{DynamicResource Theme.WarningText}"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bar" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ViewerCol" Width="*" MinWidth="320" />
                <ColumnDefinition x:Name="SplitterCol" Width="5" />
                <ColumnDefinition x:Name="PanelCol" Width="430" MinWidth="370" />
            </Grid.ColumnDefinitions>
            <!-- data-entry tab order: the browser would trap Tab in the PDF
                 toolbar, and the splitter/ScrollViewer are focus-ring noise —
                 Tab goes menu → name box → buttons. Mouse still focuses the
                 viewer for keyboard scrolling inside the PDF. -->
            <wv2:WebView2 x:Name="Viewer" Grid.Column="0" Focusable="False" />
            <GridSplitter x:Name="Split" Grid.Column="1" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          IsTabStop="False" />
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Focusable="False"
                          Background="{DynamicResource Theme.WindowBg}">
                <Grid Margin="16,12">
                    <Grid.Resources>
                        <!-- screens fade in over 150 ms — enough to soften the
                             switch, never enough to make anyone wait -->
                        <Style x:Key="ScreenFade" TargetType="UserControl">
                            <Style.Triggers>
                                <Trigger Property="Visibility" Value="Visible">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Resources>
                    <views:ReadyView Style="{StaticResource ScreenFade}"
                                     Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}" />
                    <views:ProcessingView Style="{StaticResource ScreenFade}"
                                          Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}" />
                    <views:DoneView Style="{StaticResource ScreenFade}"
                                    Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>

        <!-- new-alert toast: floats bottom-right over everything, above the
             set-aside banner; click opens the alerting folder. Reaches you
             even when the alerting tile is scrolled off or the window is
             unfocused (paired with the taskbar flash + chime). -->
        <Button x:Name="ToastButton" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                Margin="0,0,16,16" MaxWidth="340" Cursor="Hand"
                Command="{Binding OpenToastCommand}"
                Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVis}}"
                AutomationProperties.Name="{Binding ToastText}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Card" CornerRadius="4" Padding="14,12"
                            Background="{DynamicResource Theme.SurfaceRaised}"
                            BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="Slide" />
                        </Border.RenderTransform>
                        <StackPanel Orientation="Horizontal">
                            <!-- Theme.StatusRedRaised, NOT Theme.StatusRed/Danger
                                 (status-colour-vocabulary plan, 2026-08-08,
                                 Task 3 Part B introduced StatusRed here; GAP
                                 CLOSED 2026-08-09): this glyph is real
                                 foreground text (a Segoe icon) on this
                                 Border's REAL background, Theme.SurfaceRaised
                                 — one step LIGHTER than Surface in dark mode
                                 (a floating card needs to read as raised
                                 without a shadow), NOT Theme.Surface/WindowBg
                                 where StatusRed itself was tuned. StatusRed
                                 measured only 4.11:1 there in graphite (short
                                 of this app's 4.5 floor); StatusRedRaised is
                                 a per-scheme value tuned specifically against
                                 SurfaceRaised and clears 4.5:1 in all seven
                                 schemes (see ThemePalette.cs's
                                 StatusRedRaised field comment for the exact
                                 numbers, and HighlightContrastTests'
                                 MainWindowToastIconContrast for the clean
                                 >=4.5 regression guard that replaced the old
                                 >=3.0 + graphite-pin compromise). -->
                            <!-- HeadlineCompactText size — Icon style already
                                 sets FontFamily; converting would drop it. -->
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="20"
                                       VerticalAlignment="Top" Margin="0,1,11,0"
                                       Foreground="{DynamicResource Theme.StatusRedRaised}" />
                            <StackPanel>
                                <TextBlock Text="{Binding ToastText}" Style="{StaticResource SectionText}" />
                                <TextBlock Text="{Binding ToastDetail}" TextWrapping="Wrap"
                                           Style="{StaticResource SubtleText}" Margin="0,6,0,0" />
                                <TextBlock Text="Click to open the folder"
                                           Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- slide up + fade in when it appears -->
                        <Trigger Property="Visibility" Value="Visible">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="Slide"
                                                         Storyboard.TargetProperty="Y"
                                                         From="16" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush"
                                    Value="{DynamicResource Theme.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
