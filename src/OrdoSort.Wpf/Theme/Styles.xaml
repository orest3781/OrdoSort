<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:OrdoSort.Wpf.Views">

    <!-- All colors come from the Theme.* brushes ThemeManager materializes;
         DynamicResource keeps a live OS light/dark switch working. -->

    <!-- Shared focus ring: a flat bronze outline on every focusable styled
         control. AccentBronze renders here as a 100% flat stroke only — no
         opacity/mix/gradient — per its WCAG-pinned contrast margin. -->
    <Style x:Key="BronzeFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource Theme.AccentBronze}"
                            BorderThickness="2" CornerRadius="4" Margin="-2"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource Theme.WindowBg}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource BronzeFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- radius scale: buttons 4, inputs 4, cards 4, pills 12 —
                         crisp-workbench flattens buttons/inputs/cards to the same 4px -->
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Colored route buttons set Background explicitly; the
                             hover/pressed effect is an opacity veil so it works
                             on ANY background without recomputing shades. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.92" />
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource Theme.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.84" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToggleButton mirrors Button — same chrome, same look in both
         palettes. Can't BasedOn the Button style (TargetType mismatch
         throws), so its setters are duplicated here rather than retargeting
         the shared Button style at ButtonBase and risking every existing
         Button in the app. -->
    <Style TargetType="ToggleButton">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource BronzeFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.92" />
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource Theme.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.84" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Explicit editor menus: WPF's built-in TextBox/PasswordBox context
         menu is made of PRIVATE MenuItem/ContextMenu subclasses, which
         implicit styles never match (exact-type lookup) — so the themed
         menu styles in this file can't reach it. Handing every text box a
         menu of REAL types is the reliable route; ApplicationCommands
         routing keeps enable/disable and the gesture text identical to
         stock. x:Shared=False: each control gets its own instance, so one
         menu is never torn between two placement targets. -->
    <ContextMenu x:Key="EditorContextMenu" x:Shared="False">
        <MenuItem Header="Cut" Command="Cut" />
        <MenuItem Header="Copy" Command="Copy" />
        <MenuItem Header="Paste" Command="Paste" />
        <Separator />
        <MenuItem Header="Select all" Command="SelectAll" />
    </ContextMenu>
    <ContextMenu x:Key="PasswordContextMenu" x:Shared="False">
        <MenuItem Header="Paste" Command="Paste" />
    </ContextMenu>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="CaretBrush" Value="{DynamicResource Theme.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Theme.Accent}" />
        <Setter Property="ContextMenu" Value="{StaticResource EditorContextMenu}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- hover before focus so a focused box stays accent -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource Theme.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource Theme.AccentBronze}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- PasswordBox mirrors TextBox — it previously fell through to the stock
         template, a styling gap the Unlock window wore. -->
    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="CaretBrush" Value="{DynamicResource Theme.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Theme.Accent}" />
        <Setter Property="ContextMenu" Value="{StaticResource PasswordContextMenu}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource Theme.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource Theme.AccentBronze}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slim track-less scrollbars: the stock ones are the loudest "old app"
         signal, especially in dark mode. Thumb only — Border at rest,
         SubtleText under the pointer. -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" Background="{DynamicResource Theme.Border}"
                            CornerRadius="4" Margin="2" SnapsToDevicePixels="True" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background"
                                    Value="{DynamicResource Theme.SubtleText}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background"
                                    Value="{DynamicResource Theme.SubtleText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollPage}"
                                          Command="ScrollBar.PageUpCommand" />
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}" />
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollPage}"
                                          Command="ScrollBar.PageDownCommand" />
                        </Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPage}"
                                                  Command="ScrollBar.PageLeftCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPage}"
                                                  Command="ScrollBar.PageRightCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <Style TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource Theme.WindowBg}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
    </Style>

    <!-- MenuItem is fully retemplated: the stock Windows template hardcodes a
         LIGHT popup background while the item text follows the overridden
         SystemColors menu-text brush — in dark mode that made dropdowns
         white-on-white. Four roles, one look, all brushes from the theme. -->

    <ControlTemplate x:Key="MenuTopLevelHeader" TargetType="MenuItem">
        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="10,5"
                SnapsToDevicePixels="True">
            <Grid>
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                  VerticalAlignment="Center" />
                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}"
                       Placement="Bottom" AllowsTransparency="True" Focusable="False"
                       PopupAnimation="Fade">
                    <Border Background="{DynamicResource Theme.Surface}"
                            BorderBrush="{DynamicResource Theme.Border}"
                            BorderThickness="1" CornerRadius="4" Padding="4" Margin="0,2,8,8">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background"
                        Value="{DynamicResource Theme.SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="Bd" Property="Background"
                        Value="{DynamicResource Theme.SurfacePressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Theme.SubtleText}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="MenuTopLevelItem" TargetType="MenuItem">
        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="10,5"
                SnapsToDevicePixels="True">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                              VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background"
                        Value="{DynamicResource Theme.SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Theme.SubtleText}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="MenuSubmenuItem" TargetType="MenuItem">
        <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                Padding="10,7" SnapsToDevicePixels="True" MinWidth="220">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter ContentSource="Icon" VerticalAlignment="Center"
                                  HorizontalAlignment="Left" />
                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                  RecognizesAccessKey="True" VerticalAlignment="Center" />
                <TextBlock x:Name="Gesture" Grid.Column="2" Margin="24,0,4,0"
                           VerticalAlignment="Center"
                           Text="{TemplateBinding InputGestureText}"
                           Foreground="{DynamicResource Theme.SubtleText}" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background"
                        Value="{DynamicResource Theme.Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource Theme.AccentText}" />
                <Setter TargetName="Gesture" Property="Foreground"
                        Value="{DynamicResource Theme.AccentText}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Theme.SubtleText}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="MenuSubmenuHeader" TargetType="MenuItem">
        <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                Padding="10,7" SnapsToDevicePixels="True" MinWidth="220">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                  VerticalAlignment="Center" />
                <Path Grid.Column="1" Margin="24,0,4,0" VerticalAlignment="Center"
                      Data="M 0 0 L 4 4 L 0 8 Z"
                      Fill="{DynamicResource Theme.SubtleText}" />
                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}"
                       Placement="Right" AllowsTransparency="True" Focusable="False"
                       PopupAnimation="Fade">
                    <Border Background="{DynamicResource Theme.Surface}"
                            BorderBrush="{DynamicResource Theme.Border}"
                            BorderThickness="1" CornerRadius="4" Padding="4" Margin="0,0,8,8">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background"
                        Value="{DynamicResource Theme.SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Theme.SubtleText}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- NOT broken, verified directly (2026-08-02): unlike ComboBoxItem's
         plain-string Content, a MenuItem.Header string with an access-key
         underscore is auto-wrapped by ContentPresenter's RecognizesAccessKey
         path into an AccessText, and AccessText does NOT derive from
         TextBlock — so the app-level implicit TextBlock style below never
         applies to it (implicit-style lookup only walks an element's own
         .NET base-type chain, and AccessText's doesn't include TextBlock).
         With no Style Setter in the way, AccessText's Foreground simply
         INHERITS from the templated MenuItem, which the MenuSubmenuItem
         ControlTemplate's IsHighlighted trigger already flips correctly to
         Theme.AccentText — so the highlighted submenu Header was already
         correct. (A prior pass here added a HeaderTemplate Setter to "fix"
         this, based on a measurement that turned out to be a bug in that
         investigation's own test harness — it walked "the first TextBlock
         descendant," which silently drilled past the correctly-colored
         AccessText into a private, always-empty child TextBlock AccessText
         builds internally, reading THAT decoy's unrelated Foreground
         instead. Re-measured against a build with zero occurrences of
         "HeaderTemplate" in the compiled DLL — i.e. provably unfixed — and
         found already-passing: 12.89:1 light / 11.48:1 dark. The Setter was
         reverted: it fixed nothing and would have forced every
         MenuItem.Header in the app through an explicit AccessText,
         swallowing compound Header content the moment one exists.
         HighlightContrastTests.cs keeps a regression case for this that
         passes both with and without any such Setter.) -->
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource MenuTopLevelHeader}" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{StaticResource MenuTopLevelItem}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource MenuSubmenuHeader}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource MenuSubmenuItem}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Margin="8,4"
                               Fill="{DynamicResource Theme.Border}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ContextMenu: the right-click popup chrome. The stock template is a
         hardcoded LIGHT plate (the same trap the MenuItem note above
         describes) — and every right-click menu in this app is WPF's
         built-in editor menu (Cut/Copy/Paste), so this one implicit style
         themes them all. Items already resolve the retemplated MenuItem
         roles. No outer margin: unlike the Menu templates, which own their
         Popup and its transparency, ContextMenu creates its own popup — a
         margin here can render as an opaque dead strip. -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="4">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{DynamicResource Theme.WindowBg}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
    </Style>

    <!-- ItemTemplate-based ComboBox item shapes: a bare TextBlock bound to
         the item, given a LOCAL Foreground binding to its ComboBoxItem
         ancestor. Declared HERE (an app-level ResourceDictionary), not in
         the window that uses them, specifically so both this file's own
         ComboBoxItem fix below AND these two templates are real, loaded
         production resources the test suite resolves by key — not a
         hand-copied stand-in that could silently drift from what actually
         ships. Verified (2026-08-02): ItemsControl assigns ItemTemplate to
         the generated container's ContentTemplate as a LOCAL value, which
         outranks even the ComboBoxItem style's own ContentTemplate Setter
         below — so this binding is not optional decoration, it is the ONLY
         thing that fixes this shape. Without it: 1.35:1 light / 1.27:1 dark
         (WCAG AA failure). With it: 12.89:1 light / 11.48:1 dark. -->
    <DataTemplate x:Key="KvpValueTemplate">
        <TextBlock Text="{Binding Value}"
                   Foreground="{Binding Foreground,
                       RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" />
    </DataTemplate>

    <!-- Same fix as KvpValueTemplate above, for SettingsWindow.xaml's font
         picker (every choice previews itself in its own font). The
         FontFamilyStringConverter instance here is a separate copy from
         App.xaml's own "FontFamilyString" key — StaticResource lookups
         inside a merged ResourceDictionary's own markup cannot see the
         dictionary it's merged INTO (no upward visibility at XAML-parse
         time), only dictionaries merged into itself, so this template needs
         its own local copy to resolve the converter it references. -->
    <views:FontFamilyStringConverter x:Key="FontFamilyStringForChoiceTemplate" />
    <DataTemplate x:Key="FontChoiceTemplate">
        <TextBlock Text="{Binding Value}"
                   FontFamily="{Binding Key, Converter={StaticResource FontFamilyStringForChoiceTemplate}}"
                   Foreground="{Binding Foreground,
                       RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" />
    </DataTemplate>

    <!-- IsHighlighted correctly flips this Style's own Foreground Setter
         (below) to Theme.AccentText — but a plain-string Content ("Incoming",
         "Active only", …) is auto-wrapped by ContentPresenter through an
         internal, special-cased template, and that generated TextBlock's
         implicit-style search resolves the APPLICATION-level implicit
         TextBlock style (Foreground=Theme.Text) instead of inheriting this
         element's Foreground — a Style Setter always outranks property-value
         inheritance, the same trap PrimaryButton/ChipButton hit below.
         Verified (2026-08-02 contrast investigation): highlighted rows
         measured 1.35:1 light / 1.27:1 dark, both failing WCAG AA, with the
         resting row unaffected. ControlTemplate.Resources does NOT reach
         this auto-wrapped TextBlock either (tried first, also fails) — the
         only technique that does is forcing a REAL, explicitly-authored
         TextBlock via ContentTemplate below, with a LOCAL Foreground binding
         to this element, so the auto-wrap path is never taken at all.
         Measured after: 12.89:1 light / 11.48:1 dark.
         This Setter only reaches ComboBoxItems that get their Content
         directly (no ItemTemplate) — an ItemsControl with its own
         ItemTemplate assigns it to the container's ContentTemplate as a
         LOCAL value, which outranks this Style Setter entirely; those call
         sites (SettingsWindow.xaml's KvpValueTemplate and font-picker
         ItemTemplate) need the identical local-Foreground-binding fix
         applied directly in their own templates instead. Also: this
         forcibly wraps ANY Content in a TextBlock via {Binding} — verified
         no ComboBoxItem in this app sets compound (non-string) Content. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               Foreground="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Theme.Accent}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Theme.AccentText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{DynamicResource Theme.Surface}"
                                            BorderBrush="{DynamicResource Theme.Border}"
                                            BorderThickness="1" CornerRadius="4">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,10,0" Data="M 0 0 L 4 4 L 8 0 Z"
                                              Fill="{DynamicResource Theme.SubtleText}" />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        <!-- Editable mode: WPF binds editing to a part of exactly
                             this name. The implicit TextBox style is deliberately
                             kept (themed context menu, caret, selection); the local
                             values below neutralize its RESTING chrome. Its focused
                             state still applies the app's bronze focus ring via that
                             style's own template trigger — intentional, since this
                             ComboBox template has no other focus affordance. The
                             right margin keeps the drop-down arrow clickable
                             (hit-tested: text area -> this box, arrow -> Toggle). -->
                        <TextBox x:Name="PART_EditableTextBox"
                                 Visibility="Collapsed"
                                 Margin="8,0,28,0" Padding="0" MinHeight="0"
                                 VerticalAlignment="Center"
                                 Background="Transparent" BorderThickness="0"
                                 IsReadOnly="{TemplateBinding IsReadOnly}" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{DynamicResource Theme.Surface}"
                                    BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
                                    CornerRadius="4" MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource Theme.Border}" />
    </Style>

    <!-- DatePicker: the stock control is a white island in dark mode. The
         closed control is fully themed here; the drop-down calendar keeps a
         readable light face (its templates hardcode gradients too deep to
         chase for one control). -->
    <Style TargetType="DatePickerTextBox">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CaretBrush" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <Grid>
                        <ContentControl x:Name="PART_Watermark" Focusable="False"
                                        Foreground="{DynamicResource Theme.SubtleText}"
                                        Visibility="Collapsed" VerticalAlignment="Center" />
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="6,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                               Foreground="{TemplateBinding Foreground}" />
                            <Button x:Name="PART_Button" Grid.Column="1" Focusable="False"
                                    Background="Transparent" BorderThickness="0" Padding="4,0"
                                    Content="&#xE787;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    FontSize="13" />
                            <Popup x:Name="PART_Popup" AllowsTransparency="True"
                                   Placement="Bottom" StaysOpen="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- side-nav look: accent bar + surface fill on the selected section -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Background="Transparent" BorderThickness="3,0,0,0"
                            BorderBrush="Transparent" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Theme.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Theme.Surface}" />
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource Theme.Accent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Theme.SubtleText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="RowBackground" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource Theme.WindowBg}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Theme.WindowBg}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Theme.Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource Theme.AccentText}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Named styles -->

    <!-- Fluent glyphs from the system icon font — no image assets, always
         theme-colored, crisp at any DPI. Win10 falls back to MDL2. -->
    <Style x:Key="Icon" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The type ramp: Display (the big count), Headline/Title, Section,
         body (implicit), Caption. Displayed numbers use tabular figures so
         changing counts don't wiggle. -->
    <Style x:Key="DisplayText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="76" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="SectionText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource Theme.SubtleText}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- The app-level implicit TextBlock style (TargetType="TextBlock" above,
         Foreground=Theme.Text) is a Style Setter, and Style Setters always
         outrank property-value INHERITANCE. That alone would suggest a more
         specific implicit TextBlock style, scoped closer to the button, could
         win instead — but it can't: a plain string Content is auto-wrapped by
         ContentPresenter using an internal, special-cased template (not a
         real ContentTemplate instantiation), and that generated TextBlock's
         implicit-style search provably does NOT consult the templated
         Button's own Resources at all — verified directly: neither
         Style.Resources on PrimaryButton nor even resources added straight to
         a real Button instance's own Resources dictionary ever reached that
         auto-generated TextBlock; it always resolved the Application-level
         implicit style regardless. (An explicit ContentTemplate does reach
         it, but forcibly wraps ANY Content in a TextBlock — including the
         icon+text StackPanel PrintPreviewWindow's Print button already uses,
         which a template-level fix would silently swallow.)
         The fix that's actually provable: stop relying on the auto-wrap.
         PrimaryButtonLabel below is a NAMED (non-implicit) style, applied
         explicitly to a real, hand-declared TextBlock at each call site
         (`<TextBlock Text="…" Style="{StaticResource PrimaryButtonLabel}"/>`
         as the Button's Content). A real, explicitly-styled element is never
         auto-wrapped — ContentPresenter hosts already-a-UIElement content
         directly, the same path PrintPreviewWindow's StackPanel already
         takes — so ordinary StaticResource style lookup applies, unaffected
         by the auto-wrap quirk. PrimaryButton's Foreground never changes
         with state (hover/pressed only dim the Chrome's Opacity), so a fixed
         DynamicResource here is correct — no need to track the button live. -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource Theme.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.AccentText}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Pair with PrimaryButton above: apply explicitly to a real TextBlock
         used as PrimaryButton's Content, never relying on the auto-wrap. -->
    <Style x:Key="PrimaryButtonLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Theme.AccentText}" />
    </Style>

    <!-- Small pill chips for one-click presets. Deliberately unlike the
         inputs they sit beside: inputs are square-cornered and hollow,
         chips are borderless pills on the hover tint that light up accent
         on hover — unmistakably pressable. -->
    <!-- Same auto-wrap problem as PrimaryButton above, plus ChipButton's
         label can't take a fixed DynamicResource: its hover trigger flips
         the BUTTON's own Foreground between Theme.Text (rest, inherited from
         the base Button style) and Theme.AccentText (hover, a
         template-trigger Setter with no TargetName — that targets the
         templated element itself, i.e. this Button). ChipButtonLabel below
         is the same named-style-on-a-real-TextBlock fix as
         PrimaryButtonLabel, except its Foreground is a live Binding
         (RelativeSource AncestorType=Button) rather than a fixed
         DynamicResource, so it tracks whichever Foreground the Button
         currently has — verified directly: changing a Button's Foreground
         at runtime does propagate through this binding to the TextBlock,
         through both the base and the hover-triggered value. -->
    <Style x:Key="ChipButtonLabel" TargetType="TextBlock">
        <Setter Property="Foreground"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
    </Style>

    <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource Theme.SurfaceHover}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="11,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="12" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource Theme.Accent}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Theme.AccentText}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SubtleText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource Theme.SubtleText}" />
    </Style>

    <Style x:Key="HeadlineText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource Theme.StatusAmber}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
