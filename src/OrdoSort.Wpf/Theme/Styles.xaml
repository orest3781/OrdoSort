<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:OrdoSort.Wpf.Theme"
                    xmlns:views="clr-namespace:OrdoSort.Wpf.Views">

    <!-- All colors come from the Theme.* brushes ThemeManager materializes;
         DynamicResource keeps a live OS light/dark switch working. -->

    <!-- Spacing rhythm as practised: 4/6/8/10/12/14/16 (6 occurs 91×, 8 occurs 87×, 10 occurs 60×, 4 occurs 57×) -->

    <!-- Shared focus ring: a flat bronze outline on every focusable styled
         control. AccentBronze renders here as a 100% flat stroke only — no
         opacity/mix/gradient — per its WCAG-pinned contrast margin. -->
    <Style x:Key="BronzeFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource Theme.AccentBronze}"
                            BorderThickness="2" CornerRadius="4" Margin="-2"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource Theme.WindowBg}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource BronzeFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- radius scale: buttons 4, inputs 4, cards 4, pills 12 —
                         crisp-workbench flattens buttons/inputs/cards to the same 4px -->
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Colored route buttons set Background explicitly; the
                             hover/pressed effect is an opacity veil so it works
                             on ANY background without recomputing shades. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.92" />
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource Theme.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.84" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToggleButton mirrors Button — same chrome, same look in both
         palettes. Can't BasedOn the Button style (TargetType mismatch
         throws), so its setters are duplicated here rather than retargeting
         the shared Button style at ButtonBase and risking every existing
         Button in the app. -->
    <Style TargetType="ToggleButton">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource BronzeFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.92" />
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource Theme.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.84" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Explicit editor menus: WPF's built-in TextBox/PasswordBox context
         menu is made of PRIVATE MenuItem/ContextMenu subclasses, which
         implicit styles never match (exact-type lookup) — so the themed
         menu styles in this file can't reach it. Handing every text box a
         menu of REAL types is the reliable route; ApplicationCommands
         routing keeps enable/disable and the gesture text identical to
         stock. x:Shared=False: each control gets its own instance, so one
         menu is never torn between two placement targets. -->
    <ContextMenu x:Key="EditorContextMenu" x:Shared="False">
        <MenuItem Header="Cut" Command="Cut" />
        <MenuItem Header="Copy" Command="Copy" />
        <MenuItem Header="Paste" Command="Paste" />
        <Separator />
        <MenuItem Header="Select all" Command="SelectAll" />
    </ContextMenu>
    <ContextMenu x:Key="PasswordContextMenu" x:Shared="False">
        <MenuItem Header="Paste" Command="Paste" />
    </ContextMenu>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="CaretBrush" Value="{DynamicResource Theme.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Theme.Accent}" />
        <Setter Property="ContextMenu" Value="{StaticResource EditorContextMenu}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- hover before focus so a focused box stays accent -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource Theme.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource Theme.AccentBronze}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- PasswordBox mirrors TextBox — it previously fell through to the stock
         template, a styling gap the Unlock window wore. -->
    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="CaretBrush" Value="{DynamicResource Theme.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Theme.Accent}" />
        <Setter Property="ContextMenu" Value="{StaticResource PasswordContextMenu}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource Theme.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource Theme.AccentBronze}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slim track-less scrollbars: the stock ones are the loudest "old app"
         signal, especially in dark mode. Thumb only — Border at rest,
         SubtleText under the pointer. -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" Background="{DynamicResource Theme.Border}"
                            CornerRadius="4" Margin="2" SnapsToDevicePixels="True" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background"
                                    Value="{DynamicResource Theme.SubtleText}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background"
                                    Value="{DynamicResource Theme.SubtleText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollPage}"
                                          Command="ScrollBar.PageUpCommand" />
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}" />
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollPage}"
                                          Command="ScrollBar.PageDownCommand" />
                        </Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPage}"
                                                  Command="ScrollBar.PageLeftCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPage}"
                                                  Command="ScrollBar.PageRightCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Task 8 (audit remediation, 2026-08-02): the shared bronze focus ring
         (BronzeFocusVisual, declared at the top of this file) was only ever
         wired to Button and ToggleButton — CheckBox, RadioButton, ComboBox,
         ListBoxItem and TabItem fell through to the stock OS dashed
         rectangle, the one place the theme's focus language broke. Extended
         to all five below. No template change is needed for any of them:
         FocusVisualStyle only tells WPF which adorner to draw around the
         element's own bounds on keyboard focus, independent of the
         ControlTemplate. A plain Setter is enough for ComboBox, ListBoxItem
         and TabItem (all three of those styles supply their own template, so
         nothing outranks it) — but NOT for the CheckBox/RadioButton pair
         immediately below, which is why they also carry a Style TRIGGER:
         those two keep the STOCK template, and the stock template assigns
         FocusVisualStyle from a TEMPLATE TRIGGER on HasContent=True, which
         outranks a plain Style Setter. Measured directly, not deduced:
         DependencyPropertyHelper.GetValueSource reported TemplateTrigger for
         both and the rendered ring stayed the OS dashed rectangle — the
         Setter alone was silently a no-op for every content-bearing CheckBox
         and RadioButton in the app, i.e. all of them. A Style trigger
         outranks a template trigger, so duplicating the value there is what
         actually wins.

         The plain Setter below is kept as DEFENCE IN DEPTH, not as cover for
         anything that ships today. Counted 2026-08-03: all 29 CheckBox and
         RadioButton in src\OrdoSort.Wpf\**\*.xaml supply Content, and the
         three ThemeCard radios use a keyed style that bypasses this implicit
         one entirely — so the Setter leg never fires in this application. It
         is not speculative, though: a content-less CheckBox was measured
         separately and reports value source Style (the Setter DOES win
         there), and deleting the Setter turns that leg red with
         "Expected: Style, Actual: DefaultStyle". That same measurement is the
         direct evidence for the stock trigger's HasContent condition, rather
         than an inference from the value source. Full order, all three legs
         measured: StyleTrigger > TemplateTrigger > Style setter. Every case
         here is proven by rendering real pixels in FocusRingCoverageTests. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource BronzeFocusVisual}" />
        <Style.Triggers>
            <Trigger Property="HasContent" Value="True">
                <Setter Property="FocusVisualStyle" Value="{StaticResource BronzeFocusVisual}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource BronzeFocusVisual}" />
        <Style.Triggers>
            <Trigger Property="HasContent" Value="True">
                <Setter Property="FocusVisualStyle" Value="{StaticResource BronzeFocusVisual}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource Theme.WindowBg}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
    </Style>

    <!-- MenuItem is fully retemplated: the stock Windows template hardcodes a
         LIGHT popup background while the item text follows the overridden
         SystemColors menu-text brush — in dark mode that made dropdowns
         white-on-white. Four roles, one look, all brushes from the theme. -->

    <ControlTemplate x:Key="MenuTopLevelHeader" TargetType="MenuItem">
        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="10,5"
                SnapsToDevicePixels="True">
            <Grid>
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                  VerticalAlignment="Center" />
                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}"
                       Placement="Bottom" AllowsTransparency="True" Focusable="False"
                       PopupAnimation="Fade">
                    <Border Background="{DynamicResource Theme.Surface}"
                            BorderBrush="{DynamicResource Theme.Border}"
                            BorderThickness="1" CornerRadius="4" Padding="4" Margin="0,2,8,8">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background"
                        Value="{DynamicResource Theme.SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="Bd" Property="Background"
                        Value="{DynamicResource Theme.SurfacePressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Theme.SubtleText}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="MenuTopLevelItem" TargetType="MenuItem">
        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="10,5"
                SnapsToDevicePixels="True">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                              VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background"
                        Value="{DynamicResource Theme.SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Theme.SubtleText}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="MenuSubmenuItem" TargetType="MenuItem">
        <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                Padding="10,7" SnapsToDevicePixels="True" MinWidth="220">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter ContentSource="Icon" VerticalAlignment="Center"
                                  HorizontalAlignment="Left" />
                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                  RecognizesAccessKey="True" VerticalAlignment="Center" />
                <TextBlock x:Name="Gesture" Grid.Column="2" Margin="24,0,4,0"
                           VerticalAlignment="Center"
                           Text="{TemplateBinding InputGestureText}"
                           Foreground="{DynamicResource Theme.SubtleText}" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background"
                        Value="{DynamicResource Theme.Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource Theme.AccentText}" />
                <Setter TargetName="Gesture" Property="Foreground"
                        Value="{DynamicResource Theme.AccentText}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Theme.SubtleText}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="MenuSubmenuHeader" TargetType="MenuItem">
        <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                Padding="10,7" SnapsToDevicePixels="True" MinWidth="220">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                  VerticalAlignment="Center" />
                <Path Grid.Column="1" Margin="24,0,4,0" VerticalAlignment="Center"
                      Data="M 0 0 L 4 4 L 0 8 Z"
                      Fill="{DynamicResource Theme.SubtleText}" />
                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}"
                       Placement="Right" AllowsTransparency="True" Focusable="False"
                       PopupAnimation="Fade">
                    <Border Background="{DynamicResource Theme.Surface}"
                            BorderBrush="{DynamicResource Theme.Border}"
                            BorderThickness="1" CornerRadius="4" Padding="4" Margin="0,0,8,8">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background"
                        Value="{DynamicResource Theme.SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Theme.SubtleText}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- NOT broken, verified directly (2026-08-02): unlike ComboBoxItem's
         plain-string Content, a MenuItem.Header string with an access-key
         underscore is auto-wrapped by ContentPresenter's RecognizesAccessKey
         path into an AccessText, and AccessText does NOT derive from
         TextBlock — so the app-level implicit TextBlock style below never
         applies to it (implicit-style lookup only walks an element's own
         .NET base-type chain, and AccessText's doesn't include TextBlock).
         With no Style Setter in the way, AccessText's Foreground simply
         INHERITS from the templated MenuItem, which the MenuSubmenuItem
         ControlTemplate's IsHighlighted trigger already flips correctly to
         Theme.AccentText — so the highlighted submenu Header was already
         correct. (A prior pass here added a HeaderTemplate Setter to "fix"
         this, based on a measurement that turned out to be a bug in that
         investigation's own test harness — it walked "the first TextBlock
         descendant," which silently drilled past the correctly-colored
         AccessText into a private, always-empty child TextBlock AccessText
         builds internally, reading THAT decoy's unrelated Foreground
         instead. Re-measured against a build with zero occurrences of
         "HeaderTemplate" in the compiled DLL — i.e. provably unfixed — and
         found already-passing: 12.89:1 light / 11.48:1 dark. The Setter was
         reverted: it fixed nothing and would have forced every
         MenuItem.Header in the app through an explicit AccessText,
         swallowing compound Header content the moment one exists.
         HighlightContrastTests.cs keeps a regression case for this that
         passes both with and without any such Setter.) -->
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource MenuTopLevelHeader}" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{StaticResource MenuTopLevelItem}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource MenuSubmenuHeader}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource MenuSubmenuItem}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Margin="8,4"
                               Fill="{DynamicResource Theme.Border}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ContextMenu: the right-click popup chrome. The stock template is a
         hardcoded LIGHT plate (the same trap the MenuItem note above
         describes) — and every right-click menu in this app is WPF's
         built-in editor menu (Cut/Copy/Paste), so this one implicit style
         themes them all. Items already resolve the retemplated MenuItem
         roles. No outer margin: unlike the Menu templates, which own their
         Popup and its transparency, ContextMenu creates its own popup — a
         margin here can render as an opaque dead strip. -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="4">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolBar">
        <Setter Property="Background" Value="{DynamicResource Theme.WindowBg}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
    </Style>

    <!-- A Separator placed INSIDE a ToolBar (the pipe divider between its
         button groups) is assigned this keyed style by ToolBar itself
         (ToolBar.SeparatorStyleKey), NOT the plain implicit
         {x:Type Separator} style — measured stock at #FFB6BDC5 regardless
         of this file's own Separator styling elsewhere. -->
    <Style x:Key="{x:Static ToolBar.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource Theme.Border}" />
    </Style>

    <!-- Tried and abandoned: a matching {x:Static ToolBar.ButtonStyleKey}
         Style with a Background Setter, hoping to reach the page-layout
         group's stock light "chip" background (ActualSize/PageWidth/
         WholePage/TwoPages in PrintPreviewWindow's DocumentViewer). Verified
         inert — a diagnostic dump of the live visual tree showed every
         toolbar Button's Background resolving to a DrawingBrush both with
         and without this Setter, byte-for-byte identical either way, so
         whatever sets it (almost certainly a ControlTemplate trigger baked
         into ToolBar's own stock per-button chrome, not this Style) outranks
         a plain Style Setter the same way every other native control in this
         file needed a full retemplate to reach reliably. Left unfixed — see
         PrintPreviewWindow.xaml.cs's DocumentViewer comment for the full
         account of what's reachable here and why this part isn't. -->

    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{DynamicResource Theme.WindowBg}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
    </Style>

    <!-- ListBoxItem: Styles.xaml had ZERO style for this before Task 2
         (theme-coverage audit, 2026-08-02), so selection rendered through
         stock WPF's default (Aero2) template — measured by
         HighlightContrastTests at a flat (218,218,218) grey in BOTH
         palettes, i.e. it isn't reading any DynamicResource brush at all
         (confirmed: neither SystemColors.HighlightBrushKey, which
         ThemeManager already overrides to Theme.Accent, nor anything else
         theme-bound). That coincidentally passes WCAG AA against Theme.Text
         (8.50-17.44:1 per the audit) but disagrees with DataGridCell below,
         which already selects with Theme.Accent/Theme.AccentText — this
         style brings ListBoxItem into agreement, mirroring that same
         Background=Transparent/Theme.Text at rest, Accent/AccentText when
         selected contract, plus an IsMouseOver -> Theme.SurfaceHover hover
         DataGridCell doesn't need (DataGrid rows get row-hover a different
         way; a bare ListBox has nothing else providing one). Fully
         retemplated rather than left as bare Setters on the stock template
         — every OTHER native-templated control in this file needed that
         (ComboBoxItem, TabItem, MenuItem, TextBox/PasswordBox) because a
         stock template's own internal ControlTemplate.Triggers can set a
         named part's Background directly, at a precedence bare Style
         Setters on the untouched stock template can't reliably out-rank;
         DataGridCell is the one exception in this file, and is left alone.
         Same auto-wrap/local-Foreground trap as ComboBoxItem below for a
         bare Content string (this app's SuggestList in ProcessingView.xaml
         is the one list whose ITEMS are plain strings — WatchList sets no
         ItemTemplate either, so "the one list with no ItemTemplate", as this
         sentence read until 2026-08-03, was false in the same way the
         comment it replaced was; its rows are view models drawn by DataType
         templates, which is exactly the distinction the enumeration below
         turns on): fixed with the keyed
         PlainStringListItemTemplate below, a real TextBlock with a LOCAL
         Foreground bound back to this ListBoxItem — but applied through a
         ContentTemplateSelector, NOT a blanket ContentTemplate Setter. See
         PlainStringOnlyTemplateSelector's own doc comment for the full
         account; the short version is that a non-null ContentTemplate from
         ANY source suppresses ContentPresenter's implicit DataType-keyed
         DataTemplate lookup outright, and the blanket Setter this style
         used to carry therefore killed SettingsWindow's WatchList, whose
         two row shapes are declared as DataType templates in its own
         <ListBox.Resources> (Task 8b, 2026-08-03 — six rows of
         "OrdoSort.Wpf.ViewModels.WatchSectionVm" on screen).

         How each of this app's other ListBoxes relates to this style:

         * ItemTemplate-based lists (SettingsWindow's RouteList,
           LabelMakerWindow's client list, ManageSavedWindow, UnlockWindow's
           file list) supply their OWN label TextBlocks in their own
           window's XAML. ItemsControl assigns ItemTemplate to each
           generated container's ContentTemplate as a LOCAL value, and a
           local value outranks a Style Setter — so those lists never saw
           the old Setter, and each needed the local-Foreground-binding fix
           applied at its own call site (see each window's own comment).
           That is true of an ItemTemplate specifically, and was WRONGLY
           written here as if it were true of any call-site template.
         * DataType-template lists (SettingsWindow's WatchList) set NEITHER
           ItemTemplate NOR ItemContainerStyle, so their containers have no
           local ContentTemplate at all and this style's Setters DO reach
           them. There is no local value to outrank anything — the absence
           of one is exactly what let the old Setter through.
         * RouteList also sets ItemContainerStyle explicitly — an
           explicitly-set ItemContainerStyle entirely REPLACES
           implicit-by-type lookup for that ListBox's containers, so
           without a BasedOn back to THIS style it would keep using the
           plain WPF default no matter what this file says; fixed at that
           call site by adding BasedOn="{StaticResource {x:Type
           ListBoxItem}}" there. -->

    <!-- Declared here (an app-level ResourceDictionary), not inline in the
         Setter, for the same reason as KvpValueTemplate/FontChoiceTemplate
         below: the test suite resolves it BY KEY out of the real, loaded
         Styles.xaml, so a future edit to the shipped template fails those
         tests instead of drifting away from a hand-copied stand-in. -->
    <DataTemplate x:Key="PlainStringListItemTemplate">
        <TextBlock Text="{Binding}"
                   Foreground="{Binding Foreground,
                       RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
    </DataTemplate>
    <theme:PlainStringOnlyTemplateSelector x:Key="PlainStringListItemSelector"
                                           PlainStringTemplate="{StaticResource PlainStringListItemTemplate}" />

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Padding" Value="8,5" />
        <!-- Task 8: focus-ring coverage — see the CheckBox/RadioButton pair
             above. -->
        <Setter Property="FocusVisualStyle" Value="{StaticResource BronzeFocusVisual}" />
        <Setter Property="ContentTemplateSelector" Value="{StaticResource PlainStringListItemSelector}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Theme.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Theme.Accent}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Theme.AccentText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ItemTemplate-based ComboBox item shapes: a bare TextBlock bound to
         the item, given a LOCAL Foreground binding. Declared HERE (an
         app-level ResourceDictionary), not in the window that uses them,
         specifically so both this file's own ComboBoxItem fix below AND
         these two templates are real, loaded production resources the test
         suite resolves by key — not a hand-copied stand-in that could
         silently drift from what actually ships. Verified (2026-08-02):
         ItemsControl assigns ItemTemplate to the generated container's
         ContentTemplate as a LOCAL value, which outranks even the
         ComboBoxItem style's own Setters below — so this binding is not
         optional decoration, it is the ONLY thing that fixes this shape.
         Without it: 1.35:1 light / 1.27:1 dark (WCAG AA failure). With it:
         12.89:1 light / 11.48:1 dark.

         WHY A PriorityBinding AND NOT A PLAIN FindAncestor (Task 8b fix
         round 2, 2026-08-03 — this was a LIVE Critical, on screen, in the
         shipped app, for as long as these templates have existed). An
         ItemTemplate is used in TWO places, not one. ItemsControl gives it
         to each drop-down row, where a ComboBoxItem ancestor exists; and
         ComboBox.UpdateSelectionBoxItem ALSO assigns it to
         SelectionBoxItemTemplate, which paints the CLOSED face through a
         ContentPresenter inside the ComboBox's own ControlTemplate, where
         there is no ComboBoxItem anywhere above it. A FindAncestor that
         finds nothing does not inherit and does not fall back to this
         element's Style: the binding never attaches and the DP keeps its
         DEFAULT value, which for TextBlock.Foreground is BLACK. Measured on
         screen at 8bdab38 on all three call sites (Filing "Process order",
         Destinations naming mode, Appearance "App font"): (0,0,0) on dark
         Theme.Surface (38,41,45) = 1.44:1, a WCAG AA failure — and 21.00:1
         on the light palette, which is why a full theme audit and three QC
         rounds walked past it. After: (233,235,238) = 12.23:1 dark,
         (23,26,31) = 17.44:1 light.

         The two Bindings below name the two hosts explicitly and in the
         order ChooseTemplate reaches them, so a reader can check the claim
         instead of trusting it: a ComboBoxItem when this template is
         painting a ROW (its Foreground is what the ComboBoxItem style's
         IsHighlighted trigger flips to Theme.AccentText — the whole point of
         binding to an ancestor rather than hardcoding a brush), and the
         ComboBox itself when it is painting the CLOSED FACE (Theme.Text from
         the ComboBox style below, or whatever a call site set locally).
         PriorityBinding takes the first binding that produces a value and
         treats an unresolvable FindAncestor as no value, so the row case is
         unchanged from before — re-measured on screen after this change,
         resting row 12.23:1 dark / 17.44:1 light and highlighted row 11.48:1
         dark / 12.89:1 light, i.e. the numbers HighlightContrastTests already
         pins. Rejected: FallbackValue, which cannot hold a DynamicResource
         and so would freeze one palette's colour into a theme-switching app;
         and collapsing the two into one FindAncestor on a base type broad
         enough to match both hosts (AncestorType=Control), which would leave
         the next reader to work out for themselves which control it lands on
         in each case — being unable to check a claim at a glance is how the
         wrong mechanism survived three rounds in this very file. Pinned in
         both palettes and all three shipped shapes by
         ContentTemplateSetterTests.ClosedComboBoxStillShowsTheSelectedItemLegibly. -->
    <DataTemplate x:Key="KvpValueTemplate">
        <TextBlock Text="{Binding Value}">
            <TextBlock.Foreground>
                <PriorityBinding>
                    <Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=ComboBoxItem}" />
                    <Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=ComboBox}" />
                </PriorityBinding>
            </TextBlock.Foreground>
        </TextBlock>
    </DataTemplate>

    <!-- Same fix as KvpValueTemplate above, for SettingsWindow.xaml's font
         picker (every choice previews itself in its own font). The
         FontFamilyStringConverter instance here is a separate copy from
         App.xaml's own "FontFamilyString" key — StaticResource lookups
         inside a merged ResourceDictionary's own markup cannot see the
         dictionary it's merged INTO (no upward visibility at XAML-parse
         time), only dictionaries merged into itself, so this template needs
         its own local copy to resolve the converter it references. -->
    <views:FontFamilyStringConverter x:Key="FontFamilyStringForChoiceTemplate" />
    <DataTemplate x:Key="FontChoiceTemplate">
        <TextBlock Text="{Binding Value}"
                   FontFamily="{Binding Key, Converter={StaticResource FontFamilyStringForChoiceTemplate}}">
            <TextBlock.Foreground>
                <PriorityBinding>
                    <Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=ComboBoxItem}" />
                    <Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=ComboBox}" />
                </PriorityBinding>
            </TextBlock.Foreground>
        </TextBlock>
    </DataTemplate>

    <!-- IsHighlighted correctly flips this Style's own Foreground Setter
         (below) to Theme.AccentText — but a plain-string Content ("Incoming",
         "Active only", …) is auto-wrapped by ContentPresenter through an
         internal, special-cased template, and that generated TextBlock's
         implicit-style search resolves the APPLICATION-level implicit
         TextBlock style (Foreground=Theme.Text) instead of inheriting this
         element's Foreground — a Style Setter always outranks property-value
         inheritance, the same trap PrimaryButton/ChipButton hit below.
         Verified (2026-08-02 contrast investigation): highlighted rows
         measured 1.35:1 light / 1.27:1 dark, both failing WCAG AA, with the
         resting row unaffected. ControlTemplate.Resources does NOT reach
         this auto-wrapped TextBlock either (tried first, also fails) — the
         only technique that does is forcing a REAL, explicitly-authored
         TextBlock (PlainStringComboItemTemplate below) with a LOCAL
         Foreground binding to this element, so the auto-wrap path is never
         taken at all. Measured after: 12.89:1 light / 11.48:1 dark.

         Applied through a ContentTemplateSelector, NOT a blanket
         ContentTemplate Setter (Task 8b fix round 1, 2026-08-03 — the
         ListBoxItem style above got the identical treatment one round
         earlier, for a Critical that this style's shape would have produced
         next). A non-null ContentTemplate from ANY source suppresses THREE
         things at once: ContentPresenter's implicit DataType-keyed template
         lookup, its UIElement passthrough, and any ItemTemplateSelector the
         call site set. ChooseTemplate resolves ContentTemplate ->
         ContentTemplateSelector -> its own built-in default selector and
         stops at the first hit — a RESOLUTION order, which is why a LOCAL
         ContentTemplateSelector loses to this Style's Setter even though it
         outranks it in DependencyProperty precedence. All three shapes are
         pinned executably by ContentTemplateSetterTests; see
         PlainStringOnlyTemplateSelector's own doc comment for the mechanism.
         The sentence that used to sit here instead — "verified no
         ComboBoxItem in this app sets compound (non-string) Content" — was
         true when written and is still true today, and is exactly the
         decaying-premise shape that hid Task 8b's Critical through a full
         audit; it is not what this style should rest on.

         What narrowing it did to the CLOSED face — CORRECTED in fix round 2
         (2026-08-03), because round 1 wrote the mechanism down backwards and
         then pinned it with a test the wrong mechanism made inert.

         WRONG (round 1): "UpdateSelectionBoxItem copies the SELECTED
         CONTAINER's ContentTemplate into SelectionBoxItemTemplate."
         RIGHT (PresentationFramework 8.0.27, ComboBox.UpdateSelectionBoxItem,
         and asserted by
         ContentTemplateSetterTests.SelectionBoxItemTemplateComesFromTheSelectedItemNeverFromItsContainer):
         it reads InternalSelectedItem — the ITEM — and if that item is itself
         a ContentControl it unwraps to item.Content and takes
         item.ContentTemplate; otherwise it takes the ComboBox's own
         ItemTemplate. The generated container is NEVER consulted. The two
         coincide for <ComboBoxItem> children, which is why the wrong sentence
         still described that one case correctly, and diverge everywhere else.

         So this Setter WAS reaching the closed face, through the item, and
         the round-1 conversion silently repaired a LIVE dark-mode WCAG
         failure rather than merely avoiding a new one: the blanket template's
         FindAncestor Foreground binding cannot resolve out on the selection
         box (there is no ComboBoxItem above it), so TextBlock.Foreground fell
         back to its DP default — BLACK. Measured on the six
         <ComboBoxItem>-children instances (MainWindow's tile filter,
         BulkRenameWindow's case picker, the four Settings sound pickers):
         before (0,0,0) on Theme.Surface (38,41,45) = 1.44:1; after
         (233,235,238) = 12.23:1. There is no SelectionBoxItemTemplateSelector,
         so those faces now take WPF's plain-string auto-wrap, which lands on
         Theme.Text by the app-level implicit TextBlock style. Pinned in both
         palettes and all three shipped shapes by
         ClosedComboBoxStillShowsTheSelectedItemLegibly — whose round-1
         version drove ItemsSource=string[], the ONE shape whose selection box
         gets no template either way, and so could not fail.

         These Setters only reach ComboBoxItems that get their Content
         directly (no ItemTemplate) — an ItemsControl with its own
         ItemTemplate assigns it to the container's ContentTemplate as a
         LOCAL value, and ChooseTemplate finds that at step 1 and never
         reaches the selector this style sets at step 2 (a resolution order,
         not a precedence one — see the paragraph above); those call sites
         (SettingsWindow.xaml's KvpValueTemplate and font-picker
         ItemTemplate) carry their own local Foreground binding instead, and
         it has to be a PriorityBinding rather than a plain FindAncestor
         precisely because an ItemTemplate — unlike anything in this style —
         is ALSO what paints that ComboBox's closed face. See those two
         templates above; the same 1.44:1 black was live there until fix
         round 2. -->

    <!-- Keyed here rather than inline in the Setter for the same reason as
         PlainStringListItemTemplate/KvpValueTemplate above: the test suite
         resolves both BY KEY out of the real, loaded Styles.xaml, so an edit
         to the shipped template fails those tests instead of drifting away
         from a hand-copied stand-in. Kept separate from
         PlainStringListItemTemplate rather than shared — sharing WOULD work,
         since ComboBoxItem derives from ListBoxItem and would satisfy that
         template's AncestorType=ListBoxItem lookup, but a template named for
         one control silently serving another is how this file got into
         trouble in the first place. -->
    <DataTemplate x:Key="PlainStringComboItemTemplate">
        <TextBlock Text="{Binding}"
                   Foreground="{Binding Foreground,
                       RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" />
    </DataTemplate>
    <theme:PlainStringOnlyTemplateSelector x:Key="PlainStringComboItemSelector"
                                           PlainStringTemplate="{StaticResource PlainStringComboItemTemplate}" />

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="ContentTemplateSelector" Value="{StaticResource PlainStringComboItemSelector}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Theme.Accent}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Theme.AccentText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="Padding" Value="8,5" />
        <!-- Task 8: focus-ring coverage — see the CheckBox/RadioButton pair
             above. Only reached when focus lands on the ComboBox itself
             (the ordinary, non-editable case); an IsEditable="True" ComboBox
             instead moves focus to PART_EditableTextBox, whose own
             IsKeyboardFocused template trigger already gives it a bronze
             border (see this file's ComboBox template comment below) — this
             Setter doesn't reach that case and doesn't need to. -->
        <Setter Property="FocusVisualStyle" Value="{StaticResource BronzeFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{DynamicResource Theme.Surface}"
                                            BorderBrush="{DynamicResource Theme.Border}"
                                            BorderThickness="1" CornerRadius="4">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,10,0" Data="M 0 0 L 4 4 L 8 0 Z"
                                              Fill="{DynamicResource Theme.SubtleText}" />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        <!-- Editable mode: WPF binds editing to a part of exactly
                             this name. The implicit TextBox style is deliberately
                             kept (themed context menu, caret, selection); the local
                             values below neutralize its RESTING chrome. Its focused
                             state still applies the app's bronze focus ring via that
                             style's own template trigger — intentional, since this
                             ComboBox template has no other focus affordance. The
                             right margin keeps the drop-down arrow clickable
                             (hit-tested: text area -> this box, arrow -> Toggle). -->
                        <TextBox x:Name="PART_EditableTextBox"
                                 Visibility="Collapsed"
                                 Margin="8,0,28,0" Padding="0" MinHeight="0"
                                 VerticalAlignment="Center"
                                 Background="Transparent" BorderThickness="0"
                                 IsReadOnly="{TemplateBinding IsReadOnly}" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{DynamicResource Theme.Surface}"
                                    BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
                                    CornerRadius="4" MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource Theme.Border}" />
    </Style>

    <!-- Calendar family (DatePicker's drop-down popup): stock WPF's Aero2
         theme hardcodes the popup's whole visual language — a literal
         light LinearGradientBrush background and "#FF333333" text colours
         baked directly into its default templates, none of it resource-
         bound. Day numbers are worse: CalendarDayButton paints its content
         through a bare ContentPresenter with no ContentTemplate, so WPF
         auto-wraps the day-number string into an internal TextBlock that
         resolves THIS file's global implicit TextBlock style
         (Foreground=Theme.Text) instead of the stock template's own
         hardcoded colour — the same "Style Setter outranks inheritance"
         trap ComboBoxItem hit above (see that Style's comment;
         ControlTemplate.Resources was measured NOT to reach an auto-wrapped
         TextBlock either). Measured before this fix (2026-08-02): the
         popup's background never left its hardcoded light gradient while
         Theme.Text flipped to near-white in dark mode, so day numbers
         rendered near-white on a near-white face — 1.02-1.95:1 across
         every day state, all failing WCAG AA (light mode's "disabled" state
         failed too, at 1.28:1 — the stock template dims disabled text to
         35% opacity regardless of theme, which is faint enough to fail on
         its own even against a merely-light background).
         Every template below is a full reskin (not a patch on the stock
         one): flat 4px chrome consistent with the rest of this file. The
         day-of-week strip and month/year header text have no state-
         dependent colour, so a plain local Foreground binding is enough.
         CalendarDayButton/CalendarButton's day/month/year numbers DO need
         Foreground to flip per state (Selected/Inactive/disabled), so they
         get the same escape ComboBoxItem uses: a real, explicitly-authored
         TextBlock via ContentTemplate with a LOCAL Foreground bound back to
         the container, never auto-wrapped, so the Triggers below actually
         reach the visible text.

         A second, non-obvious trap found empirically while building this
         (confirmed with a diagnostic dump of Style/Foreground/visual-tree
         shape before and after): CalendarItem.PopulateGrids() creates every
         CalendarDayButton/CalendarButton with
         `SetBinding(StyleProperty, new Binding("Owner.CalendarDayButtonStyle"))`
         (and CalendarButtonStyle for month/year cells), and Calendar's own
         stock template hands CalendarItem its Style the same way via
         `Style="{TemplateBinding CalendarItemStyle}"`. Unlike a Style
         property that was simply never touched (where WPF falls back to an
         implicit lookup-by-TargetType — how every other implicit style in
         this file resolves), a Style property already carrying an explicit
         binding — even one whose bound value is null, which is exactly
         what Calendar.CalendarItemStyle/CalendarDayButtonStyle/
         CalendarButtonStyle all default to — does NOT fall through to
         implicit-by-type lookup at all. It falls straight to the CONTROL'S
         OWN theme (Aero2) default style instead. A plain `<Style
         TargetType="CalendarDayButton">` below would therefore silently
         never apply to a real Calendar's day cells — verified directly:
         with only a TargetType (no explicit wiring), CalendarDayButton kept
         rendering the stock Grid/Rectangle template with Foreground
         "#FF333333" no matter what this file's Style said. The fix is to
         give CalendarItem/CalendarDayButton/CalendarButton's styles an
         explicit x:Key below and wire them explicitly: CalendarDayButton/
         CalendarButton (bound via a real C# Binding, re-evaluated on
         change) get it through Calendar's own CalendarDayButtonStyle/
         CalendarButtonStyle Setters below, so PopulateGrids' binding
         resolves to a real Style instead of null. CalendarItem is different
         — its Style is assigned via `TemplateBinding` from INSIDE Calendar's
         own ControlTemplate, and a `TemplateBinding` there racing a Setter
         for the same property in the same Style is a genuine ordering
         hazard on .NET's XamlObjectWriter-based template loader (reproduced
         directly: a `<Setter Property="CalendarItemStyle">` alongside that
         TemplateBinding threw "'{DependencyProperty.UnsetValue}' is not a
         valid value for property CalendarItemStyle" — the Setter hadn't
         applied yet when the Template read it). Since this Calendar
         template always wants this exact CalendarItem style anyway (no
         other consumer swaps it per-instance), the fix is simpler than
         chasing that race: reference it directly with a plain
         `{StaticResource CalendarItemStyle}` on the `<CalendarItem>` tag
         below, bypassing the CalendarItemStyle DP entirely.

         DELIBERATELY NOT CONVERTED to a ContentTemplateSelector (Task 8b fix
         round 1, 2026-08-03), unlike ListBoxItem's and ComboBoxItem's Setters
         of the identical shape above. That trap needs three things: content
         that is not a string, a call site able to supply it, and a style able
         to reach that call site. A Calendar cell has none. WPF's own
         CalendarItem is the only thing that ever sets these cells' Content,
         and — the point, sharpened in fix round 2 — the API it does it
         through is STATICALLY TYPED to string: CalendarDayButton and
         CalendarButton each declare exactly one Content-setting member of
         their own, `internal void SetContentInternal(string)`. That is a
         stronger claim than "today it happens to pass a string", which is all
         round 1 recorded, and it is asserted by reflection in the test named
         below. (Round 1 also named the wrong callers: PopulateGrids only
         CREATES the cells and never touches Content; the setters are
         SetMonthModeCalendarDayButtons, SetMonthButtons and SetYearButtons,
         and there is no SetDayButtons at all. Corrected here because a
         comment whose whole value is being a checkable premise has to name
         things a reader can actually go and check.) The DateTime rides on
         DataContext, never on Content — so the string branch is the only one
         ChooseTemplate could ever take here, and a string-only selector would
         be behaviourally identical to the blanket Setter. And both styles are
         KEYED, reachable only through Calendar's
         own CalendarDayButtonStyle/CalendarButtonStyle Setters below (the
         paragraph above is why they cannot be implicit), so there is no "next
         author" to leave a hole for — which was the entire argument for
         converting the other two. That premise is PINNED, not asserted:
         ContentTemplateSetterTests.CalendarCellsCanOnlyEverCarryStringContent
         drives a real Calendar in both display modes and fails if a future
         .NET ever hands these cells anything but a string, if SetContentInternal
         ever stops taking one, or if either style ever becomes implicit.

         Note also what these two styles are NOT exposed to, unlike the
         ComboBoxItem style above: a CalendarDayButton has no "closed face" —
         nothing copies its ContentTemplate anywhere else — so the FindAncestor
         Foreground binding below has exactly one host and cannot fall back to
         black the way KvpValueTemplate's did. -->
    <Style x:Key="CalendarDayButtonStyle" TargetType="CalendarDayButton">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               Foreground="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=CalendarDayButton}}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="1" CornerRadius="4" Margin="1">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource Theme.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.SubtleText}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Theme.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Theme.AccentText}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.SubtleText}" />
                            <Setter Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CalendarButton: the month/year picker's grid cells (e.g. "Jan"..
         "Dec", or a decade's years) — same ContentPresenter auto-wrap trap
         and the same fix as CalendarDayButton above. -->
    <Style x:Key="CalendarButtonStyle" TargetType="CalendarButton">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               Foreground="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=CalendarButton}}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarButton">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Margin="2">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource Theme.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.SubtleText}" />
                        </Trigger>
                        <Trigger Property="HasSelectedDays" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Theme.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Theme.AccentText}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.SubtleText}" />
                            <Setter Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CalendarItemStyle" TargetType="CalendarItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarItem">
                    <ControlTemplate.Resources>
                        <!-- day-of-week strip ("S M T W T F S"): CalendarItem
                             LoadContent()'s this DataTemplate directly for
                             each header cell — a real, explicitly-authored
                             TextBlock, never auto-wrapped — so a plain
                             local Foreground is enough; no trap here. -->
                        <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                            <TextBlock Text="{Binding}" Foreground="{DynamicResource Theme.Text}"
                                       FontWeight="SemiBold" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,0,0,4" />
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="PART_PreviousButton" Grid.Row="0" Grid.Column="0"
                                    Width="24" Height="24" Focusable="False"
                                    Background="Transparent" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="4">
                                            <Path Width="7" Height="7" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Data="M 6 0 L 6 8 L 0 4 Z"
                                                  Fill="{DynamicResource Theme.SubtleText}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background"
                                                        Value="{DynamicResource Theme.SurfaceHover}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.4" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="PART_HeaderButton" Grid.Row="0" Grid.Column="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    FontWeight="SemiBold" Focusable="False"
                                    Background="Transparent" BorderThickness="0" Padding="8,2">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource Theme.Text}" />
                                    </DataTemplate>
                                </Button.ContentTemplate>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                                CornerRadius="4">
                                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background"
                                                        Value="{DynamicResource Theme.SurfaceHover}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.4" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="PART_NextButton" Grid.Row="0" Grid.Column="2"
                                    Width="24" Height="24" Focusable="False"
                                    Background="Transparent" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="4">
                                            <Path Width="7" Height="7" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Data="M 0 0 L 0 8 L 6 4 Z"
                                                  Fill="{DynamicResource Theme.SubtleText}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background"
                                                        Value="{DynamicResource Theme.SurfaceHover}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.4" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- 7 rows (day-title row + 6 week rows) x 7
                                 columns — CalendarItem.PopulateGrids() fills
                                 this itself; the Grid only needs to define
                                 the matching row/column count. -->
                            <Grid x:Name="PART_MonthView" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                            </Grid>

                            <!-- 3 rows x 4 columns — month picker (12
                                 months) and decade picker (12 years) share
                                 this same grid. -->
                            <Grid x:Name="PART_YearView" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,0"
                                  Visibility="Hidden">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Value="Year">
                            <DataTrigger.Binding>
                                <Binding Path="DisplayMode">
                                    <Binding.RelativeSource>
                                        <RelativeSource Mode="FindAncestor" AncestorType="{x:Type Calendar}" />
                                    </Binding.RelativeSource>
                                </Binding>
                            </DataTrigger.Binding>
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Value="Decade">
                            <DataTrigger.Binding>
                                <Binding Path="DisplayMode">
                                    <Binding.RelativeSource>
                                        <RelativeSource Mode="FindAncestor" AncestorType="{x:Type Calendar}" />
                                    </Binding.RelativeSource>
                                </Binding>
                            </DataTrigger.Binding>
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Calendar">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource CalendarDayButtonStyle}" />
        <Setter Property="CalendarButtonStyle" Value="{StaticResource CalendarButtonStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Calendar">
                    <StackPanel x:Name="PART_Root" HorizontalAlignment="Center">
                        <CalendarItem x:Name="PART_CalendarItem"
                                      Style="{StaticResource CalendarItemStyle}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DatePicker: the closed control is fully themed here; the drop-down
         Calendar (the Calendar/CalendarItem/CalendarDayButton/CalendarButton
         family below) is fully theme-bound too now — every surface,
         border, and text colour in the popup tracks light/dark exactly like
         the rest of the app. -->
    <Style TargetType="DatePickerTextBox">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CaretBrush" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <Grid>
                        <ContentControl x:Name="PART_Watermark" Focusable="False"
                                        Foreground="{DynamicResource Theme.SubtleText}"
                                        Visibility="Collapsed" VerticalAlignment="Center" />
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        <!-- DatePicker.OnApplyTemplate constructs its own drop-down Calendar
             in code (`_calendar = new Calendar(); _calendar.SetBinding(
             Calendar.StyleProperty, ...DatePicker.CalendarStyleProperty)`),
             the same explicit-binding-suppresses-implicit-lookup shape as
             CalendarItem's day/month buttons above — proven directly:
             without this Setter, the popup's real Calendar (reached via a
             real DatePicker, not a bare `new Calendar()` like this file's
             own tests use) rendered byte-IDENTICAL PNGs in light and dark
             mode, i.e. it was still the untouched stock template throughout.
             `{StaticResource {x:Type Calendar}}` reaches the SAME implicit
             Calendar style above by its auto-generated type key — no
             separate x:Key needed, so a bare `new Calendar()` (as used by
             HighlightContrastTests) keeps resolving it too. -->
        <Setter Property="CalendarStyle" Value="{StaticResource {x:Type Calendar}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="6,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                               Foreground="{TemplateBinding Foreground}" />
                            <Button x:Name="PART_Button" Grid.Column="1" Focusable="False"
                                    Background="Transparent" BorderThickness="0" Padding="4,0"
                                    Content="&#xE787;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    FontSize="13" />
                            <Popup x:Name="PART_Popup" AllowsTransparency="True"
                                   Placement="Bottom" StaysOpen="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- side-nav look: accent bar + surface fill on the selected section -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Padding" Value="14,9" />
        <!-- Task 8: focus-ring coverage — see the CheckBox/RadioButton pair
             above. SettingsWindow.xaml's "SectionTab" style is
             BasedOn="{StaticResource {x:Type TabItem}}" and sets no
             FocusVisualStyle of its own, so this Setter is inherited there
             too without touching that window's XAML. -->
        <Setter Property="FocusVisualStyle" Value="{StaticResource BronzeFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Background="Transparent" BorderThickness="3,0,0,0"
                            BorderBrush="Transparent" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Theme.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Theme.Surface}" />
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource Theme.Accent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Theme.SubtleText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="RowBackground" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource Theme.WindowBg}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Theme.WindowBg}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Theme.Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource Theme.AccentText}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Named styles -->

    <!-- Fluent glyphs from the system icon font — no image assets, always
         theme-colored, crisp at any DPI. Win10 falls back to MDL2. -->
    <Style x:Key="Icon" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The type ramp: Display (the big count), Headline/Title, Section,
         body (implicit), Caption. Displayed numbers use tabular figures so
         changing counts don't wiggle. -->
    <Style x:Key="DisplayText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="76" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="SectionText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource Theme.SubtleText}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- The caption rung at full text weight. Most captions are hints and
         should be de-emphasised (CaptionText above); these few carry content
         the user actually reads — the last action's detail line, a subfolder
         path, a live preview note — and are small only to fit, not to recede. -->
    <Style x:Key="CaptionTextOnSurface" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- The app-level implicit TextBlock style (TargetType="TextBlock" above,
         Foreground=Theme.Text) is a Style Setter, and Style Setters always
         outrank property-value INHERITANCE. That alone would suggest a more
         specific implicit TextBlock style, scoped closer to the button, could
         win instead — but it can't: a plain string Content is auto-wrapped by
         ContentPresenter using an internal, special-cased template (not a
         real ContentTemplate instantiation), and that generated TextBlock's
         implicit-style search provably does NOT consult the templated
         Button's own Resources at all — verified directly: neither
         Style.Resources on PrimaryButton nor even resources added straight to
         a real Button instance's own Resources dictionary ever reached that
         auto-generated TextBlock; it always resolved the Application-level
         implicit style regardless. (An explicit ContentTemplate does reach
         it, but forcibly wraps ANY Content in a TextBlock — including the
         icon+text StackPanel PrintPreviewWindow's Print button already uses,
         which a template-level fix would silently swallow.)
         The fix that's actually provable: stop relying on the auto-wrap.
         PrimaryButtonLabel below is a NAMED (non-implicit) style, applied
         explicitly to a real, hand-declared TextBlock at each call site
         (`<TextBlock Text="…" Style="{StaticResource PrimaryButtonLabel}"/>`
         as the Button's Content). A real, explicitly-styled element is never
         auto-wrapped — ContentPresenter hosts already-a-UIElement content
         directly, the same path PrintPreviewWindow's StackPanel already
         takes — so ordinary StaticResource style lookup applies, unaffected
         by the auto-wrap quirk. PrimaryButton's Foreground never changes
         with state (hover/pressed only dim the Chrome's Opacity), so a fixed
         DynamicResource here is correct — no need to track the button live. -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource Theme.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.AccentText}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Pair with PrimaryButton above: apply explicitly to a real TextBlock
         used as PrimaryButton's Content, never relying on the auto-wrap. -->
    <Style x:Key="PrimaryButtonLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Theme.AccentText}" />
    </Style>

    <!-- Small pill chips for one-click presets. Deliberately unlike the
         inputs they sit beside: inputs are square-cornered and hollow,
         chips are borderless pills on the hover tint that light up accent
         on hover — unmistakably pressable. -->
    <!-- Same auto-wrap problem as PrimaryButton above, plus ChipButton's
         label can't take a fixed DynamicResource: its hover trigger flips
         the BUTTON's own Foreground between Theme.Text (rest, inherited from
         the base Button style) and Theme.AccentText (hover, a
         template-trigger Setter with no TargetName — that targets the
         templated element itself, i.e. this Button). ChipButtonLabel below
         is the same named-style-on-a-real-TextBlock fix as
         PrimaryButtonLabel, except its Foreground is a live Binding
         (RelativeSource AncestorType=Button) rather than a fixed
         DynamicResource, so it tracks whichever Foreground the Button
         currently has — verified directly: changing a Button's Foreground
         at runtime does propagate through this binding to the TextBlock,
         through both the base and the hover-triggered value. -->
    <Style x:Key="ChipButtonLabel" TargetType="TextBlock">
        <Setter Property="Foreground"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
    </Style>

    <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource Theme.SurfaceHover}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="11,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="12" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource Theme.Accent}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Theme.AccentText}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SubtleText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource Theme.SubtleText}" />
    </Style>

    <!-- The label+control row shape. Lived privately in SettingsWindow until
         2026-08-03; BulkRename, LabelMaker, MatchMerge and Unlock hand-rolled
         it with their own margins and drifted apart. Settings' values win
         because it has 19 rows to the others' handful. -->
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <Style x:Key="FieldRow" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="HeadlineText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource Theme.StatusAmber}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
