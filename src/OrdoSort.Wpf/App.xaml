<Application x:Class="OrdoSort.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OrdoSort.Wpf.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Both dictionaries live in OrdoSort.Ui now, so BoxLabels.exe
                     can merge the identical pair. A pack URI is how a
                     dictionary in a referenced assembly is addressed; a bare
                     relative Source would look inside this assembly and fail
                     at RUNTIME, on the first window shown, not at build. -->
                <ResourceDictionary Source="pack://application:,,,/OrdoSort.Ui;component/Theme/Styles.xaml" />
                <ResourceDictionary Source="pack://application:,,,/OrdoSort.Ui;component/Theme/Illustrations.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <views:RgbToBrushConverter x:Key="RgbToBrush" />
            <views:InvertBoolConverter x:Key="InvertBool" />
            <views:ColorStringToBrushConverter x:Key="ColorStringToBrush" />
            <views:ColorStringToForeBrushConverter x:Key="ColorStringToForeBrush" />
            <views:SwatchCheckConverter x:Key="SwatchCheck" />
            <views:PlusOneConverter x:Key="PlusOne" />
            <views:TextToVisibilityConverter x:Key="TextToVis" />
            <views:FileNameConverter x:Key="FileName" />
            <views:PasswordStatusConverter x:Key="PasswordStatus" />
            <views:FontSizeTextConverter x:Key="FontSizeText" />
            <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
            <sys:Double x:Key="AppFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">14</sys:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
