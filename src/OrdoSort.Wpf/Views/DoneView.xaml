<UserControl x:Class="OrdoSort.Wpf.Views.DoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <ContentControl Template="{StaticResource Illustration.Done}"
                         Height="96" Margin="0,4,0,12" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding CountLine}" Style="{StaticResource HeadlineText}"
                   Foreground="{DynamicResource Theme.Success}" />
        <TextBlock Text="{Binding DetailLine}" TextWrapping="Wrap" Margin="0,6,0,0" />
        <TextBlock Text="{Binding LogLine}" Style="{StaticResource SubtleText}"
                   TextWrapping="Wrap" Margin="0,4,0,0"
                   Visibility="{Binding HasLogLine, Converter={StaticResource BoolToVis}}" />

        <!-- the trail, completed: a short rule ending in a filled dot — only
             when there was a move to complete (mirrors the LogLine gate: no
             moves, or an unrecorded one, means no trail to show as done) -->
        <Grid HorizontalAlignment="Center" Margin="0,14,0,0" Width="120" Height="8"
              Visibility="{Binding HasLogLine, Converter={StaticResource BoolToVis}}">
            <Rectangle Height="2" VerticalAlignment="Center"
                       Fill="{DynamicResource Theme.Border}" />
            <Ellipse Width="8" Height="8" HorizontalAlignment="Right"
                     Fill="{DynamicResource Theme.Success}" />
        </Grid>

        <Button Command="{Binding RescanCommand}"
                Style="{StaticResource PrimaryButton}" Height="42" Margin="0,16,0,0"
                AutomationProperties.Name="Back to inbox">
            <TextBlock Text="Back to inbox" Style="{StaticResource PrimaryButtonLabel}" />
        </Button>
        <Button Content="Undo last   ·   Ctrl+Shift+Z" Command="{Binding UndoCommand}"
                Height="36" Margin="0,8,0,0" />

        <TextBlock Text="{Binding StatusLine}" Style="{StaticResource StatusText}"
                   Margin="0,12,0,0" />
    </StackPanel>
</UserControl>
