<UserControl x:Class="OrdoSort.Wpf.Views.ProcessingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{Binding ProgressLine}" Style="{StaticResource HeadlineText}"
                   Typography.NumeralAlignment="Tabular" />
        <TextBlock Text="{Binding CurrentFilename}" Style="{StaticResource SubtleText}"
                   TextWrapping="Wrap" Margin="0,4,0,0" />

        <TextBlock Text="Name:" Margin="0,14,0,4" Style="{StaticResource SectionText}" />
        <!-- the room where the work happens — a little extra presence -->
        <TextBox x:Name="NameBox" FontSize="16" Padding="8,6"
                 Text="{Binding TypedName, UpdateSourceTrigger=PropertyChanged}"
                 PreviewKeyDown="NameBox_PreviewKeyDown"
                 LostKeyboardFocus="NameBox_LostKeyboardFocus"
                 TextChanged="NameBox_TextChanged"
                 AutomationProperties.Name="Name">
            <TextBox.Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding UppercaseNames}" Value="True">
                            <Setter Property="CharacterCasing" Value="Upper" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>
        <Popup x:Name="SuggestPopup" PlacementTarget="{Binding ElementName=NameBox}"
               Placement="Bottom" StaysOpen="True" AllowsTransparency="True"
               PopupAnimation="Fade"
               IsOpen="{Binding HasSuggestions, Mode=OneWay}"
               Width="{Binding ActualWidth, ElementName=NameBox}">
            <!-- a raised, bordered card — flat per the crisp-workbench spec
                 (no shadow); the margin is just breathing room inside the
                 popup, not shadow clearance -->
            <Border Margin="0,2,8,10" CornerRadius="4"
                    Background="{DynamicResource Theme.SurfaceRaised}"
                    BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1">
                <ListBox x:Name="SuggestList" ItemsSource="{Binding Suggestions}"
                         Focusable="False" MaxHeight="220" Margin="3"
                         Background="Transparent" BorderThickness="0"
                         SelectionChanged="SuggestList_SelectionChanged" />
            </Border>
        </Popup>
        <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                   Text="Tab completes a word · ↓ ↑ walk the matches · blank files without renaming" />

        <TextBlock Text="Will be filed as:" Margin="0,12,0,6" Style="{StaticResource SectionText}" />
        <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MinHeight="40">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Style.Triggers>
                        <!-- Theme.StatusRed, NOT Theme.Danger (status-colour-
                             vocabulary plan, 2026-08-08, Task 3 Part B): this
                             is real foreground TEXT, and Danger as foreground
                             measured only 3.14:1 against this element's real
                             background (Theme.WindowBg, dark) — a WCAG AA
                             failure shipping today. StatusRed measures
                             5.72:1 here (dark) / 5.11:1 (light), both >=4.5.
                             See ThemePalette.cs's StatusRed field comment. -->
                        <DataTrigger Binding="{Binding PreviewIsWarning}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.StatusRed}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBlock Text="File to:" Margin="0,12,0,2" Style="{StaticResource SectionText}" />
        <!-- Focusable=False: a bare ItemsControl is itself a tab stop, so Tab
             from the name box landed on the whole button block before the
             first button -->
        <ItemsControl ItemsSource="{Binding Routes}" Margin="0,2,0,0" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Height="44" Margin="0,3"
                            Command="{Binding DataContext.RouteCommand,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Index}"
                            IsEnabled="{Binding Enabled}"
                            ToolTip="{Binding DisabledReason}"
                            ToolTipService.ShowOnDisabled="True"
                            HorizontalContentAlignment="Stretch"
                            Background="{Binding Back, Converter={StaticResource RgbToBrush}}"
                            Foreground="{Binding Fore, Converter={StaticResource RgbToBrush}}"
                            AutomationProperties.Name="{Binding Label}">
                        <Grid>
                            <!-- the trail: a rule entering from the left, lit
                                 on the route this session filed to last. State,
                                 never animation — this sits on the filing path.
                                 Colored from THIS route's own Fore (already
                                 WCAG-contrasted against Back by IdealForeground)
                                 rather than Theme.Accent, so the rule stays
                                 visible even on a route colored the same as the
                                 accent. Lit vs. unlit is Opacity, not a second
                                 color, so one style covers every route color.
                                 Margin brings the rule flush to the button's
                                 inner border edge (Padding.Left=12 from
                                 Styles.xaml) instead of floating ~13px in. -->
                            <Rectangle Width="2" HorizontalAlignment="Left"
                                       VerticalAlignment="Stretch" Margin="-12,0,0,0"
                                       RadiusX="1" RadiusY="1"
                                       Fill="{Binding Fore, Converter={StaticResource RgbToBrush}}">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Opacity" Value="0.25" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLastUsed}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{Binding Fore, Converter={StaticResource RgbToBrush}}" />
                            <!-- the one button Enter presses right now — the
                                 accent's one badge role (crisp-workbench spec).
                                 A route's Back can be ANY configured color (the
                                 button's own Foreground above is WCAG-picked
                                 against THAT color, via IdealForeground), so a
                                 glyph merely colored bronze could land on a
                                 bronze-adjacent route with near-zero contrast.
                                 Putting the glyph on its own flat bronze PLATE
                                 sidesteps the route color entirely — the glyph
                                 only ever has to contrast with bronze, which is
                                 fixed per theme, so Theme.AccentBronzeText (the
                                 same precomputed-IdealForeground pattern
                                 ThemeManager derives it with) is correct by
                                 construction on every route, every theme. -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,4,0" CornerRadius="4" Padding="5,1"
                                    Background="{DynamicResource Theme.AccentBronze}"
                                    ToolTip="Enter files here"
                                    Visibility="{Binding IsEnterTarget,
                                                 Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="⏎" FontWeight="Bold"
                                           Foreground="{DynamicResource Theme.AccentBronzeText}" />
                            </Border>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Content="Set aside   ·   Ctrl+K" Command="{Binding SkipCommand}"
                Height="36" Margin="0,7,0,0" />
        <Button Content="Undo last   ·   Ctrl+Shift+Z" Command="{Binding UndoCommand}"
                Height="36" Margin="0,6,0,0" />
        <Button Content="Stop   ·   Esc" Command="{Binding StopCommand}"
                Height="36" Margin="0,6,0,0" />

        <TextBlock Text="{Binding StatusLine}" Style="{StaticResource StatusText}"
                   Margin="0,12,0,0" />

        <!-- what just happened: a transient card in the pressed route's color
             (green when the route has none; amber for set-aside). Sits at the
             bottom so the buttons above never shift mid-click. -->
        <Border CornerRadius="4" Padding="12,9" Margin="0,12,0,0"
                Background="{Binding LastActionBack, Converter={StaticResource RgbToBrush}}"
                Visibility="{Binding LastActionVisible, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <Trigger Property="Visibility" Value="Visible">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding LastActionText}" FontWeight="SemiBold"
                           Foreground="{Binding LastActionFore, Converter={StaticResource RgbToBrush}}" />
                <TextBlock Text="{Binding LastActionDetail}" Style="{StaticResource CaptionTextOnSurface}" Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Foreground="{Binding LastActionFore, Converter={StaticResource RgbToBrush}}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
