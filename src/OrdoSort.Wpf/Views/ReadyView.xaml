<UserControl x:Class="OrdoSort.Wpf.Views.ReadyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OrdoSort.Wpf.Views">
    <UserControl.Resources>
        <!-- Width-adaptive tile grid (Phase 3, Task 3.4, approved mockup):
             see WidthToColumnsConverter.cs for the full breakpoint math and
             why UniformGrid (not a plain WrapPanel) stays the panel. -->
        <local:WidthToColumnsConverter x:Key="WidthToColumns" />

        <!-- Tile entrance cascade (Phase-2 restyle, D3): a one-time,
             ~30ms-per-tile stagger on the Ready dashboard's folder tiles,
             replacing the single simultaneous 150ms fade every tile used to
             share. This is a one-time entrance on the Ready dashboard, not
             anything on the filing path itself, so it's in bounds under
             this app's "state, never animation on the filing path" rule.

             The app has no reduced-motion story to defer to: grepped for
             SystemParameters.ClientAreaAnimation across src/OrdoSort.Wpf —
             zero hits, so there's no existing setting this could read.
             Rather than invent one, the stagger is kept deliberately small
             (30ms/index, 150ms fade, 360ms worst case for the 8th tile —
             under the 400ms/8-tiles ceiling) instead of adding new surface
             area a Phase-2 icon/illustration pass has no mandate to grow.

             Mechanism, entirely in XAML: the inner Tiles ItemsControl below
             gets AlternationCount="8", which makes WPF stamp each tile's
             generated container (a ContentPresenter — ItemsControl's own
             default container when no ItemContainerStyle is set; the
             Button below is the template's ROOT CONTENT, not the
             container) with an AlternationIndex 0-7, cycling if a group
             ever has more than 8 tiles. AlternationIndex isn't an inherited
             property, so a plain property Trigger on this Style (which
             only ever sees a value actually set ON THE BUTTON itself)
             can't read it — each branch below is a DataTrigger instead,
             bound via RelativeSource to the ContentPresenter ancestor that
             actually carries it, the standard technique for reaching
             AlternationIndex from inside an ItemTemplate.

             Base Opacity="0": without it, a staggered tile (index>0) would
             render at the Button's ordinary default (Opacity=1) for the
             length of its own BeginTime delay, then SNAP to 0 the instant
             its animation clock actually starts — a flash-then-fade, not a
             cascade. A Clock only drives its target property once the
             Clock's own BeginTime has elapsed; before that, the property
             falls back to whatever this Style's own (non-animated) value
             says, which is why that value has to already BE 0. -->
        <Style x:Key="TileCascade" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Opacity" Value="0" />
            <Style.Triggers>
                <DataTrigger Value="0">
                    <DataTrigger.Binding>
                        <Binding Path="(ItemsControl.AlternationIndex)"
                                 RelativeSource="{RelativeSource AncestorType=ContentPresenter}" />
                    </DataTrigger.Binding>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" BeginTime="0:0:0.00" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Value="1">
                    <DataTrigger.Binding>
                        <Binding Path="(ItemsControl.AlternationIndex)"
                                 RelativeSource="{RelativeSource AncestorType=ContentPresenter}" />
                    </DataTrigger.Binding>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" BeginTime="0:0:0.03" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Value="2">
                    <DataTrigger.Binding>
                        <Binding Path="(ItemsControl.AlternationIndex)"
                                 RelativeSource="{RelativeSource AncestorType=ContentPresenter}" />
                    </DataTrigger.Binding>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" BeginTime="0:0:0.06" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Value="3">
                    <DataTrigger.Binding>
                        <Binding Path="(ItemsControl.AlternationIndex)"
                                 RelativeSource="{RelativeSource AncestorType=ContentPresenter}" />
                    </DataTrigger.Binding>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" BeginTime="0:0:0.09" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Value="4">
                    <DataTrigger.Binding>
                        <Binding Path="(ItemsControl.AlternationIndex)"
                                 RelativeSource="{RelativeSource AncestorType=ContentPresenter}" />
                    </DataTrigger.Binding>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" BeginTime="0:0:0.12" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Value="5">
                    <DataTrigger.Binding>
                        <Binding Path="(ItemsControl.AlternationIndex)"
                                 RelativeSource="{RelativeSource AncestorType=ContentPresenter}" />
                    </DataTrigger.Binding>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" BeginTime="0:0:0.15" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Value="6">
                    <DataTrigger.Binding>
                        <Binding Path="(ItemsControl.AlternationIndex)"
                                 RelativeSource="{RelativeSource AncestorType=ContentPresenter}" />
                    </DataTrigger.Binding>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" BeginTime="0:0:0.18" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Value="7">
                    <DataTrigger.Binding>
                        <Binding Path="(ItemsControl.AlternationIndex)"
                                 RelativeSource="{RelativeSource AncestorType=ContentPresenter}" />
                    </DataTrigger.Binding>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" BeginTime="0:0:0.21" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <!-- Skeleton (Phase 3, Task 3.4): eight stacked rows — dashboard groups /
         divider / quiet line / divider / big count block / detail /
         illustration / Start button — replacing what used to be two
         StackPanels wrapping the first two conditionally-visible sections.
         Grid.RowDefinitions carry no spacing of their own (same as
         StackPanel's implicit zero gap), so every Margin below is unchanged
         from what each element already carried as a StackPanel child — this
         is a reparent, not a re-tune. A collapsed row's sole child measures
         (0,0), so an Auto row holding it collapses to zero height on its
         own; DashboardVisible/AllQuiet no longer need a wrapping panel to
         hide their two elements (tiles+divider, quiet-line+divider) together. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 0: dashboard groups -->
            <RowDefinition Height="Auto" />   <!-- 1: divider -->
            <RowDefinition Height="Auto" />   <!-- 2: quiet line -->
            <RowDefinition Height="Auto" />   <!-- 3: divider -->
            <RowDefinition Height="Auto" />   <!-- 4: big count block -->
            <RowDefinition Height="Auto" />   <!-- 5: detail -->
            <RowDefinition Height="Auto" />   <!-- 6: illustration -->
            <RowDefinition Height="Auto" />   <!-- 7: Start button -->
        </Grid.RowDefinitions>

        <!-- monitored folders: grid of cards at the top -->
        <ItemsControl Grid.Row="0" ItemsSource="{Binding TileGroups}" Focusable="False"
                      Visibility="{Binding DashboardVisible, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionText}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False"
                                      AlternationCount="8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- Columns bound off the ANCESTOR ItemsControl's own
                                         ActualWidth (not this UniformGrid's own — the two
                                         report the same number since both default to
                                         HorizontalAlignment="Stretch", but going through the
                                         ancestor avoids a same-element self-reference read).
                                         See WidthToColumnsConverter.cs for the breakpoint math. -->
                                    <UniformGrid Columns="{Binding ActualWidth,
                                                 RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                 Converter={StaticResource WidthToColumns}}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- a grid card per folder; a real Button, so it's
                                         keyboard-focusable and screen-reader-named -->
                                    <!-- Style="{StaticResource TileCascade}": tiles fade in as
                                         folders light up, staggered ~30ms/tile — see
                                         TileCascade's own doc comment (UserControl.Resources
                                         above) for the mechanism and why the plain Loaded
                                         EventTrigger this used to carry couldn't stagger. -->
                                    <Button Command="{Binding OpenCommand}"
                                            Style="{StaticResource TileCascade}"
                                            Background="{Binding Back, Converter={StaticResource RgbToBrush}}"
                                            Foreground="{Binding Fore, Converter={StaticResource RgbToBrush}}"
                                            AutomationProperties.Name="{Binding Display}"
                                            ToolTip="{Binding Tooltip}"
                                            MinHeight="78" Margin="0,0,6,6" Padding="12,8"
                                            HorizontalContentAlignment="Left"
                                            VerticalContentAlignment="Top"
                                            BorderThickness="0" Cursor="Hand">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <!-- EmphasisText/BodySmallText size — Icon style already sets
                                                     FontFamily+VerticalAlignment; converting to a size-only
                                                     style would drop the glyph font. -->
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;"
                                                           FontSize="12" Margin="0,0,6,0"
                                                           Foreground="{Binding Fore, Converter={StaticResource RgbToBrush}}" />
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource BodySmallText}"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           Foreground="{Binding Fore, Converter={StaticResource RgbToBrush}}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding CountText}" Style="{StaticResource TileCountText}"
                                                       Margin="0,2,0,0" Typography.NumeralAlignment="Tabular"
                                                       Foreground="{Binding Fore, Converter={StaticResource RgbToBrush}}" />
                                            <!-- where the alerting file sits, when it's in
                                                 a subfolder of the watched folder -->
                                            <TextBlock Text="{Binding SubfolderNote}" Style="{StaticResource CaptionTextOnSurface}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasSubfolderNote,
                                                                    Converter={StaticResource BoolToVis}}"
                                                       Foreground="{Binding Fore, Converter={StaticResource RgbToBrush}}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- separation between the monitored folders and the inbox block -->
        <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource Theme.Border}" Margin="0,14,0,0"
                   Visibility="{Binding DashboardVisible, Converter={StaticResource BoolToVis}}" />

        <!-- monitoring is on and nothing needs attention — say so instead of
             silently vanishing the section -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0"
                    Visibility="{Binding AllQuiet, Converter={StaticResource BoolToVis}}">
            <!-- BodySmallText size — Icon style already sets FontFamily;
                 converting would drop it. -->
            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="12"
                       Foreground="{DynamicResource Theme.Success}" Margin="0,0,6,0" />
            <TextBlock Text="All monitored folders are quiet"
                       Style="{StaticResource SubtleText}" />
        </StackPanel>
        <Rectangle Grid.Row="3" Height="1" Fill="{DynamicResource Theme.Border}" Margin="0,12,0,0"
                   Visibility="{Binding AllQuiet, Converter={StaticResource BoolToVis}}" />

        <!-- the inbox: one big number over the Start button. A real button —
             clicking it opens the inbox folder (keyboard/screen-reader too) -->
        <Button Grid.Row="4" Command="{Binding OpenInboxCommand}"
                HorizontalAlignment="Center" Margin="0,14,0,0"
                Cursor="Hand" ToolTip="Open the inbox folder"
                AutomationProperties.Name="{Binding CountLine}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent"
                            CornerRadius="4" Padding="18,0,18,4">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Theme.RowHover, NOT Theme.SurfaceHover (hover-tint
                             strength review round 2, 2026-08-08): BigCount
                             below can render Theme.StatusRed while
                             CountAlertOn, so this hover must protect that
                             pairing the same way a grid Note cell does — see
                             ThemePalette.cs's RowHover comment. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background"
                                    Value="{DynamicResource Theme.RowHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <StackPanel>
                <TextBlock Text="{Binding BigCount}" HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource DisplayText}">
                            <Style.Triggers>
                                <!-- Theme.StatusRed, NOT Theme.Danger (status-
                                     colour-vocabulary plan, 2026-08-08, Task 3
                                     Part B): this is real foreground TEXT (the
                                     big inbox-count headline), and Danger as
                                     foreground measured only 3.14:1 against
                                     this element's real background
                                     (Theme.WindowBg, dark) — a WCAG AA
                                     failure shipping today. StatusRed
                                     measures 5.72:1 here (dark) / 5.11:1
                                     (light), both >=4.5. See ThemePalette.cs's
                                     StatusRed field comment. -->
                                <DataTrigger Binding="{Binding CountAlertOn}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.StatusRed}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- Negative margin, not a spacing-rhythm value, and not
                     debt (Phase 3, Task 3.4 — the skeleton-restructure pass
                     that owned resolving this, per the B1 spacing-rhythm
                     audit that first flagged it): DisplayText (Styles.xaml)
                     is FontSize=76, and WPF reserves a line box for that
                     size from the font's own ascent+descent+internal-
                     leading metrics — there is no non-negative TextBlock/
                     row-layout property (Padding, a Grid row's Height, …)
                     that trims JUST that reserved leading out from under a
                     single line of text without also risking clipping or
                     shifting the glyphs themselves. A negative top margin on
                     the sibling below is the standard, narrowly-scoped WPF
                     technique for this exact "the font's own line box is
                     taller than its ink" gap — kept deliberately intentional
                     here, not a leftover to revisit. -->
                <TextBlock Text="{Binding CountCaption}" Style="{StaticResource SubtleText}"
                           HorizontalAlignment="Center" Margin="0,-6,0,0" />
            </StackPanel>
        </Button>
        <TextBlock Grid.Row="5" Text="{Binding DetailLine}" Style="{StaticResource SubtleText}"
                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                   Margin="0,4,0,0" />

        <!-- a calm moment when the inbox is actually empty -->
        <ContentControl Grid.Row="6" Template="{StaticResource Illustration.InboxClear}"
                         Height="104" Margin="0,12,0,0">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding BigCount}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <!-- EmphasisText size — this FontSize is set on the Button (already
             carrying Style="{StaticResource PrimaryButton}") so it inherits
             into both TextBlocks below; EmphasisText is TextBlock-only, and
             moving the value down into the template would be template
             surgery for a rename-only pass. -->
        <Button Grid.Row="7" Command="{Binding StartCommand}"
                Style="{StaticResource PrimaryButton}" Height="48" Margin="0,14,0,0"
                FontSize="15" AutomationProperties.Name="Start processing">
            <StackPanel Orientation="Horizontal">
                <!-- EmphasisText size — Icon style already sets FontFamily;
                     converting would drop it. -->
                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="15"
                           Margin="0,0,9,0" Foreground="{DynamicResource Theme.AccentText}" />
                <!-- sentence case, like every other button in the app
                     (2026-08-02 audit M4 — this was the only Title-Case one).
                     The AutomationProperties.Name above must match what is
                     rendered, or a screen-reader user and a sighted user are
                     told two different labels. -->
                <TextBlock Text="Start processing"
                           Foreground="{DynamicResource Theme.AccentText}" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
