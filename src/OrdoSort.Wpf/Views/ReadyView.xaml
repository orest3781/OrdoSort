<UserControl x:Class="OrdoSort.Wpf.Views.ReadyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- monitored folders: grid of cards at the top (Python parity) -->
        <StackPanel Visibility="{Binding DashboardVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding MonitorTitle}" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- a grid card per folder; a real Button, so it's
                             keyboard-focusable and screen-reader-named -->
                        <Button Command="{Binding OpenCommand}"
                                Background="{Binding Back, Converter={StaticResource RgbToBrush}}"
                                Foreground="{Binding Fore, Converter={StaticResource RgbToBrush}}"
                                AutomationProperties.Name="{Binding Display}"
                                ToolTip="{Binding Tooltip}"
                                MinHeight="78" Margin="0,0,6,6" Padding="12,8"
                                HorizontalContentAlignment="Left"
                                VerticalContentAlignment="Top"
                                BorderThickness="0" Cursor="Hand"
                                Effect="{StaticResource Elevation1}">
                            <Button.Triggers>
                                <!-- tiles fade in as folders light up -->
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Button.Triggers>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;"
                                               FontSize="12" Margin="0,0,6,0"
                                               Foreground="{Binding Fore, Converter={StaticResource RgbToBrush}}" />
                                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding Fore, Converter={StaticResource RgbToBrush}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding CountText}" FontSize="27" FontWeight="Bold"
                                           Margin="0,2,0,0" Typography.NumeralAlignment="Tabular"
                                           Foreground="{Binding Fore, Converter={StaticResource RgbToBrush}}" />
                                <!-- where the alerting file sits, when it's in
                                     a subfolder of the watched folder -->
                                <TextBlock Text="{Binding SubfolderNote}" FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding HasSubfolderNote,
                                                        Converter={StaticResource BoolToVis}}"
                                           Foreground="{Binding Fore, Converter={StaticResource RgbToBrush}}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- separation between the monitored folders and the inbox block -->
            <Rectangle Height="1" Fill="{DynamicResource Theme.Border}" Margin="0,14,0,0" />
        </StackPanel>

        <!-- monitoring is on and nothing needs attention — say so instead of
             silently vanishing the section -->
        <StackPanel Visibility="{Binding AllQuiet, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="12"
                           Foreground="{DynamicResource Theme.Success}" Margin="0,0,7,0" />
                <TextBlock Text="All monitored folders are quiet"
                           Style="{StaticResource SubtleText}" />
            </StackPanel>
            <Rectangle Height="1" Fill="{DynamicResource Theme.Border}" Margin="0,12,0,0" />
        </StackPanel>

        <!-- the inbox: one big number over the Start button. A real button —
             clicking it opens the inbox folder (keyboard/screen-reader too) -->
        <Button Command="{Binding OpenInboxCommand}"
                HorizontalAlignment="Center" Margin="0,14,0,0"
                Cursor="Hand" ToolTip="Open the inbox folder"
                AutomationProperties.Name="{Binding CountLine}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent"
                            CornerRadius="6" Padding="18,0,18,4">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background"
                                    Value="{DynamicResource Theme.SurfaceHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <StackPanel>
                <TextBlock Text="{Binding BigCount}" HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource DisplayText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CountAlertOn}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding CountCaption}" Style="{StaticResource SubtleText}"
                           HorizontalAlignment="Center" Margin="0,-6,0,0" />
            </StackPanel>
        </Button>
        <TextBlock Text="{Binding DetailLine}" Style="{StaticResource SubtleText}"
                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                   Margin="0,4,0,0" />

        <!-- a calm moment when the inbox is actually empty -->
        <Image Height="104" Margin="0,12,0,0"
               RenderOptions.BitmapScalingMode="HighQuality"
               Source="pack://application:,,,/OrdoSort;component/Assets/inbox-clear.png">
            <Image.Style>
                <Style TargetType="Image">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding BigCount}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Image.Style>
        </Image>

        <Button Command="{Binding StartCommand}"
                Style="{StaticResource PrimaryButton}" Height="48" Margin="0,14,0,0"
                FontSize="15" AutomationProperties.Name="Start Processing">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="15"
                           Margin="0,0,9,0" Foreground="{DynamicResource Theme.AccentText}" />
                <TextBlock Text="Start Processing"
                           Foreground="{DynamicResource Theme.AccentText}" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
