<Window x:Class="OrdoSort.Wpf.Windows.MatchMergeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrdoSort — Match and merge" Width="840" Height="640" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" AllowDrop="True"
        DragOver="OnDragOver" Drop="OnDrop"
        Style="{StaticResource {x:Type Window}}">
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Width="96" IsCancel="True" />
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding MergeCommand}"
                        Style="{StaticResource PrimaryButton}" MinWidth="120" Margin="0,0,8,0"
                        AutomationProperties.Name="{Binding MergeButtonText}">
                    <StackPanel Orientation="Horizontal">
                        <!-- E8C8 (copy/merge), distinct from this tool's own
                             Tools menu glyph (E721, "_Match and merge…") so
                             the in-window action and the tool-opening menu
                             entry don't share one glyph. -->
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" Margin="0,0,8,0"
                                   Foreground="{DynamicResource Theme.AccentText}" />
                        <TextBlock Text="{Binding MergeButtonText}" Style="{StaticResource PrimaryButtonLabel}" />
                    </StackPanel>
                </Button>
                <Button Click="OnReview" IsEnabled="{Binding CanReview}" Margin="0,0,8,0"
                        AutomationProperties.Name="{Binding ReviewButtonText}">
                    <StackPanel Orientation="Horizontal">
                        <!-- E8FD, not E721 — E721 is already this tool's own
                             Tools menu glyph (opening the whole window); this
                             is a different action inside it. -->
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding ReviewButtonText}" />
                    </StackPanel>
                </Button>
                <Button Content="Undo last merge" Command="{Binding UndoCommand}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                           Style="{StaticResource StatusText}" MaxWidth="300" />
            </StackPanel>
        </DockPanel>

        <!-- IsSharedSizeScope: only one FieldRow lives in this window today
             (Roster:, below), but it follows the LabelMakerWindow.xaml
             SharedSizeGroup="LabelCol" pattern anyway (spacing-rhythm audit
             B2) so the label sizes to its content instead of a fixed width,
             and so any FieldRow added here later joins the same scope for
             free. -->
        <Grid Grid.IsSharedSizeScope="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Style="{StaticResource FieldRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Roster:" Style="{StaticResource FieldLabel}" />
                <Grid Grid.Column="1">
                    <TextBox Text="{Binding RosterPath, Mode=OneWay}" IsReadOnly="True" />
                    <TextBlock Text="no roster loaded yet — pick the spreadsheet (CSV or Excel) with names and Control IDs"
                               VerticalAlignment="Center" Margin="8,0" IsHitTestVisible="False"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RosterPath}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button Grid.Column="2" Content="Load spreadsheet…" Margin="8,0,0,0"
                        Command="{Binding LoadRosterCommand}" />
            </Grid>

            <!-- header mapping means nothing until a roster is in -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10"
                        Visibility="{Binding HasRoster, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="First name:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox MinWidth="140" ItemsSource="{Binding Headers}"
                          SelectedItem="{Binding FirstHeader}" Margin="0,0,12,0" />
                <TextBlock Text="Last name:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox MinWidth="140" ItemsSource="{Binding Headers}"
                          SelectedItem="{Binding LastHeader}" Margin="0,0,12,0" />
                <TextBlock Text="Control ID:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox MinWidth="140" ItemsSource="{Binding Headers}"
                          SelectedItem="{Binding ControlHeader}" />
            </StackPanel>

            <DockPanel Grid.Row="2" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="Add PDFs…" Click="OnAddFiles" Margin="0,0,6,0" />
                    <Button Content="Add a folder's PDFs…" Click="OnAddFolder" Margin="0,0,6,0" />
                    <Button Content="Remove selected" Click="OnRemoveSelected" Margin="0,0,6,0" />
                    <Button Content="Clear" Command="{Binding ClearCommand}" Margin="0,0,10,0" />
                    <!-- ClickMode="Press": the app's own ComboBox template
                         (Theme/Styles.xaml, its Toggle ToggleButton) sets
                         this on every dropdown toggle it owns for the same
                         reason — with the default Release, the Popup below
                         (StaysOpen="False") sees the outside MouseDown and
                         closes itself BEFORE this button's own Click (fired
                         on MouseUp) flips IsChecked back on, so a click on
                         the toggle while the popup is open closes it and
                         immediately reopens it instead of just closing it.
                         Press fires the toggle on the same MouseDown the
                         Popup dismisses on, so the two agree. -->
                    <ToggleButton x:Name="ColumnsToggle" Content="Columns…" Margin="0,0,10,0"
                                  ClickMode="Press"
                                  Visibility="{Binding HasRoster, Converter={StaticResource BoolToVis}}" />
                    <Popup IsOpen="{Binding IsChecked, ElementName=ColumnsToggle, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=ColumnsToggle}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{DynamicResource Theme.SurfaceRaised}"
                                BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
                                CornerRadius="4" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Show in Review matches:" Style="{StaticResource SectionText}"
                                           Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding ColumnPicks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}"
                                                      IsChecked="{Binding IsChosen}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="nothing ticked = the name and id columns"
                                           Style="{StaticResource CaptionText}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
                <TextBlock Text="{Binding AddNote}" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <Grid Grid.Row="3">
                <DataGrid x:Name="MatchGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                          SelectionMode="Extended">
                    <!-- Foreground DataTriggers used to live here, on DataGridRow,
                         keyed on Status the same way BulkRenameWindow's
                         NeedsName trigger colours a row's Background below.
                         Measured empirically (status-colour-vocabulary plan,
                         2026-08-08, Task 2 Step 1 — an off-screen render of
                         this window with a row per Status, reading the Note
                         cell's actual TextBlock.Foreground, not reasoned
                         about): for every one of ambiguous/suggested/already/
                         no_match/no_name the resolved brush was Theme.Text —
                         never the amber/subtle this style set. Styles.xaml's
                         DataGridCell style (its own Style.Triggers block)
                         always sets the CELL's own Foreground, and a Style
                         Setter always outranks a value the cell would
                         otherwise INHERIT from its row — so this trigger set
                         painted nothing, ever, since the day it shipped. It
                         is fully removed below; the working replacement is
                         each column's own ElementStyle (see NoteColumn),
                         same technique as BulkRenameWindow.xaml's "New name"
                         column and TriageWindow.xaml.cs's "Why" column. -->
                    <!-- Local RowStyle, BasedOn the shared GridRow style
                         (Theme/Styles.xaml) — GridRow carries the
                         Background="Transparent" Setter and the IsMouseOver→
                         Theme.RowHover trigger this window used to declare
                         itself; only the genuinely local ToolTip=Source
                         Setter is left here. -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource GridRow}">
                            <Setter Property="ToolTip" Value="{Binding Source}" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <!-- File: content-sized (Width="Auto"), capped in code
                             (MatchMergeWindow.xaml.cs, DataGridColumnCap) to a
                             share of this window's own declared Width rather
                             than a fixed pixel MaxWidth — a DataGridColumn
                             isn't part of the visual tree, so that cap can't
                             be expressed as a XAML binding here; see
                             DataGridColumnCap's own class doc. Capped rather
                             than made the filler: this is the SOURCE
                             filename — whatever a scanner or a person named
                             it, the least predictable string in the row —
                             while Becomes below is what the window exists to
                             let someone verify, so it gets the room instead. -->
                        <DataGridTextColumn x:Name="FileColumn" Header="File" Binding="{Binding File}"
                                            Width="Auto">
                            <!-- BasedOn GridCellTextSelectionAware (Theme/
                                 Styles.xaml), not plain GridCellText or the
                                 bare {x:Type TextBlock} style: this column has
                                 no status trigger of its own, so the shared
                                 style's default Foreground + trailing "let
                                 selection win" DataTrigger is the whole fix —
                                 see GridCellTextSelectionAware's own doc
                                 comment for the bug this closes (measured
                                 1.10:1 dark before it). -->
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextSelectionAware}">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding File}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- Becomes: the filler (Width="*", MinWidth="120" —
                             the same floor BulkRename/History's own star
                             columns use, so a narrow window clamps rather
                             than collapses it). It's the roster-matched
                             result a person reviews this window to confirm,
                             so it gets whatever width File and Note don't
                             need. -->
                        <DataGridTextColumn Header="Becomes" Binding="{Binding Becomes}"
                                            Width="*" MinWidth="120">
                            <!-- BasedOn GridCellTextSelectionAware — same reasoning as File above. -->
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextSelectionAware}">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Becomes}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- Note: content-sized and capped the same way as
                             File above. Was a fixed 240px regardless of what
                             it held; the status phrases it actually carries
                             (MatchMergeViewModel.Refresh, e.g. "no roster
                             match", "3 candidates — decide in Review
                             matches") are well under that, so this mostly
                             just stops reserving fixed space next to a short
                             one. -->
                        <DataGridTextColumn x:Name="NoteColumn" Header="Note" Binding="{Binding Note}"
                                            Width="Auto">
                            <!-- BasedOn plain GridCellText, NOT
                                 GridCellTextSelectionAware, for the shared
                                 Theme.Text default — this column's own status
                                 triggers below need to win over selection LAST
                                 (its own trailing DataTrigger below), and
                                 GridCellTextSelectionAware's copy of that same
                                 trigger would sit BELOW these status triggers
                                 in the BasedOn chain and always lose to them,
                                 see GridCellTextSelectionAware's own doc
                                 comment in Theme/Styles.xaml. -->
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Note}" />
                                    <Style.Triggers>
                                        <!-- status-colour-vocabulary plan, Task 2 Step 2:
                                             the working replacement for the dead RowStyle
                                             triggers above — an ElementStyle Setter on
                                             THIS TextBlock is what the DataGridCell style
                                             can't outrank, because there's no inheritance
                                             gap left to win. ambiguous/suggested/no_roster
                                             need a person's attention; already/no_match/
                                             no_name are facts, not problems; merge has no
                                             note today (Refresh's switch leaves it ""), so
                                             it gets no trigger here either. -->
                                        <DataTrigger Binding="{Binding Status}" Value="ambiguous">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource Theme.StatusAmber}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="suggested">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource Theme.StatusAmber}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="no_roster">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource Theme.StatusAmber}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="already">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource Theme.SubtleText}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="no_match">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource Theme.SubtleText}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="no_name">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource Theme.SubtleText}" />
                                        </DataTrigger>
                                        <!-- Let selection win (same trap as Task 1's Unlock file
                                             list, same fix): measured directly (status-colour-
                                             vocabulary plan Task 2, off-screen, selected ambiguous
                                             row) — without this override the amber/subtle Setters
                                             above stay in force even once the DataGridCell style
                                             flips its OWN Foreground to Theme.AccentText for
                                             IsSelected, because a Style trigger Setter on THIS
                                             TextBlock always outranks whatever the cell would
                                             otherwise hand it by inheritance (the very trap that
                                             made the old RowStyle triggers dead, now working
                                             correctly against us instead of for us). Measured:
                                             Theme.StatusAmber light on Theme.Accent light = 2.26:1,
                                             well under the 4.5:1 floor. Declared last so it
                                             overrides every status trigger above once selected. -->
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <Binding Path="IsSelected"
                                                         RelativeSource="{RelativeSource AncestorType=DataGridCell}" />
                                            </DataTrigger.Binding>
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource Theme.AccentText}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Style="{StaticResource EmptyStateText}"
                           IsHitTestVisible="False"
                           Text="1)  Load the roster above (CSV or Excel)    2)  Add or drag PDFs anywhere on this window    3)  Merge the matches; Review the rest">
                    <TextBlock.Visibility>
                        <Binding Path="Rows.Count" Converter="{StaticResource ZeroToVis}" />
                    </TextBlock.Visibility>
                </TextBlock>
            </Grid>

            <TextBlock Grid.Row="4" Text="{Binding BucketsLine}" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,6,0,0" />
        </Grid>
    </DockPanel>
</Window>
