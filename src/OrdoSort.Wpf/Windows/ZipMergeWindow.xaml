<Window x:Class="OrdoSort.Wpf.Windows.ZipMergeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OrdoSort.Wpf.ViewModels"
        Title="OrdoSort — Merge PDFs from zip" Width="700" Height="520" MinWidth="580" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" AllowDrop="True"
        DragOver="OnDragOver" Drop="OnDrop"
        Style="{StaticResource {x:Type Window}}">
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Width="96" IsCancel="True" />
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding MergeCommand}"
                        Style="{StaticResource PrimaryButton}" MinWidth="120" Margin="0,0,8,0"
                        AutomationProperties.Name="{Binding MergeButtonText}">
                    <TextBlock Text="{Binding MergeButtonText}" Style="{StaticResource PrimaryButtonLabel}" />
                </Button>
                <!-- The batch's own running verdict — "Merging 2 of 5…" while
                     under way, then "3 merged · 1 had no PDFs · 1 failed" —
                     gets StatusText, the same style every other batch tool
                     (Unlock's Summary, PageCounts' TotalLine) uses for its
                     own result line. -->
                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center"
                           Style="{StaticResource StatusText}" MaxWidth="360" />
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Add zips…" Click="OnAddFiles" Margin="0,0,6,0" />
                    <Button Content="Remove selected" Click="OnRemoveSelected" Margin="0,0,6,0" />
                    <Button Content="Clear" Command="{Binding ClearCommand}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding AddNote}" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <DataGrid x:Name="ZipsGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                          SelectionMode="Extended">
                    <!-- Local RowStyle, same shape as PageCounts/BulkRename/
                         MatchMerge/FilenameList's own — Theme.RowHover so the
                         hover tint stays consistent app-wide, and matters
                         here because the Result column can show StatusAmber
                         below. -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="ToolTip" Value="{Binding Path}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource Theme.RowHover}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <!-- Zip: the filler (Width="*") — the source
                             filename, not the least predictable thing on this
                             row (Result carries that), so it gets whatever
                             width Result doesn't need. -->
                        <DataGridTextColumn Header="Zip" Binding="{Binding FileName}" Width="*">
                            <!-- BasedOn GridCellTextSelectionAware (Theme/
                                 Styles.xaml), not plain GridCellText or the
                                 bare {x:Type TextBlock} style: no status trigger
                                 of its own here, so the shared style's default
                                 Foreground + trailing "let selection win"
                                 DataTrigger is the whole fix — same shape as
                                 PageCountsWindow's File column; see
                                 GridCellTextSelectionAware's own doc comment.
                                 Measured directly (off-screen, before this fix,
                                 when this column was plain GridCellText):
                                 Theme.Text on Theme.Accent ranged 1.26:1-2.14:1
                                 across every scheme — this window shipped with
                                 the exact selection-contrast bug
                                 GridCellTextSelectionAware exists to prevent,
                                 just never switched to it. -->
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextSelectionAware}">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Path}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- Result: content-sized. NoPdfs is amber (a zip
                             with zero PDFs inside isn't a failure the way an
                             unreadable one is — ZipRow's own doc comment —
                             so it's "needs attention," not an error). Error
                             is Theme.StatusRed: a genuine merge failure, not
                             the same colour as NoPdfs' merely-informational
                             "nothing failed, there was just nothing to
                             merge" note — UnlockWindow.xaml's Unreadable
                             DataTrigger is the reference for this same
                             red-vs-amber split (status-colour-vocabulary
                             plan, 2026-08-08: amber must never mean a merely
                             informational fact). Driven off StatusKind (an
                             enum, so {x:Static vm:ZipRowStatus.…} rather
                             than a plain Value string — same idiom
                             UnlockWindow.xaml's ReadinessStatus triggers use).
                             Same recipe as PageCountsWindow.xaml's Note
                             column otherwise: GridCellText's shared default
                             PLUS its own trailing "let selection win"
                             DataTrigger, because GridCellText's own copy of
                             that trigger doesn't reliably win once this style
                             adds triggers of its own — see GridCellText's and
                             PageCountsWindow's Note column's doc comments for
                             the measured contrast numbers that recipe exists
                             to fix. -->
                        <DataGridTextColumn x:Name="ResultColumn" Header="Result" Binding="{Binding Note}"
                                            Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Note}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusKind}"
                                                     Value="{x:Static vm:ZipRowStatus.Error}">
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.StatusRed}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}"
                                                     Value="{x:Static vm:ZipRowStatus.NoPdfs}">
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.StatusAmber}" />
                                        </DataTrigger>
                                        <!-- Declared last so it overrides both
                                             triggers above once selected — same
                                             measured trap and same fix as
                                             PageCountsWindow.xaml's Note column. -->
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <Binding Path="IsSelected"
                                                         RelativeSource="{RelativeSource AncestorType=DataGridCell}" />
                                            </DataTrigger.Binding>
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource Theme.AccentText}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Drag zips anywhere on this window, or press Add zips…"
                           Style="{StaticResource SubtleText}" Margin="10,36,10,10"
                           IsHitTestVisible="False">
                    <TextBlock.Visibility>
                        <Binding Path="Rows.Count" Converter="{StaticResource ZeroToVis}" />
                    </TextBlock.Visibility>
                </TextBlock>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
