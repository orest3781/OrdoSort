<Window x:Class="OrdoSort.Wpf.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OrdoSort.Wpf.ViewModels"
        xmlns:theme="clr-namespace:OrdoSort.Wpf.Theme"
        Title="OrdoSort — Settings" Width="880" Height="820" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource {x:Type Window}}">
    <Window.Resources>
        <!-- KvpValueTemplate lives in Theme/Styles.xaml now (a real,
             app-level ResourceDictionary, not this window's own private
             Resources) so the regression test suite can resolve the SAME
             production template by key instead of a hand-copied stand-in —
             see Styles.xaml's own comment at its declaration for why the
             local Foreground binding it carries is load-bearing. -->
        <!-- Per-field live note: collapsed while empty, subtle by default,
             amber ONLY when it needs attention.
             2026-08-02 audit M3 — this used to derive from StatusText, so
             every note was amber, including purely informational ones
             ("relative — resolved beside the config file", "12 entries",
             "a new database will be created here"). Amber means needs-attention
             everywhere else in this app; spending it on facts spends it on
             nothing.
             The severity rides on Tag so ONE shared style can carry the
             trigger: each note binds its own ...NoteNeedsAttention flag there
             (the view model decides, per branch, which of its messages is a
             problem — see SettingsViewModel.FieldNote). Deliberately NOT a
             DataTrigger matching the note TEXT: two of the four problem
             messages are interpolated ("folder doesn't exist: {path}", a
             ConfigException message) and so cannot be matched by literal, and
             a XAML copy of a C# string is the decaying-premise shape this
             codebase has already been bitten by.
             The amber Setter lives in Style.Triggers, not as a local
             Foreground on each TextBlock: a Style TRIGGER outranks the
             BasedOn Setter, whereas a local value would outrank BOTH and
             pin one colour forever. TextWrapping is restated because it came
             from StatusText, which is no longer the base.
             Tag is typed `object`, so a DataTrigger comparing it to the
             literal Value="True" is relying on WPF converting one side at
             match time rather than on a compile-time type. That it really
             fires is MEASURED, not assumed: against a build with this trigger
             removed, CopyAndTerminologyTests' informational cases go red while
             its amber cases stay green, and with the trigger present the amber
             cases resolve Theme.StatusAmber — which this style has no other
             source for.
             Margin (spacing-rhythm audit B2, 2026-08-09): used to be
             "130,-6,0,10" — a magic left-indent hard-coded to match the
             General/Data files tabs' OLD fixed 130px label column, plus a
             negative top pull-up faking the gap to the field above. Both
             numbers broke the moment those tabs' label columns became
             Auto-sized via SharedSizeGroup="LabelCol" (a 130px indent no
             longer lines up with anything once the column it was copying
             can be narrower or wider per tab). Every call site now places
             this TextBlock itself at Grid.Column="1" in a row added below
             its field's TextBox, inside the SAME FieldRow Grid — so
             horizontal alignment comes from the grid column, same as the
             TextBox above it, instead of a copied pixel count. "0,4,0,0"
             replaces the old "-6" top / caller's "10" bottom: the FieldRow
             style's own Margin="0,0,0,10" already runs OUTSIDE this whole
             two-row Grid (same as before), so it still supplies the trailing
             gap before the next field; 4 is the on-rhythm value that nets to
             the same ~4px field-to-note gap the old -6/10 pairing produced. -->
        <Style x:Key="NoteText" TargetType="TextBlock" BasedOn="{StaticResource SubtleText}">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Theme.StatusAmber}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Same side-nav chrome as the base TabItem style (Theme/Styles.xaml)
             — BasedOn it directly rather than duplicating its whole
             ControlTemplate. The base template already carries an
             Underline Border, Collapsed by default (so plain TabItems
             elsewhere are untouched); this style just opts in via the
             theme:TabItemOptions attached property (Theme/TabItemOptions.cs)
             so the base template's own MultiTrigger reveals and colours it
             (Theme.AccentBronze) once a SectionTab is selected — the left
             accent stripe still marks "this is the open section" (inherited
             from the base template unchanged), the bottom bronze line is
             this window's added selected-state signal. -->
        <Style x:Key="SectionTab" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="theme:TabItemOptions.ShowSelectedUnderline" Value="True" />
        </Style>
        <!-- theme picker cards: a mini mock of each palette beats three lines
             of radio text. Still a RadioButton underneath — keyboard, group
             semantics, and screen-reader name all intact. -->
        <Style x:Key="ThemeCard" TargetType="RadioButton">
            <Setter Property="GroupName" Value="ThemeMode" />
            <Setter Property="Cursor" Value="Hand" />
            <!-- Bottom margin added alongside the scheme-picker ItemsControl
                 (WrapPanel): with 7 registry schemes the cards wrap across
                 multiple rows, and a right-only margin left wrapped rows
                 touching with no vertical gap. -->
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
            <!-- Task 8 (focus-ring coverage): this Style has no BasedOn back
                 to the implicit {x:Type RadioButton} style Theme/Styles.xaml
                 just gave a FocusVisualStyle Setter — an explicit x:Key
                 style entirely bypasses implicit-by-type lookup, so that
                 Setter would silently never reach these theme-card
                 RadioButtons (the Auto card below plus one per
                 SchemeOptions entry) without repeating it here (the exact
                 "named style suppresses the base Style's Setters" shape
                 flagged for this task). -->
            <Setter Property="FocusVisualStyle" Value="{StaticResource BronzeFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Sel" BorderThickness="2" CornerRadius="4"
                                BorderBrush="Transparent" Background="Transparent" Padding="4">
                            <StackPanel>
                                <ContentPresenter />
                                <TextBlock x:Name="Lbl" Text="{TemplateBinding Tag}"
                                           HorizontalAlignment="Center" Margin="0,6,0,0"
                                           Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Sel" Property="BorderBrush"
                                        Value="{DynamicResource Theme.Border}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Sel" Property="BorderBrush"
                                        Value="{DynamicResource Theme.Accent}" />
                                <Setter TargetName="Lbl" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 22px + 3px gap keeps all 12 swatches on ONE row in the detail
             columns (12 × 25 = 300px); at 24 + 4 they wrapped and the second
             row clipped against the editor's bottom edge -->
        <Style x:Key="Swatch" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="0,0,3,3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Click="OnOk" Style="{StaticResource PrimaryButton}"
                    Width="96" IsDefault="True" Margin="0,0,8,0"
                    AutomationProperties.Name="OK">
                <TextBlock Text="OK" Style="{StaticResource PrimaryButtonLabel}" />
            </Button>
            <Button Content="Cancel" Width="96" IsCancel="True" />
        </StackPanel>

        <TabControl TabStripPlacement="Left" Background="Transparent" BorderThickness="0"
                    ItemContainerStyle="{StaticResource SectionTab}">

            <!-- ============================================== General -->
            <!-- Task 8: access keys on all seven tab headers below — the shared
                 TabItem control template (Theme/Styles.xaml; this window's
                 own SectionTab is BasedOn it, not a second copy) already
                 sets RecognizesAccessKey="True" on the header
                 ContentPresenter, so an "_" marker here is all that's
                 needed. Checked for
                 collisions before assigning: General/Filing/Destinations/
                 Monitored folders/Appearance/Data files start with
                 G/F/D/M/A/D — one collision, on D — so Data files uses a
                 non-initial letter instead ("T" from "Da_ta") to keep the
                 original six unique: G, F, D, M, A, T.

                 Task 9 (2026-08-02 audit finding I5) renamed the fourth tab
                 from "Dashboard" to "Monitored folders", which retired the
                 old "B" mnemonic (it came from Dash_board, picked only
                 because "Dashboard" started with a third D). "Monitored
                 folders" starts with M, which nothing else here claims, so
                 the mnemonic is now the initial letter like four of the other
                 five. This window has no OTHER access-keyed control to collide
                 with (grepped: zero pre-existing "_X" markers anywhere else in
                 this file). Separately, MainWindow.xaml's own File/Tools menu
                 mnemonics (the audit's "complete and collision-free" finding)
                 live in a different Window entirely, so they cannot collide
                 with these regardless of AccessKeyManager scoping — verified
                 by inspection, not touched here.

                 Phase 3 task 3.2 split the old "Monitored folders" tab: that
                 tab keeps only the folder master/detail, and the Alerts +
                 Polling regions it used to carry moved to a new seventh tab,
                 inserted right after it. Its initial letter, A, is already
                 Appearance's; the other candidate initial, P (Polling), is
                 free, so the header is "Alerts &amp; _Polling" — the mnemonic
                 reads on its second word, same shape as Data files reading on
                 its second syllable. Checked against all seven live headers
                 (G, F, D, M, A, T, P) — still zero collisions.

                 The AutomationProperties.Name beside each Header is the
                 screen-reader label, pinned explicitly so it can never
                 inherit the "_" marker from the header literal. Measured on
                 this WPF, one run, same window: the peer TabControl actually
                 publishes to the UIA tree (a TabItemAutomationPeer) already
                 ran the header through AccessText.RemoveAccessKeyMarker and
                 reported "General" — but the TabItem's own wrapper peer
                 (what CreatePeerForElement hands back) reported "_General"
                 verbatim. An explicit Name makes BOTH report the plain
                 label, so the announced name no longer depends on an
                 undocumented strip inside one peer class. Asserted three
                 ways in SettingsKeyboardAccessTests. -->
            <TabItem Header="_General" AutomationProperties.Name="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <!-- IsSharedSizeScope: this tab's own FieldRow label
                         columns (spacing-rhythm audit B2, mirrors
                         LabelMakerWindow.xaml's SharedSizeGroup="LabelCol"
                         pattern) — scoped per-tab, not shared with the other
                         five tabs' own LabelCol groups, since each TabItem's
                         content is swapped wholesale and there is no reason
                         for e.g. "History database:" to force "App font:"
                         wider on a different tab. -->
                    <StackPanel Margin="16,8" Grid.IsSharedSizeScope="True">
                        <TextBlock Text="Folders" Style="{StaticResource SectionText}" Margin="0,0,0,10" />

                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Inbox:" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Text="{Binding Inbox, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="2" Content="Browse…" Margin="6,0,0,0"
                                    Command="{Binding BrowseInboxCommand}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InboxNote}"
                                       Tag="{Binding InboxNoteNeedsAttention}"
                                       Style="{StaticResource NoteText}" />
                        </Grid>

                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Set-aside folder:" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Text="{Binding Deferred, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="2" Content="Browse…" Margin="6,0,0,0"
                                    Command="{Binding BrowseDeferredCommand}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DeferredNote}"
                                       Tag="{Binding DeferredNoteNeedsAttention}"
                                       Style="{StaticResource NoteText}" />
                        </Grid>

                        <TextBlock Text="Files" Style="{StaticResource SectionText}" Margin="0,10,0,10" />

                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Names list:" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Text="{Binding NamesFile, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="2" Content="Browse…" Margin="6,0,0,0"
                                    Command="{Binding BrowseNamesFileCommand}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NamesFileNote}"
                                       Tag="{Binding NamesFileNoteNeedsAttention}"
                                       Style="{StaticResource NoteText}" />
                        </Grid>

                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="History database:" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Text="{Binding HistoryDb, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="2" Content="Browse…" Margin="6,0,0,0"
                                    Command="{Binding BrowseHistoryDbCommand}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HistoryDbNote}"
                                       Tag="{Binding HistoryDbNoteNeedsAttention}"
                                       Style="{StaticResource NoteText}" />
                        </Grid>
                        <DockPanel Margin="0,2,0,0">
                            <Button DockPanel.Dock="Right" Content="Open backups folder"
                                    Command="{Binding OpenBackupsCommand}" Margin="8,0,0,0"
                                    VerticalAlignment="Top" />
                            <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap"
                                       Text="A daily backup of the history database is kept in a 'backups' folder beside it." />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================== Filing -->
            <TabItem Header="_Filing" AutomationProperties.Name="Filing">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <!-- IsSharedSizeScope: see the General tab's identical
                         comment above — same per-tab LabelCol pattern,
                         scoped independently of the other five tabs. -->
                    <StackPanel Margin="16,8" Grid.IsSharedSizeScope="True">
                        <TextBlock Text="Naming" Style="{StaticResource SectionText}" Margin="0,0,0,10" />
                        <!-- before → after beats prose: name each mode by its
                             transformation, not by an abstract label -->
                        <RadioButton GroupName="NamingMode" IsChecked="{Binding ModeInsert}"
                                     Content='Insert at the "--"   ·   20240115--12345.pdf  →  20240115-Smith John-12345.pdf' />
                        <RadioButton GroupName="NamingMode" IsChecked="{Binding ModeReplace}"
                                     Content='Full replace   ·   20240115--12345.pdf  →  Smith John.pdf' />
                        <RadioButton GroupName="NamingMode" IsChecked="{Binding ModePrefix}"
                                     Content='Prefix   ·   scan001.pdf  →  Smith John-scan001.pdf' />
                        <RadioButton GroupName="NamingMode" IsChecked="{Binding ModeAppend}"
                                     Content='Append   ·   scan001.pdf  →  scan001-Smith John.pdf' />
                        <!-- Margin left at 22, off-rhythm: it aligns this
                             caption under the RadioButtons' own text (native
                             WPF RadioButton chrome, no code-level indent
                             constant to confirm whether 20 or 24 would still
                             match) — spacing-rhythm audit B1, left as-is
                             rather than guess. -->
                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                   Margin="22,2,0,0"
                                   Text='Insert mode picks up only PDFs with "--" in the name; every other mode picks up every PDF. Anything else shows as "ignored" on the Ready screen.' />
                        <!-- one live example tying mode + UPPERCASE + separator together -->
                        <Border Background="{DynamicResource Theme.Surface}"
                                BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
                                CornerRadius="4" Padding="10,7" Margin="0,8,0,0">
                            <TextBlock Text="{Binding FilingExample}" TextWrapping="Wrap"
                                       FontWeight="SemiBold" />
                        </Border>

                        <Grid Style="{StaticResource FieldRow}" Margin="0,14,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Process order:" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{x:Static vm:SettingsViewModel.SortChoices}"
                                      SelectedValuePath="Key"
                                      SelectedValue="{Binding SortKey}"
                                      ItemTemplate="{StaticResource KvpValueTemplate}" />
                        </Grid>

                        <TextBlock Text="Typing" Style="{StaticResource SectionText}" Margin="0,10,0,10" />
                        <CheckBox Content="UPPERCASE names as they're typed"
                                  IsChecked="{Binding UppercaseNames}" />
                        <TextBlock Text="Enter files to:" Margin="0,4,0,2" />
                        <RadioButton GroupName="EnterMode"
                                     Content="the last-used destination (starts at the first)"
                                     IsChecked="{Binding EnterCommits}" Margin="12,0,0,2" />
                        <RadioButton GroupName="EnterMode"
                                     Content="always the first destination"
                                     IsChecked="{Binding EnterCommits, Converter={StaticResource InvertBool}}"
                                     Margin="12,0,0,0" />
                        <Grid Style="{StaticResource FieldRow}" Margin="0,8,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Word separator:" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Text="{Binding WordSeparator, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="3" />
                            <TextBlock Grid.Column="2" Style="{StaticResource SubtleText}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       Text="typed spaces become this (blank = keep spaces)" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================== Routes -->
            <TabItem Header="_Destinations" AutomationProperties.Name="Destinations">
                <!-- IsSharedSizeScope: see the General tab's identical
                     comment above — same per-tab LabelCol pattern. Only the
                     detail panel (column 1 below) has FieldRows, but the
                     scope lives on this whole tab root, same as the model
                     window (LabelMakerWindow.xaml also scopes above its
                     client list, not just around the field grids). -->
                <Grid Margin="16,8" Grid.IsSharedSizeScope="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button Content="Add" Command="{Binding AddRouteCommand}" MinWidth="48" Margin="0,0,4,4" />
                            <Button Content="Duplicate" Command="{Binding DuplicateRouteCommand}" Margin="0,0,4,4"
                                    ToolTip="A copy of the selected destination to tweak (hotkey left blank)" />
                            <Button Content="Remove" Command="{Binding RemoveRouteCommand}" Margin="0,0,4,4" />
                            <Button Content="↑" Command="{Binding RouteUpCommand}" MinWidth="34" Margin="0,0,4,4"
                                    ToolTip="Move up — buttons show in this order (or drag rows)"
                                    AutomationProperties.Name="Move destination up" />
                            <Button Content="↓" Command="{Binding RouteDownCommand}" MinWidth="34" Margin="0,0,0,4"
                                    ToolTip="Move down — buttons show in this order (or drag rows)"
                                    AutomationProperties.Name="Move destination down" />
                        </WrapPanel>
                        <Grid>
                            <ListBox x:Name="RouteList" ItemsSource="{Binding Routes}"
                                     SelectedItem="{Binding SelectedRoute}" AllowDrop="True"
                                     PreviewMouseLeftButtonDown="List_DragArm"
                                     PreviewMouseMove="List_DragMove"
                                     Drop="List_Drop" DragOver="List_DragOver">
                                <!-- BasedOn is required: setting ItemContainerStyle
                                     at all REPLACES implicit-by-type lookup for
                                     this ListBox's containers entirely (the same
                                     "explicit wiring suppresses the fallback"
                                     shape Task 1 found for Calendar's child
                                     styles) — without it, this ListBox would keep
                                     using the plain WPF default ListBoxItem no
                                     matter what Styles.xaml says, regardless of
                                     this override only adding one more Setter. -->
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <!-- Label gets a LOCAL Foreground bound back to
                                     the generated ListBoxItem — see
                                     Styles.xaml's ListBoxItem style comment: an
                                     ItemTemplate's LOCAL ContentTemplate
                                     assignment outranks that style's own
                                     ContentTemplate Setter, so only a call-site
                                     fix reaches it. GestureText is NOT given
                                     that same blanket binding: it also carries
                                     an inline Style BasedOn CaptionText for its
                                     de-emphasised at-rest look, and a LOCAL
                                     Foreground on the SAME TextBlock as that
                                     Style's Setter would outrank it, silently
                                     pinning GestureText to full-emphasis
                                     Theme.Text whenever the row is unselected
                                     (found in the 2026-08-02 theme-coverage
                                     final review — the same "LOCAL value beats
                                     Style Setter" trap as ComboBoxItem's
                                     ItemTemplate case elsewhere in this app,
                                     just discovered here inverted, since the
                                     LOCAL value was the fix that time). Fixed
                                     with a conditional Style instead: BasedOn
                                     CaptionText (small AND de-emphasised) so
                                     its Setter still applies at rest, with a
                                     DataTrigger that only overrides Foreground
                                     to Theme.AccentText while the row is
                                     selected. -->
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                                       Fill="{Binding Color, Converter={StaticResource ColorStringToBrush}}"
                                                       Stroke="{DynamicResource Theme.Border}" StrokeThickness="1" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding GestureText}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected,
                                                                RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Theme.AccentText}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{Binding Foreground,
                                                           RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="No destination buttons yet — press Add."
                                       Style="{StaticResource SubtleText}" TextWrapping="Wrap"
                                       Margin="10" IsHitTestVisible="False">
                                <TextBlock.Visibility>
                                    <Binding Path="Routes.Count" Converter="{StaticResource ZeroToVis}" />
                                </TextBlock.Visibility>
                            </TextBlock>
                        </Grid>
                    </DockPanel>

                    <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedRoute}">
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Grid Style="{StaticResource FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Button label:" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Style="{StaticResource FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Destinations alignment fast-follow (spacing-rhythm
                                     audit B2 mirror): Row 1 below holds the Problem
                                     StackPanel, which used to sit OUTSIDE this Grid
                                     with a magic Margin="110,..." faking alignment
                                     under Folder's own TextBox — same trap the
                                     General tab's NoteText sites already had fixed.
                                     ColumnSpan="3" (columns 1-3) so it can still reach
                                     as far right as the Open button, same effective
                                     width the old margin-only placement had. -->
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Folder:" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2" Content="Browse…" Margin="6,0,0,0"
                                        Command="{Binding DataContext.BrowseRoutePathCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Button Grid.Column="3" Content="Open" Margin="6,0,0,0"
                                        ToolTip="Show this folder in Explorer"
                                        Command="{Binding DataContext.OpenRouteFolderCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Problem}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{Binding Problem}" Style="{StaticResource StatusText}"
                                               VerticalAlignment="Center" />
                                    <Button Content="Create it" Margin="8,0,0,0" Padding="8,3"
                                            Command="{Binding DataContext.CreateRouteFolderCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Problem}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- Destinations alignment fast-follow (spacing-rhythm
                                     audit B2 mirror): Row 1 below holds HotkeyNote,
                                     which used to sit OUTSIDE this Grid with a magic
                                     Margin="110,..." faking alignment under the
                                     hotkey box — same trap the General tab's NoteText
                                     sites already had fixed. ColumnSpan="2" (the
                                     hotkey box's own column plus the caption's star
                                     column) so it keeps the same wrapping width the
                                     old margin-only placement had. -->
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Hotkey:" Style="{StaticResource FieldLabel}" />
                                <Grid Grid.Column="1">
                                    <TextBox Text="{Binding Hotkey, UpdateSourceTrigger=PropertyChanged}"
                                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                             AutomationProperties.Name="Hotkey — press keys to set" />
                                    <!-- ghost text while blank: the automatic
                                         Ctrl+1-9 this route gets from its
                                         position in the list -->
                                    <TextBlock Text="{Binding HotkeyPlaceholder}"
                                               Style="{StaticResource SubtleText}"
                                               VerticalAlignment="Center" Margin="7,0,0,0"
                                               IsHitTestVisible="False" />
                                </Grid>
                                <TextBlock Grid.Column="2" Style="{StaticResource SubtleText}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           TextWrapping="Wrap"
                                           Text="press the keys · Backspace clears" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                           Text="{Binding HotkeyNote}" Style="{StaticResource StatusText}"
                                           Visibility="{Binding HasHotkeyNote, Converter={StaticResource BoolToVis}}" />
                            </Grid>

                            <Grid Style="{StaticResource FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Filename suffix:" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding AppendSuffix}" />
                                <CheckBox Grid.Column="2" Content="append it" Margin="8,0,0,0"
                                          VerticalAlignment="Center" IsChecked="{Binding AppendSuffix}" />
                            </Grid>

                            <Grid Style="{StaticResource FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Naming mode:" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{x:Static vm:SettingsViewModel.ModeChoices}"
                                          SelectedValuePath="Key"
                                          SelectedValue="{Binding NamingMode}"
                                          ItemTemplate="{StaticResource KvpValueTemplate}"
                                          ToolTip="Overrides the Filing tab's naming mode for this destination only" />
                            </Grid>

                            <Grid Style="{StaticResource FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="160" />
                                    <!-- star column added for the swatch ItemsControl
                                         below (Row 1) — the 160 column alone is too
                                         narrow to keep all 12 swatches on one row (see
                                         the Swatch style's own comment, Window.Resources
                                         above: 12 × 25px needs ~300px), same reason
                                         Folder/Hotkey's own value columns already had
                                         one to span into. -->
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- Destinations alignment fast-follow (spacing-rhythm
                                     audit B2 mirror): Row 1 below holds the swatch
                                     ItemsControl, which used to sit OUTSIDE this Grid
                                     with a magic Margin="110,..." faking alignment
                                     under Button color's own TextBox — same trap the
                                     General tab's NoteText sites already had fixed. -->
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Button color:" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" />
                                <ItemsControl Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                              ItemsSource="{x:Static vm:SettingsViewModel.SwatchColors}"
                                              Margin="0,2,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource Swatch}" Click="OnRouteSwatch"
                                                    Tag="{Binding}" ToolTip="{Binding}"
                                                    AutomationProperties.Name="{Binding}"
                                                    Foreground="{Binding Converter={StaticResource ColorStringToForeBrush}}">
                                                <Button.Background>
                                                    <SolidColorBrush Color="{Binding}" />
                                                </Button.Background>
                                                <!-- ✓ marks the swatch matching the current color -->
                                                <TextBlock FontWeight="Bold">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource SwatchCheck}">
                                                            <Binding />
                                                            <Binding Path="DataContext.SelectedRoute.Color"
                                                                     RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <!-- the button exactly as the Processing screen
                                 will render it: color, contrast-picked text,
                                 label · suffix · hotkey -->
                            <TextBlock Text="Preview:" Style="{StaticResource FieldLabel}"
                                       Margin="0,14,0,4" />
                            <Border Height="44" CornerRadius="4"
                                    Background="{Binding PreviewBack, Converter={StaticResource RgbToBrush}}">
                                <TextBlock Text="{Binding PreviewLabel}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{Binding PreviewFore, Converter={StaticResource RgbToBrush}}" />
                            </Border>
                            <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,4,0,0">
                                <TextBlock.Text>
                                    <Binding Path="DataContext.RouteFilingExample"
                                             RelativeSource="{RelativeSource AncestorType=Window}"
                                             StringFormat="files as: {0}" />
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ===================================== Monitored folders -->
            <!-- Was "Dashboard" until Task 9 (audit finding I5): the tab, its
                 own section header below and the Data files tab's label for
                 the same file all named one feature three-quarters of the way
                 differently. "Monitored folders" wins because it is what the
                 rest of the app already says — the section header here, the
                 Data files label, MainWindow's tile-visibility tooltip, and
                 Config.MonitorTitle's own default (the heading a user sees on
                 the Ready screen). "Dashboard" appeared in exactly two
                 user-visible places, both on this tab, and nowhere else in
                 the product; it stays only as an internal word (Ready-screen
                 code, DashboardTests). Tab header + first section header
                 matching is the pattern the Data files tab already uses. -->
            <TabItem Header="_Monitored folders" AutomationProperties.Name="Monitored folders">
                <!-- IsSharedSizeScope: see the General tab's identical
                     comment above — same per-tab LabelCol pattern. -->
                <!-- Phase 3 task 3.2: this tab used to also carry the Alerts
                     and Polling regions below a third (Auto) row; both moved
                     to their own "Alerts & polling" tab, so the master/detail
                     Grid below — already the tab's only "*" row — is now the
                     only row left and gets the whole tab to itself. -->
                <Grid Margin="16,8" Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Monitored folders" Style="{StaticResource SectionText}" Margin="0,0,0,10" />
                    <!-- the folder editor takes all remaining height — a long
                         folder list gets the space, not a cramped fixed strip -->
                    <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                    <Button Content="Add folder" Command="{Binding AddWatchCommand}" Margin="0,0,4,4" />
                                    <Button Content="Add section" Click="OnAddSectionClick" Margin="0,0,4,4" />
                                    <Button Content="Remove" Command="{Binding RemoveWatchCommand}" Margin="0,0,4,4" />
                                    <Button Content="↑" Command="{Binding WatchUpCommand}" MinWidth="34" Margin="0,0,4,4"
                                            ToolTip="Move up — tiles show in this order (or drag rows)"
                                            AutomationProperties.Name="Move folder up" />
                                    <Button Content="↓" Command="{Binding WatchDownCommand}" MinWidth="34" Margin="0,0,0,4"
                                            ToolTip="Move down — tiles show in this order (or drag rows)"
                                            AutomationProperties.Name="Move folder down" />
                                </WrapPanel>
                                <ListBox x:Name="WatchList" ItemsSource="{Binding WatchRows}"
                                         SelectedItem="{Binding SelectedWatchRow}" AllowDrop="True"
                                         PreviewMouseLeftButtonDown="List_DragArm"
                                         PreviewMouseMove="List_DragMove"
                                         Drop="List_Drop" DragOver="List_DragOver">
                                    <ListBox.Resources>
                                        <DataTemplate DataType="{x:Type vm:WatchSectionVm}">
                                            <Grid Margin="0,6,0,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <!-- LOCAL Foreground bound back to the
                                                         generated ListBoxItem: without it this
                                                         TextBlock resolves the APPLICATION-level
                                                         implicit TextBlock style (Theme.Text)
                                                         rather than inheriting the container's
                                                         selected Theme.AccentText — a Style Setter
                                                         outranking inheritance, same as every other
                                                         row label in this app.

                                                         NOTE (corrected, Task 8b 2026-08-03): these
                                                         templates are implicit DataType templates in
                                                         WatchList's own <ListBox.Resources>, which
                                                         is NOT a ContentTemplate assignment of any
                                                         kind — local or otherwise. The comment that
                                                         used to sit here claimed the opposite, and
                                                         that wrong premise is what hid the fact that
                                                         Styles.xaml's blanket ContentTemplate Setter
                                                         suppressed these templates entirely (a
                                                         ContentPresenter only does DataType lookup
                                                         when ContentTemplate is null). See
                                                         PlainStringOnlyTemplateSelector. -->
                                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                               Foreground="{Binding Foreground,
                                                                   RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                                    <!-- Defensive fix (2026-08-02 theme-coverage
                                                         final review, Finding 2): a plain-string
                                                         Button.Content auto-wraps into a TextBlock
                                                         that resolves the APPLICATION-level
                                                         implicit TextBlock style (Theme.Text)
                                                         instead of inheriting this Button's own
                                                         Foreground — the same "Style Setter
                                                         outranks inheritance" trap as
                                                         ComboBoxItem/PrimaryButton/ChipButton
                                                         elsewhere in this app. An explicit
                                                         TextBlock with the sibling Header label's
                                                         own LOCAL Foreground binding sidesteps the
                                                         auto-wrap entirely, matching Header's
                                                         unselected-Theme.Text/selected-
                                                         Theme.AccentText behaviour exactly.
                                                         Currently UNREACHABLE:
                                                         SettingsViewModel.SelectedWatchRow rejects
                                                         header-row selection outright, so this
                                                         row's ListBoxItem never actually reports
                                                         IsSelected=True — see that property's own
                                                         doc comment. Fixed anyway, cheaply, so a
                                                         future relaxation of that guard doesn't
                                                         silently reintroduce the ComboBoxItem-style
                                                         1.27-1.35:1 contrast failure here. -->
                                                    <Button Margin="6,0,0,0" Padding="3,0"
                                                            Background="Transparent" BorderThickness="0"
                                                            Click="OnSectionRenameClick"
                                                            ToolTip="Rename this section — updates every folder in it"
                                                            AutomationProperties.Name="{Binding Header, StringFormat=Rename section {0}}">
                                                        <TextBlock Text="✎"
                                                                   Foreground="{Binding Foreground,
                                                                       RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                                    </Button>
                                                    <Button Margin="2,0,0,0" Padding="3,0"
                                                            Background="Transparent" BorderThickness="0"
                                                            Click="OnSectionAddFolderClick"
                                                            ToolTip="Add a folder to this section"
                                                            AutomationProperties.Name="{Binding Header, StringFormat=Add folder to section {0}}">
                                                        <TextBlock Text="＋"
                                                                   Foreground="{Binding Foreground,
                                                                       RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                                    </Button>
                                                </StackPanel>
                                                <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                                         LostFocus="OnSectionEditLostFocus"
                                                         PreviewKeyDown="OnSectionEditKeyDown"
                                                         AutomationProperties.Name="{Binding Header, StringFormat=Section name {0}}">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </Grid>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type vm:WatchEditVm}">
                                            <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                                <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                                           Fill="{Binding Color, Converter={StaticResource ColorStringToBrush}}"
                                                           Stroke="{DynamicResource Theme.Border}" StrokeThickness="1" />
                                                <!-- LOCAL Foreground bound back to the generated
                                                     ListBoxItem — same reason, and the same
                                                     Task-8b correction, as the section header's
                                                     label above: this template is an implicit
                                                     DataType template in WatchList's own
                                                     <ListBox.Resources>, NOT a local
                                                     ContentTemplate, so it is reached (and was
                                                     suppressed) by Styles.xaml's ListBoxItem
                                                     style rather than outranking it. -->
                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                                           Foreground="{Binding Foreground,
                                                               RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.Resources>
                                </ListBox>
                            </DockPanel>
                            <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                              <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                              </Grid.RowDefinitions>
                              <StackPanel DataContext="{Binding SelectedWatch}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid Style="{StaticResource FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Label:" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Column="1" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="2" Text="Section:" Style="{StaticResource FieldLabel}" Margin="8,0,10,0" />
                                    <!-- IsTextSearchEnabled=False: an editable ComboBox's built-in
                                         text search otherwise (a) auto-completes a typed prefix into
                                         a full matching choice mid-keystroke, hijacking what was typed,
                                         and (b) clears Text to "" whenever ItemsSource changes and the
                                         current Text isn't found among the (freshly recomputed)
                                         SectionChoices, which happens on every folder-selection swap,
                                         silently blanking the previously selected folder's Section.
                                         Proven with a throwaway WPF harness (real TextComposition input
                                         events) before this attribute was added; removing it reproduces
                                         both failures. -->
                                    <!-- pick-or-type: text search stays OFF so typing a
                                         new section ("Incoming 2") isn't auto-completed
                                         onto an existing one -->
                                    <ComboBox Grid.Column="3" IsEditable="True" IsTextSearchEnabled="False"
                                              ItemsSource="{Binding DataContext.SectionChoices,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              Text="{Binding Section, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Group this folder's tile appears under — or manage sections directly in the list" />
                                </Grid>
                                <Grid Style="{StaticResource FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Phase 3 task 3.2 (mechanical value-column move, same
                                         treatment the Destinations tab's equivalent Folder: Grid
                                         already got): Row 1 below holds the Problem StackPanel,
                                         which used to sit OUTSIDE this Grid with a magic
                                         Margin="110,..." faking alignment under Folder's own
                                         TextBox. ColumnSpan="3" (columns 1-3) so it can still
                                         reach as far right as the Open button, same effective
                                         width the old margin-only placement had. -->
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Folder:" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Column="1" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="2" Content="Browse…" Margin="6,0,0,0"
                                            Command="{Binding DataContext.BrowseWatchPathCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <Button Grid.Column="3" Content="Open" Margin="6,0,0,0"
                                            ToolTip="Show this folder in Explorer"
                                            Command="{Binding DataContext.OpenWatchFolderCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Problem}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{Binding Problem}" Style="{StaticResource StatusText}"
                                                   VerticalAlignment="Center" />
                                        <Button Content="Create it" Margin="8,0,0,0" Padding="8,3"
                                                Command="{Binding DataContext.CreateWatchFolderCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Problem}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Grid Style="{StaticResource FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Phase 3 task 3.2 (mechanical value-column move, same
                                         treatment the Destinations tab's equivalents already
                                         got): Row 1 below holds the "include subfolders"
                                         CheckBox, which used to sit OUTSIDE this Grid with a
                                         magic Margin="110,..." faking alignment under File
                                         types' own checkboxes. -->
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="File types:" Style="{StaticResource FieldLabel}"
                                               VerticalAlignment="Top" Margin="0,4,10,0" />
                                    <StackPanel Grid.Column="1">
                                        <WrapPanel>
                                            <CheckBox Content="Any file" IsChecked="{Binding AnyType}"
                                                      Margin="0,2,10,2" />
                                            <CheckBox Content="PDF" IsChecked="{Binding TypePdf}" Margin="0,2,10,2"
                                                      IsEnabled="{Binding AnyType, Converter={StaticResource InvertBool}}" />
                                            <CheckBox Content="TIFF" IsChecked="{Binding TypeTiff}" Margin="0,2,10,2"
                                                      IsEnabled="{Binding AnyType, Converter={StaticResource InvertBool}}" />
                                            <CheckBox Content="JPEG" IsChecked="{Binding TypeJpeg}" Margin="0,2,10,2"
                                                      IsEnabled="{Binding AnyType, Converter={StaticResource InvertBool}}" />
                                            <CheckBox Content="PNG" IsChecked="{Binding TypePng}" Margin="0,2,10,2"
                                                      IsEnabled="{Binding AnyType, Converter={StaticResource InvertBool}}" />
                                        </WrapPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                                    IsEnabled="{Binding AnyType, Converter={StaticResource InvertBool}}">
                                            <TextBlock Text="other:" Style="{StaticResource SubtleText}"
                                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBox Width="120" Text="{Binding OtherTypes}"
                                                     AutomationProperties.Name="Other file types" />
                                            <TextBlock Text="e.g. docx"
                                                       Style="{StaticResource CaptionText}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <CheckBox Grid.Row="1" Grid.Column="1" Content="include subfolders"
                                              IsChecked="{Binding Recursive}"
                                              ToolTip="Alerting files found in a subfolder show 'in ⟨subfolder⟩' on the tile" />
                                </Grid>
                                <Grid Style="{StaticResource FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tile color:" Style="{StaticResource FieldLabel}"
                                               VerticalAlignment="Top" Margin="0,4,10,0" />
                                    <TextBox Grid.Column="1" VerticalAlignment="Top"
                                             Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" />
                                    <ItemsControl Grid.Column="2" Margin="8,0,0,0"
                                                  ItemsSource="{x:Static vm:SettingsViewModel.SwatchColors}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource Swatch}" Click="OnWatchSwatch"
                                                        Tag="{Binding}" ToolTip="{Binding}"
                                                        AutomationProperties.Name="{Binding}"
                                                        Foreground="{Binding Converter={StaticResource ColorStringToForeBrush}}">
                                                    <Button.Background>
                                                        <SolidColorBrush Color="{Binding}" />
                                                    </Button.Background>
                                                    <TextBlock FontWeight="Bold">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource SwatchCheck}">
                                                                <Binding />
                                                                <Binding Path="DataContext.SelectedWatch.Color"
                                                                         RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                              </StackPanel>

                              <!-- the card exactly as Ready will show it —
                                   computed against the REAL folder, so count
                                   and alert state are live while you type -->
                              <StackPanel Grid.Row="1" Margin="0,4,0,0"
                                          Visibility="{Binding TilePreviewVisible,
                                                       Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Preview:" Style="{StaticResource FieldLabel}"
                                           Margin="0,0,0,4" />
                                <Border Width="230" MinHeight="78" CornerRadius="4" Padding="12,8"
                                        HorizontalAlignment="Left"
                                        Background="{Binding TilePreviewBack, Converter={StaticResource RgbToBrush}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding TilePreviewLabel}" Style="{StaticResource BodySmallText}"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding TilePreviewFore, Converter={StaticResource RgbToBrush}}" />
                                        <TextBlock Text="{Binding TilePreviewCount}" Style="{StaticResource TileCountText}"
                                                   Margin="0,2,0,0"
                                                   Foreground="{Binding TilePreviewFore, Converter={StaticResource RgbToBrush}}" />
                                        <TextBlock Text="{Binding TilePreviewNote}" Style="{StaticResource CaptionTextOnSurface}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasTilePreviewNote,
                                                                Converter={StaticResource BoolToVis}}"
                                                   Foreground="{Binding TilePreviewFore, Converter={StaticResource RgbToBrush}}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding TilePreviewHint}"
                                           Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap" MaxWidth="380"
                                           HorizontalAlignment="Left" Margin="0,4,0,0" />
                              </StackPanel>
                            </Grid>
                            </ScrollViewer>
                        </Grid>
                </Grid>
            </TabItem>

            <!-- ================================== Alerts & polling -->
            <!-- Phase 3 task 3.2: split out of "Monitored folders", which used
                 to pack the folder master/detail together with these two
                 unrelated regions below a magic Grid.Row="2". Same controls,
                 same bindings, same copy as before — only the container
                 changed, from a two-column Grid (Alerts on the left, Polling
                 on the right, sharing one row) to a single-column StackPanel
                 in a ScrollViewer, the same shape the General tab already
                 uses for two stacked sections. Polling no longer has to share
                 a row with Alerts, so both sections now get the tab's full
                 width. Neither section uses a FieldRow/LabelCol grid (nothing
                 here did before the split either), so unlike its neighbours
                 this tab has no Grid.IsSharedSizeScope to set. -->
            <TabItem Header="Alerts &amp; _Polling" AutomationProperties.Name="Alerts &amp; polling">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,8">
                        <TextBlock Text="Alerts" Style="{StaticResource SectionText}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap"
                                   Text="Filenames containing these terms flash the tile and the inbox count red (ignores case):" />
                        <ScrollViewer MaxHeight="60" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Focusable="False"
                                      Padding="0,0,6,0"
                                      Margin="0,4,0,4">
                            <ItemsControl ItemsSource="{Binding AlertTerms}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Theme.Surface}"
                                                BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
                                                CornerRadius="4" Padding="8,2" Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                <Button Content="✕" Margin="6,0,0,0" Padding="2,0"
                                                        Background="Transparent" BorderThickness="0"
                                                        AutomationProperties.Name="{Binding StringFormat=Remove alert term {0}}"
                                                        Command="{Binding DataContext.RemoveAlertCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="Add" MinWidth="48" Margin="6,0,0,0"
                                    Command="{Binding AddAlertCommand}" />
                            <TextBox Text="{Binding NewAlertText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="New alert term">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddAlertCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                        <CheckBox Content="Flash alerts (uncheck for a steady highlight)"
                                  IsChecked="{Binding FlashAlerts}" />

                        <TextBlock Text="Polling" Style="{StaticResource SectionText}" Margin="0,16,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Check folders every" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Width="52"
                                     Text="{Binding PollSecondsText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Check folders every seconds" />
                            <TextBlock Text="sec" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Tag="5" Click="OnPollPreset" MinWidth="34"
                                    Style="{StaticResource ChipButton}" AutomationProperties.Name="5">
                                <TextBlock Text="5" Style="{StaticResource ChipButtonLabel}" />
                            </Button>
                            <Button Tag="15" Click="OnPollPreset" MinWidth="34"
                                    Style="{StaticResource ChipButton}" Margin="4,0,0,0" AutomationProperties.Name="15">
                                <TextBlock Text="15" Style="{StaticResource ChipButtonLabel}" />
                            </Button>
                            <Button Tag="30" Click="OnPollPreset" MinWidth="34"
                                    Style="{StaticResource ChipButton}" Margin="4,0,0,0" AutomationProperties.Name="30">
                                <TextBlock Text="30" Style="{StaticResource ChipButtonLabel}" />
                            </Button>
                            <Button Tag="60" Click="OnPollPreset" MinWidth="34"
                                    Style="{StaticResource ChipButton}" Margin="4,0,0,0" AutomationProperties.Name="60">
                                <TextBlock Text="60" Style="{StaticResource ChipButtonLabel}" />
                            </Button>
                        </StackPanel>
                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Lower = alerts appear sooner; higher = gentler on a network share." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================== Appearance -->
            <TabItem Header="_Appearance" AutomationProperties.Name="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <!-- IsSharedSizeScope: see the General tab's identical
                     comment above — same per-tab LabelCol pattern. Not
                     called out by name in the audit that seeded this task
                     (it named General/Filing/Data files for the 130-family),
                     but "App font:"/"Base text size:" below use the exact
                     same hand-tuned Width="130" the other three tabs did, so
                     it gets the same treatment for consistency — leaving it
                     fixed while its siblings became Auto would just move the
                     inconsistency instead of fixing it. -->
                <StackPanel Margin="16,8" Grid.IsSharedSizeScope="True">
                    <TextBlock Text="Colors" Style="{StaticResource SectionText}" Margin="0,0,0,10" />
                    <!-- WrapPanel, not the StackPanel this row used to be:
                         with 7 registry schemes (was 2) the row is wider than
                         the window and MUST wrap. A horizontal StackPanel
                         gives every child infinite width in the stacking
                         direction — including the ItemsControl below, whose
                         OWN inner WrapPanel would then never see a bounded
                         width to wrap against and the cards would run off
                         the window edge. A WrapPanel instead measures each
                         child with ITS OWN (bounded) constraint, so the
                         bound width really does reach the inner WrapPanel
                         through the ItemsControl — verified against WPF's
                         own WrapPanel.MeasureOverride, which passes
                         `constraint` (its own received size), not infinity,
                         to each child it measures. -->
                    <WrapPanel>
                        <!-- Auto: half of each world -->
                        <RadioButton Style="{StaticResource ThemeCard}" Tag="Auto"
                                     IsChecked="{Binding ThemeAuto}"
                                     AutomationProperties.Name="Follow Windows light/dark mode"
                                     ToolTip="Follow the Windows light/dark setting">
                            <Grid Width="112" Height="70">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="4,0,0,4" Background="{DynamicResource Light.WindowBg}"
                                        BorderBrush="{DynamicResource Light.Border}" BorderThickness="1,1,0,1">
                                    <StackPanel Margin="10,10,4,10">
                                        <Border Height="16" CornerRadius="4" Background="{DynamicResource Light.Surface}"
                                                BorderBrush="{DynamicResource Light.Border}" BorderThickness="1" />
                                        <Rectangle Height="4" RadiusX="2" RadiusY="2" Fill="{DynamicResource Light.SubtleText}"
                                                   Margin="0,7,8,0" />
                                        <!-- pill scale is 12 (see declared radius scale); WPF clamps
                                             CornerRadius to half the shorter side, so 12 renders
                                             identically to 5.5 on this 11px-tall pill -->
                                        <Border Width="30" Height="11" CornerRadius="12"
                                                Background="{DynamicResource Light.Accent}" HorizontalAlignment="Left"
                                                Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" CornerRadius="0,4,4,0" Background="{DynamicResource Dark.WindowBg}"
                                        BorderBrush="{DynamicResource Dark.Border}" BorderThickness="0,1,1,1">
                                    <StackPanel Margin="4,10,10,10">
                                        <Border Height="16" CornerRadius="4" Background="{DynamicResource Dark.Surface}"
                                                BorderBrush="{DynamicResource Dark.Border}" BorderThickness="1" />
                                        <Rectangle Height="4" RadiusX="2" RadiusY="2" Fill="{DynamicResource Dark.SubtleText}"
                                                   Margin="0,7,8,0" />
                                        <!-- pill scale is 12 (see declared radius scale); WPF clamps
                                             CornerRadius to half the shorter side, so 12 renders
                                             identically to 5.5 on this 11px-tall pill -->
                                        <Border Width="30" Height="11" CornerRadius="12"
                                                Background="{DynamicResource Dark.Accent}" HorizontalAlignment="Left"
                                                Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </RadioButton>
                        <!-- one card per ThemePalette.Schemes registry entry —
                             data-driven so a new scheme needs no XAML edit.
                             Same ThemeCard style/chrome as Auto above (shared
                             GroupName="ThemeMode" set BY the style, so WPF's
                             own radio-group exclusivity covers Auto + every
                             card here); preview colors come from the VM's
                             Rgb-typed SchemeOptionVm properties through the
                             house RgbToBrush converter, not new resource
                             keys — ThemeManager's Light.*/Dark.* publication
                             (pinned by AppearancePreviewTests) is untouched. -->
                        <ItemsControl ItemsSource="{Binding SchemeOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource ThemeCard}" Tag="{Binding DisplayName}"
                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                 AutomationProperties.Name="{Binding DisplayName}">
                                        <Border Width="112" Height="70" CornerRadius="4"
                                                Background="{Binding PreviewWindowBg, Converter={StaticResource RgbToBrush}}"
                                                BorderBrush="{Binding PreviewBorder, Converter={StaticResource RgbToBrush}}"
                                                BorderThickness="1">
                                            <StackPanel Margin="10,9">
                                                <Border Height="16" CornerRadius="4"
                                                        Background="{Binding PreviewSurface, Converter={StaticResource RgbToBrush}}"
                                                        BorderBrush="{Binding PreviewBorder, Converter={StaticResource RgbToBrush}}"
                                                        BorderThickness="1" />
                                                <Rectangle Height="4" RadiusX="2" RadiusY="2"
                                                           Fill="{Binding PreviewSubtleText, Converter={StaticResource RgbToBrush}}"
                                                           Margin="0,7,26,0" />
                                                <!-- pill scale is 12 (see declared radius scale); WPF clamps
                                                     CornerRadius to half the shorter side, so 12 renders
                                                     identically to 5.5 on this 11px-tall pill -->
                                                <Border Width="44" Height="11" CornerRadius="12"
                                                        Background="{Binding PreviewAccent, Converter={StaticResource RgbToBrush}}"
                                                        HorizontalAlignment="Left" Margin="0,8,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="4,6,0,0"
                               Text="Every text pairing in every scheme meets WCAG AA contrast — enforced by the test suite." />

                    <TextBlock Text="Text" Style="{StaticResource SectionText}" Margin="0,16,0,10" />
                    <Grid Style="{StaticResource FieldRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="App font:" Style="{StaticResource FieldLabel}" />
                        <!-- every choice previews itself -->
                        <!-- FontChoiceTemplate lives in Theme/Styles.xaml now, same
                             reason as KvpValueTemplate (see its declaration there). -->
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{x:Static vm:SettingsViewModel.FontChoices}"
                                  SelectedValuePath="Key"
                                  SelectedValue="{Binding UiFontFamily}"
                                  ItemTemplate="{StaticResource FontChoiceTemplate}" />
                    </Grid>
                    <Grid Style="{StaticResource FieldRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Base text size:" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1" Text="{Binding UiFontSizeText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Base text size" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                            <Button Tag="12" Click="OnFontSizePreset" MinWidth="34"
                                    Style="{StaticResource ChipButton}" AutomationProperties.Name="12">
                                <TextBlock Text="12" Style="{StaticResource ChipButtonLabel}" />
                            </Button>
                            <Button Tag="14" Click="OnFontSizePreset" MinWidth="34"
                                    Style="{StaticResource ChipButton}" Margin="4,0,0,0" AutomationProperties.Name="14">
                                <TextBlock Text="14" Style="{StaticResource ChipButtonLabel}" />
                            </Button>
                            <Button Tag="16" Click="OnFontSizePreset" MinWidth="34"
                                    Style="{StaticResource ChipButton}" Margin="4,0,0,0" AutomationProperties.Name="16">
                                <TextBlock Text="16" Style="{StaticResource ChipButtonLabel}" />
                            </Button>
                            <Button Tag="18" Click="OnFontSizePreset" MinWidth="34"
                                    Style="{StaticResource ChipButton}" Margin="4,0,0,0" AutomationProperties.Name="18">
                                <TextBlock Text="18" Style="{StaticResource ChipButtonLabel}" />
                            </Button>
                        </StackPanel>
                        <TextBlock Grid.Column="3" Style="{StaticResource SubtleText}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   Text="6–72 · blank = default" TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <!-- what the choices actually look like, live -->
                    <TextBlock Text="Sample" Style="{StaticResource SectionText}" Margin="0,14,0,6" />
                    <Border Background="{DynamicResource Theme.Surface}"
                            BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
                            CornerRadius="4" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="Will be filed as:  20240115-SMITH JOHN-12345.pdf"
                                       FontFamily="{Binding UiFontFamily, Converter={StaticResource FontFamilyString}}"
                                       FontSize="{Binding UiFontSizeText, Converter={StaticResource FontSizeText}}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="The quick brown fox jumps over 0123456789."
                                       FontFamily="{Binding UiFontFamily, Converter={StaticResource FontFamilyString}}"
                                       FontSize="{Binding UiFontSizeText, Converter={StaticResource FontSizeText}}"
                                       Style="{StaticResource SubtleText}" Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Sounds" Style="{StaticResource SectionText}" Margin="0,18,0,8" />
                    <CheckBox Content="Play sounds" IsChecked="{Binding SoundsEnabled}"
                              Margin="0,0,0,8" />
                    <StackPanel IsEnabled="{Binding SoundsEnabled}">
                        <StackPanel.Resources>
                            <!-- one row per moment; DataContext is a SoundChoiceVm -->
                            <DataTemplate x:Key="SoundRow">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               Margin="0,0,10,0" />
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding Choice}"
                                              AutomationProperties.Name="{Binding Name}">
                                        <ComboBoxItem Content="OrdoSort" />
                                        <ComboBoxItem Content="Windows chime" />
                                        <ComboBoxItem Content="Custom .wav…" />
                                        <ComboBoxItem Content="Silent" />
                                    </ComboBox>
                                    <Button Grid.Column="2" Command="{Binding TestCommand}"
                                            Style="{StaticResource ChipButton}" Margin="8,0,0,0"
                                            VerticalAlignment="Center" AutomationProperties.Name="Test">
                                        <TextBlock Text="▶ Test" Style="{StaticResource ChipButtonLabel}" />
                                    </Button>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding ShowCustom, Converter={StaticResource BoolToVis}}">
                                        <Button Command="{Binding BrowseCommand}"
                                                Style="{StaticResource ChipButton}" AutomationProperties.Name="Browse">
                                            <TextBlock Text="Browse…" Style="{StaticResource ChipButtonLabel}" />
                                        </Button>
                                        <TextBlock Text="{Binding CustomLabel}" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </StackPanel.Resources>
                        <ContentControl Content="{Binding NewAlertSound}"
                                        ContentTemplate="{StaticResource SoundRow}" />
                        <ContentControl Content="{Binding FiledSound}"
                                        ContentTemplate="{StaticResource SoundRow}" />
                        <ContentControl Content="{Binding SetAsideSound}"
                                        ContentTemplate="{StaticResource SoundRow}" />
                        <ContentControl Content="{Binding ErrorSound}"
                                        ContentTemplate="{StaticResource SoundRow}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="OrdoSort = the built-in sounds. Custom plays any .wav you point to. A new-alert sound plays once per newly-arrived file — never on a repeat scan." />
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================== Data files -->
            <TabItem Header="Da_ta files" AutomationProperties.Name="Data files">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <!-- IsSharedSizeScope: see the General tab's identical
                         comment above — same per-tab LabelCol pattern. -->
                    <StackPanel Margin="16,8" Grid.IsSharedSizeScope="True">
                        <TextBlock Text="Data files" Style="{StaticResource SectionText}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Changing a path re-points the app at that file — it does not move the current contents. A missing file is created on save from the current list." />

                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Destinations:" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Text="{Binding DestinationsFile, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="2" Content="Browse…" Margin="6,0,0,0"
                                    Command="{Binding BrowseDestinationsFileCommand}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DestinationsFileNote}"
                                       Tag="{Binding DestinationsFileNoteNeedsAttention}"
                                       Style="{StaticResource NoteText}" />
                        </Grid>

                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Monitored folders:" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Text="{Binding MonitoredFoldersFile, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="2" Content="Browse…" Margin="6,0,0,0"
                                    Command="{Binding BrowseMonitoredFoldersFileCommand}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MonitoredFoldersFileNote}"
                                       Tag="{Binding MonitoredFoldersFileNoteNeedsAttention}"
                                       Style="{StaticResource NoteText}" />
                        </Grid>

                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Alerts:" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Text="{Binding AlertsFile, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="2" Content="Browse…" Margin="6,0,0,0"
                                    Command="{Binding BrowseAlertsFileCommand}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AlertsFileNote}"
                                       Tag="{Binding AlertsFileNoteNeedsAttention}"
                                       Style="{StaticResource NoteText}" />
                        </Grid>

                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Box labels:" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Text="{Binding BoxLabelsFile, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="2" Content="Browse…" Margin="6,0,0,0"
                                    Command="{Binding BrowseBoxLabelsFileCommand}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BoxLabelsFileNote}"
                                       Tag="{Binding BoxLabelsFileNoteNeedsAttention}"
                                       Style="{StaticResource NoteText}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
