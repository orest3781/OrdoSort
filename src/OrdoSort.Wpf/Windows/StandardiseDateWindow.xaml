<Window x:Class="OrdoSort.Wpf.Windows.StandardiseDateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrdoSort — Batch date"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        MinWidth="380" MaxWidth="520"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}">
    <!-- The date prompt a drop or Add files… raises in the Standardise
         names tool. PasswordWindow's own shape, deliberately: a plain
         Window (the implicit Window style and TitleBar's dark caption come
         free), one glyph, one message, one field, Rename as the default
         button.

         No button carries IsCancel: Escape is handled once, at the window,
         and always means Cancel — see PasswordWindow's own comment on why a
         button with both IsCancel and a Click handler is a race. Rename is
         the default (Enter), because a prompt that exists to be answered
         should answer on Enter — Cancel is the one answer that changes
         nothing, so it is never the default. -->
    <DockPanel Margin="18,16,18,14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="RenameButton" Click="OnRename" MinWidth="96" Margin="0,0,8,0" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Rename">
                <TextBlock Text="Rename" Style="{StaticResource PrimaryButtonLabel}" />
            </Button>
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" MinWidth="90"
                    AutomationProperties.Name="Cancel" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="Glyph" Grid.RowSpan="3" Style="{StaticResource Icon}" FontSize="22"
                       Text="&#xE787;" VerticalAlignment="Top" Margin="0,1,14,0" />

            <!-- MaxWidth, not a fixed Width: SizeToContent lets a short
                 message make a small dialog. -->
            <TextBlock x:Name="MessageText" Grid.Column="1" TextWrapping="Wrap" MaxWidth="360" />

            <!-- Shown only after Rename was clicked with something that
                 isn't a real YYYYMMDD date. Amber: "needs attention", not an
                 error (status-colour-vocabulary plan, 2026-08-08). -->
            <TextBlock x:Name="FailedText" Grid.Column="1" Grid.Row="1" TextWrapping="Wrap" MaxWidth="360"
                       Margin="0,6,0,0" Text="Enter a real date as YYYYMMDD, e.g. 20260115."
                       Foreground="{DynamicResource Theme.StatusAmber}" Visibility="Collapsed" />

            <Grid Grid.Column="1" Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Date:" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Column="1" x:Name="DateBox"
                         AutomationProperties.Name="Batch date, YYYYMMDD" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
