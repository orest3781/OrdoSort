<Window x:Class="OrdoSort.Wpf.Windows.ColumnChooserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrdoSort — Choose columns"
        Width="380" Height="540" MinWidth="320" MinHeight="380"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}">
    <!-- Review matches' "More columns…" (2026-09-26), File Explorer's
         Choose Details: every spreadsheet column with a tick, a search box
         for long rosters, OK to apply. Escape is handled once, at the window,
         and means Cancel (the reasoning every small modal prompt here follows); OK is the
         default button. -->
    <DockPanel Margin="18,16,18,14">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Tick the spreadsheet columns to show in Review matches." />
        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,8"
                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="Search columns" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Click="OnOk" MinWidth="96" Margin="0,0,8,0" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" AutomationProperties.Name="OK">
                <TextBlock Text="OK" Style="{StaticResource PrimaryButtonLabel}" />
            </Button>
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" MinWidth="90"
                    AutomationProperties.Name="Cancel" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap"
                   Style="{StaticResource CaptionText}"
                   Text="The name and ID columns are always shown." />
        <ListBox x:Name="ColumnList" ItemsSource="{Binding Visible}"
                 AutomationProperties.Name="Spreadsheet columns">
            <!-- Without a name, a screen reader announced each row as its CLR
                 type, "OrdoSort.Wpf.ViewModels.ColumnChoice" (found when this
                 window joined WindowOverflowTests' registry, which
                 AccessibleNameTests shares). BasedOn keeps the shared
                 ListBoxItem style: an explicit ItemContainerStyle replaces it
                 otherwise. LabelMakerWindow's client list is the same fix. -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Header}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Header}" IsChecked="{Binding IsChosen}"
                              IsEnabled="{Binding IsLocked, Converter={StaticResource InvertBool}}"
                              AutomationProperties.Name="{Binding Header}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
