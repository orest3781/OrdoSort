<Window x:Class="OrdoSort.Wpf.Windows.LabelMakerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OrdoSort.Wpf.Views"
        Title="OrdoSort — Box labels" Width="680" Height="560" MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource {x:Type Window}}">
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Width="96" IsCancel="True" />
            <Button DockPanel.Dock="Right" Command="{Binding SavePdfCommand}"
                    Width="110" Margin="0,0,8,0" AutomationProperties.Name="Save PDF">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" Margin="0,0,7,0" />
                    <TextBlock Text="Save PDF…" />
                </StackPanel>
            </Button>
            <!-- IsDefault is safe here: Enter only opens the preview, which
                 Esc backs out of — nothing spools without a second Print -->
            <Button DockPanel.Dock="Right" Command="{Binding PrintCommand}"
                    Style="{StaticResource PrimaryButton}" Width="110" Margin="0,0,8,0"
                    IsDefault="True" AutomationProperties.Name="Print">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE749;" Margin="0,0,7,0"
                               Foreground="{DynamicResource Theme.AccentText}" />
                    <TextBlock Text="Print…" Foreground="{DynamicResource Theme.AccentText}" />
                </StackPanel>
            </Button>
            <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Status}" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- client list -->
            <DockPanel>
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button Content="Add" Command="{Binding AddClientCommand}" MinWidth="48" Margin="0,0,4,0" />
                    <Button Content="Remove" Command="{Binding RemoveClientCommand}" />
                </WrapPanel>
                <Grid>
                    <ListBox ItemsSource="{Binding Clients}" SelectedItem="{Binding Selected}"
                             AutomationProperties.Name="Clients">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel ToolTip="{Binding Summary}" Background="Transparent">
                                    <!-- the next number, at a glance -->
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding NextNumberText}"
                                               Style="{StaticResource SubtleText}" FontSize="11"
                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding Id}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False" Background="{DynamicResource Theme.Surface}"
                            BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
                            CornerRadius="4" Padding="16">
                        <Border.Visibility>
                            <Binding Path="Clients.Count" Converter="{StaticResource ZeroToVis}" />
                        </Border.Visibility>
                        <StackPanel>
                            <Image Height="76" Margin="0,0,0,8"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Source="pack://application:,,,/OrdoSort;component/Assets/labels-empty.png" />
                            <TextBlock Text="No clients yet — press Add."
                                       Style="{StaticResource SubtleText}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>

            <!-- selected client -->
            <StackPanel Grid.Column="1" Margin="16,0,0,0" DataContext="{Binding Selected}">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Client id:" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox x:Name="IdBox" Grid.Column="1" CharacterCasing="Upper" MaxLength="8"
                             Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Client id" />
                    <TextBlock Grid.Column="2" Text="2-8 letters or digits"
                               Style="{StaticResource SubtleText}" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Keep boxes (days):" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1"
                             Text="{Binding DestroyDaysText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Keep boxes days" />
                    <TextBlock Grid.Column="2" Text="sets the destruction date"
                               Style="{StaticResource SubtleText}" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Next label number:" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1"
                             Text="{Binding NextNumberText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Next label number" />
                    <Button Grid.Column="2" Content="Reset to 1" Margin="8,0,0,0"
                            Style="{StaticResource ChipButton}" VerticalAlignment="Center"
                            ToolTip="Start this client's numbering over at 00000001"
                            Command="{Binding DataContext.ResetNumberCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}" />
                </Grid>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Labels to print:" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1"
                             Text="{Binding DataContext.LabelCountText,
                                    RelativeSource={RelativeSource AncestorType=Window},
                                    UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Labels to print" />
                    <!-- whole-sheet presets: one click for the common runs -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0"
                                VerticalAlignment="Center">
                        <Button Content="10" Tag="10" Click="OnCountPreset" MinWidth="36"
                                Style="{StaticResource ChipButton}" />
                        <Button Content="20" Tag="20" Click="OnCountPreset" MinWidth="36"
                                Style="{StaticResource ChipButton}" Margin="4,0,0,0" />
                        <Button Content="30" Tag="30" Click="OnCountPreset" MinWidth="36"
                                Style="{StaticResource ChipButton}" Margin="4,0,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="10 per sheet · 4×2 in"
                               Style="{StaticResource SubtleText}" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Date bars:" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <RadioButton GroupName="DateStyle" Content="black bars (white text)"
                                     IsChecked="{Binding DataContext.DateStyleBars,
                                                 RelativeSource={RelativeSource AncestorType=Window}}"
                                     VerticalAlignment="Center" Margin="0,0,16,0" />
                        <RadioButton GroupName="DateStyle" Content="plain (black text)"
                                     IsChecked="{Binding DataContext.DateStylePlain,
                                                 RelativeSource={RelativeSource AncestorType=Window}}"
                                     VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- the first label, rendered exactly as it will print -->
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                <TextBlock Text="{Binding Preview}" FontWeight="SemiBold" TextWrapping="Wrap"
                           Margin="0,0,0,6" />
                <Border BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
                        CornerRadius="4" Padding="10"
                        Background="{DynamicResource Theme.Surface}">
                    <Grid Height="160">
                        <views:LabelPreviewControl Item="{Binding PreviewItem}"
                                                   DateStyle="{Binding DateStyle}"
                                                   AutomationProperties.Name="Label preview" />
                        <TextBlock Text="Fix the inputs above to see the label."
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubtleText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreviewItem}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
