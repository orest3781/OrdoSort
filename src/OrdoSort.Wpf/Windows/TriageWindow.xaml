<Window x:Class="OrdoSort.Wpf.Windows.TriageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="OrdoSort — Review matches" Width="1150" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource {x:Type Window}}"
        PreviewKeyDown="OnWindowKeyDown">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition Width="5" />
            <!-- x:Name: kept for the GridSplitter above (ResizeBehavior=
                 PreviousAndNext) and for tests that simulate a splitter drag
                 by setting this column's Width directly. TriageWindow.xaml.cs
                 no longer reads this column's Width itself — the Candidates
                 grid's roster-column cap is tracked against Candidates' own
                 live ActualWidth (DataGridColumnCap.Track), the same
                 mechanism MatchMergeWindow/BulkRenameWindow/HistoryWindow use
                 for their own live window-resize case. That fixes a real bug
                 (2026-08-08): this column IS resizable (drag the
                 GridSplitter), but a cap computed once from its declared
                 440px never revisited a wider or narrower live width. -->
            <ColumnDefinition x:Name="SidePanelColumn" Width="440" MinWidth="380" />
        </Grid.ColumnDefinitions>
        <!-- same tab hygiene as the main window: Tab goes straight to the
             candidate grid and buttons, never into the browser -->
        <wv2:WebView2 x:Name="Viewer" Focusable="False" />
        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext" IsTabStop="False" />
        <DockPanel Grid.Column="2" Margin="12,0,0,0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock x:Name="Progress" Style="{StaticResource HeadlineCompactText}" />
                <TextBlock x:Name="FileName" Style="{StaticResource SubtleText}"
                           TextWrapping="Wrap" Margin="0,4,0,10" />
                <TextBlock Text="Which row does this document belong to?  1–9 picks · Enter confirms · S skips"
                           Margin="0,0,0,6" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom">
                <TextBlock x:Name="Note" Style="{StaticResource StatusText}" Margin="0,10,0,0" />
                <Button x:Name="UseButton" Click="OnUseSelected"
                        Style="{StaticResource PrimaryButton}" Height="40" IsEnabled="False"
                        AutomationProperties.Name="Use selected id">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Margin="0,0,8,0"
                                   Foreground="{DynamicResource Theme.AccentText}" />
                        <TextBlock Text="Use selected id" Style="{StaticResource PrimaryButtonLabel}" />
                    </StackPanel>
                </Button>
                <!-- x:Name on both: Enter belongs to whichever of these has
                     keyboard focus, not to the row still selected behind it
                     (TriageWindow.xaml.cs, DispatchVerb), and a test proving
                     that needs the REAL buttons rather than a stand-in. -->
                <Button x:Name="SkipButton" Content="Skip this file" Click="OnSkip"
                        Height="34" Margin="0,8,0,0" />
                <!-- IsCancel: click or Esc — merges already done stay done.
                     Esc is also answered by DispatchVerb, which is the only
                     route that works while the PDF pane holds focus. -->
                <Button x:Name="StopButton" Content="Stop reviewing" IsCancel="True"
                        Height="34" Margin="0,8,0,0" />
            </StackPanel>
            <!-- Enter or double-click accepts the selected row — a long review
                 run shouldn't mean reaching for the button every time -->
            <DataGrid x:Name="Candidates" AutomationProperties.Name="Matching rows"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single"
                      SelectionChanged="OnCandidateSelected"
                      MouseDoubleClick="OnCandidateAccept" />
        </DockPanel>
    </Grid>
</Window>
