<Window x:Class="OrdoSort.Wpf.Windows.StandardiseNamesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OrdoSort.Wpf.ViewModels"
        xmlns:views="clr-namespace:OrdoSort.Wpf.Views;assembly=OrdoSort.Ui"
        Title="OrdoSort — Standardise names" Width="820" Height="640" MinWidth="660" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" AllowDrop="True"
        DragOver="OnDragOver" Drop="OnDrop"
        Style="{StaticResource {x:Type Window}}">
    <!-- Preview, then Rename (owner request 2026-09-29). A drop or Add
         files… lists the files with the name each will get; the controls
         change the preview live; nothing on disk changes until Rename. -->
    <Window.Resources>
        <!-- Same card and chip chrome as BulkRenameWindow's, so the two
             rename tools read as one family. -->
        <Style x:Key="ParamCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="SegmentChip" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="False">
                    <Setter Property="Background" Value="{DynamicResource Theme.WindowBg}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
                    <Setter Property="Foreground" Value="{DynamicResource Theme.SubtleText}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- One label and its drop-down; wraps to the next line as a whole
             at large text sizes rather than splitting or overflowing. -->
        <Style x:Key="OptionPair" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,18,8" />
        </Style>
        <Style x:Key="OptionCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="DisplayMemberPath" Value="Label" />
            <Setter Property="SelectedValuePath" Value="Value" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Width="96" IsCancel="True" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="RenameButton" Command="{Binding RenameCommand}"
                        Style="{StaticResource PrimaryButton}" MinWidth="130" Margin="0,0,8,0"
                        AutomationProperties.Name="{Binding RenameButtonText}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8AC;" Margin="0,0,8,0"
                                   Foreground="{DynamicResource Theme.AccentText}" />
                        <TextBlock Text="{Binding RenameButtonText}" Style="{StaticResource PrimaryButtonLabel}" />
                    </StackPanel>
                </Button>
                <Button Content="Undo last rename" Command="{Binding UndoCommand}" Margin="0,0,10,0"
                        AutomationProperties.Name="Undo last rename" />
                <!-- MaxWidth is load-bearing: StatusText wraps, and a
                     horizontal StackPanel measures at infinite width, so
                     without a cap the wrap never engages (TextWrapCoverageTests). -->
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                           Style="{StaticResource StatusText}" MaxWidth="320" />
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Row 0: the list's own buttons. Buttons first, docked left,
                 so the note trims into what they leave and never paints
                 over them (ToolbarButtonsDoNotOverlapALongNoteAtMinWidth). -->
            <DockPanel Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="Add files…" Click="OnAddFiles" Margin="0,0,6,0"
                            IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Add files" />
                    <Button Content="Clear list" Command="{Binding ClearCommand}" Margin="0,0,10,0"
                            AutomationProperties.Name="Clear list" />
                </StackPanel>
                <TextBlock Text="{Binding AddNote}"
                           Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                           MaxWidth="320" TextTrimming="CharacterEllipsis"
                           views:TrimmedTextTooltip.Enabled="True" />
            </DockPanel>

            <!-- Row 1: how names are built. -->
            <Border Grid.Row="1" Style="{StaticResource ParamCard}">
                <StackPanel>
                    <TextBlock Text="Name" Style="{StaticResource SectionHeaderFirst}" />
                    <WrapPanel>
                        <StackPanel Style="{StaticResource OptionPair}">
                            <TextBlock Text="Letter case" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="CaseBox" Style="{StaticResource OptionCombo}"
                                      ItemsSource="{x:Static vm:StandardiseNamesViewModel.CaseChoices}"
                                      SelectedValue="{Binding Case}" IsEnabled="{Binding IsIdle}"
                                      AutomationProperties.Name="Letter case" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource OptionPair}">
                            <TextBlock Text="Between words" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="SeparatorBox" Style="{StaticResource OptionCombo}"
                                      ItemsSource="{x:Static vm:StandardiseNamesViewModel.SeparatorChoices}"
                                      SelectedValue="{Binding Separator}" IsEnabled="{Binding IsIdle}"
                                      AutomationProperties.Name="Between words" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="Date" Style="{StaticResource SectionHeaderFirst}" Margin="0,4,0,6" />
                    <WrapPanel>
                        <StackPanel Style="{StaticResource OptionPair}">
                            <TextBlock Text="Place" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="DatePlacementBox" Style="{StaticResource OptionCombo}"
                                      ItemsSource="{x:Static vm:StandardiseNamesViewModel.DatePlacementChoices}"
                                      SelectedValue="{Binding DatePlacement}" IsEnabled="{Binding IsIdle}"
                                      AutomationProperties.Name="Date place" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource OptionPair}" IsEnabled="{Binding UsesDate}">
                            <TextBlock Text="Use" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="DateSourceBox" Style="{StaticResource OptionCombo}" MinWidth="210"
                                      ItemsSource="{x:Static vm:StandardiseNamesViewModel.DateSourceChoices}"
                                      SelectedValue="{Binding DateSource}" IsEnabled="{Binding IsIdle}"
                                      AutomationProperties.Name="Date to use" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource OptionPair}" IsEnabled="{Binding UsesTypedDate}">
                            <TextBlock Text="Date" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="DateBox" Width="96" MaxLength="8" VerticalContentAlignment="Center"
                                     Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsIdle}"
                                     AutomationProperties.Name="Date, YYYYMMDD"
                                     ToolTip="YYYYMMDD. Also used for a name with no date of its own, or a file whose modified date can't be read." />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{Binding DateError}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.StatusRed}"
                               Visibility="{Binding HasDateError, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <!-- Row 2: the segment chips. -->
            <Border Grid.Row="2" Style="{StaticResource ParamCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Keep all words" Command="{Binding ResetSegmentsCommand}"
                                Margin="10,0,0,0" AutomationProperties.Name="Keep all words" />
                        <TextBlock Text="Words" Style="{StaticResource SectionText}" Margin="0,0,10,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SegmentBarCaption}" Style="{StaticResource SubtleText}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   views:TrimmedTextTooltip.Enabled="True" />
                    </DockPanel>
                    <ItemsControl x:Name="ChipsList" ItemsSource="{Binding SegmentChips}" Focusable="False"
                                  IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Words">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource SegmentChip}"
                                              IsChecked="{Binding IsKept, Mode=TwoWay}"
                                              AutomationProperties.Name="{Binding AccessibleName}"
                                              ToolTip="Click to keep or drop this word">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Position}" FontSize="11" Margin="0,0,5,0"
                                                   Foreground="{DynamicResource Theme.SubtleText}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Text}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsKept}" Value="False">
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Row 3: the preview. -->
            <Grid Grid.Row="3">
                <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding Results}" AutoGenerateColumns="False"
                          AutomationProperties.Name="Files to standardise"
                          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                          SelectionMode="Extended" SelectionChanged="OnSelectionChanged">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <!-- a screen reader names the row by its file (AccessibleNameTests) -->
                            <Setter Property="AutomationProperties.Name" Value="{Binding Current}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Theme.RowHover}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <!-- fixed widths; the user sizes them (table rules v2, rule 1) -->
                        <DataGridTextColumn Header="Current name" Binding="{Binding Current}" Width="360">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextSelectionAware}" />
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="ResultColumn" Header="Result" Binding="{Binding Result}"
                                            Width="380">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}"
                                                     Value="{x:Static vm:StandardiseRowStatus.Failed}">
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.StatusRed}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}"
                                                     Value="{x:Static vm:StandardiseRowStatus.Skipped}">
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.StatusAmber}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}"
                                                     Value="{x:Static vm:StandardiseRowStatus.Unchanged}">
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.SubtleText}" />
                                        </DataTrigger>
                                        <!-- selection wins; declared last so it overrides the above -->
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <Binding Path="IsSelected"
                                                         RelativeSource="{RelativeSource AncestorType=DataGridCell}" />
                                            </DataTrigger.Binding>
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource Theme.AccentText}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Drag files anywhere on this window, or click Add files…. Nothing is renamed until you click Rename."
                           Style="{StaticResource EmptyStateText}"
                           IsHitTestVisible="False">
                    <TextBlock.Visibility>
                        <Binding Path="Results.Count" Converter="{StaticResource ZeroToVis}" />
                    </TextBlock.Visibility>
                </TextBlock>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
