<Window x:Class="OrdoSort.Wpf.Windows.StandardiseNamesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OrdoSort.Wpf.ViewModels"
        xmlns:views="clr-namespace:OrdoSort.Wpf.Views"
        Title="OrdoSort — Standardise names" Width="700" Height="520" MinWidth="580" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" AllowDrop="True"
        DragOver="OnDragOver" Drop="OnDrop"
        Style="{StaticResource {x:Type Window}}">
    <!-- One job, one list, window-level drop — ZipToolsWindow/MergePdfsWindow's
         own shape (2026-08-25 spec). What's different here: no primary
         action button. A drop or Add files… IS the action — prompt for the
         date, then rename immediately — so there is nothing left to click
         afterward except Undo. -->
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Width="96" IsCancel="True" />
            <StackPanel Orientation="Horizontal">
                <!-- MaxWidth is load-bearing, not cosmetic: StatusText
                     carries TextWrapping="Wrap" (Theme/Styles.xaml), and a
                     horizontal StackPanel measures every child at infinite
                     width, so without a finite cap the wrap never engages
                     and the line runs off screen (TextWrapCoverageTests). -->
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                           Style="{StaticResource StatusText}" MaxWidth="360" />
            </StackPanel>
        </DockPanel>

        <Grid Margin="16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Fix round 1 (correctness review): the buttons StackPanel now
                 comes FIRST — Dock="Left", declared before AddNote — so it
                 gets the DockPanel's own remaining space unconditionally,
                 before AddNote (the DockPanel's last, un-Dock'd fill child,
                 which trims into whatever's left) is even considered. It
                 used to be the other way around: AddNote docked Right and
                 arranged FIRST, leaving the buttons StackPanel as the
                 fill child, arranged into whatever remained — but a Panel
                 does not clip its own children to that arranged size, so
                 the buttons' own natural, cumulative layout could still
                 extend past it. Measured directly, off-screen, at this
                 window's own 580px MinWidth with a genuine AddFilesAsync
                 -produced note: Undo last batch's own rendered rect and
                 AddNote's genuinely overlapped by roughly 119px
                 horizontally — Undo last batch visibly painted across the
                 caption — while every element still stayed inside the
                 window, invisible to NoTextElementEscapesTheWindow, which
                 measures escape past the window edge, not one element
                 overlapping another (see AutoFitColumnTests'
                 StandardiseNames_ToolbarButtonsDoNotOverlapALongNoteAtMin
                 Width for the dedicated fact this needed instead). -->
            <DockPanel Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="Add files…" Click="OnAddFiles" Margin="0,0,10,0"
                            IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Add files" />
                    <!-- Counts from the END, one click per segment — see
                         BulkRename.PlanPeel's own doc comment for the two
                         rules (the one-segment floor, a refused collision).
                         Unlike BulkRenameWindow's own Delete-segments
                         checkboxes (which count from the LEFT and need a
                         separate Rename click to apply), this acts
                         immediately on whatever is selected — the same "the
                         click IS the action" shape every button in this
                         window already has. No IsEnabled binding: PeelCommand's
                         own CanExecute (selection non-empty and idle) already
                         disables the button through the Command binding, the
                         same way Undo last batch needs none either. -->
                    <Button Content="Remove last segment" Command="{Binding PeelCommand}" Margin="0,0,10,0"
                            AutomationProperties.Name="Remove last segment" />
                    <Button Content="Undo last batch" Command="{Binding UndoCommand}"
                            AutomationProperties.Name="Undo last batch" />
                </StackPanel>
                <!-- MaxWidth is a visual cap now, not the overflow guard it
                     used to be — DockPanel's fill mechanism already bounds
                     this TextBlock to whatever the buttons above left, so
                     TextTrimming engages regardless — kept at 240 to match
                     every sibling tool's own AddNote (ZipToolsWindow/
                     MergePdfsWindow/PageCountsWindow). TrimmedTextTooltip
                     opted in explicitly (this TextBlock is CaptionText, not
                     GridCellText, so it doesn't inherit the grid cells' own
                     default): fix round 1 — a note trimmed at 240px with no
                     tooltip left its tail unreachable, the exact complaint
                     Rule 4 exists to cure, one row above the grid it already
                     cures it in. -->
                <TextBlock Text="{Binding AddNote}"
                           Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                           MaxWidth="240" TextTrimming="CharacterEllipsis"
                           views:TrimmedTextTooltip.Enabled="True" />
            </DockPanel>

            <Grid Grid.Row="1">
                <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding Results}" AutoGenerateColumns="False"
                          AutomationProperties.Name="Standardised files"
                          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                          SelectionMode="Extended" SelectionChanged="OnSelectionChanged">
                    <!-- Theme.RowHover so the hover tint stays consistent
                         app-wide, same as ZipToolsWindow/MergePdfsWindow. -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Theme.RowHover}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <!-- Current name: the filler (Width="*") — the
                             file's name as it was AT DROP TIME, the least
                             predictable string in the row. Used to wrap, not
                             trim; table-rules Rule 4 reverses that app-wide —
                             trims with an ellipsis instead, and shows the
                             full name as a tooltip once it actually is
                             trimmed, both now inherited from
                             GridCellTextSelectionAware's own base. -->
                        <DataGridTextColumn Header="Current name" Binding="{Binding Current}"
                                            Width="*" MinWidth="180">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextSelectionAware}" />
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- Result: content-sized; DataGridColumnCap
                             (code-behind) gives it its content width when
                             that fits beside Current name, and a
                             proportional, trimmed share (table-rules Rule 4 —
                             used to say "wrapped" here) when it doesn't —
                             same mechanism as MergePdfsWindow/ZipToolsWindow's
                             own Result column. Failed is Theme.StatusRed — a
                             genuine failure. Skipped is Theme.StatusAmber —
                             "needs attention" (status-colour-vocabulary
                             plan): PlanTidy turned the name away rather than
                             producing one. Unchanged is Theme.SubtleText —
                             informational, not a problem: the file was
                             already exactly right. Renamed (the ordinary,
                             successful case) gets no trigger at all, the
                             same plain-text default a successful row already
                             has in every sibling tool's own Result column. -->
                        <DataGridTextColumn x:Name="ResultColumn" Header="Result" Binding="{Binding Result}"
                                            Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}"
                                                     Value="{x:Static vm:StandardiseRowStatus.Failed}">
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.StatusRed}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}"
                                                     Value="{x:Static vm:StandardiseRowStatus.Skipped}">
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.StatusAmber}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}"
                                                     Value="{x:Static vm:StandardiseRowStatus.Unchanged}">
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.SubtleText}" />
                                        </DataTrigger>
                                        <!-- Let selection win — same measured trap and
                                             same fix as every sibling tool's own Result/
                                             Note column; declared last so it overrides
                                             every trigger above once selected. -->
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <Binding Path="IsSelected"
                                                         RelativeSource="{RelativeSource AncestorType=DataGridCell}" />
                                            </DataTrigger.Binding>
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource Theme.AccentText}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Drag files anywhere on this window, or click Add files…"
                           Style="{StaticResource EmptyStateText}"
                           IsHitTestVisible="False">
                    <TextBlock.Visibility>
                        <Binding Path="Results.Count" Converter="{StaticResource ZeroToVis}" />
                    </TextBlock.Visibility>
                </TextBlock>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
