<Window x:Class="OrdoSort.Wpf.Windows.UnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OrdoSort.Wpf.ViewModels"
        Title="OrdoSort — Unlock PDFs" Width="620" Height="660" MinWidth="540" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" AllowDrop="True"
        DragOver="OnDragOver" Drop="OnDrop"
        Style="{StaticResource {x:Type Window}}">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Command="{Binding UnlockCommand}"
                    Style="{StaticResource PrimaryButton}" Width="110" Margin="0,0,8,0"
                    IsDefault="True"
                    AutomationProperties.Name="Unlock">
                <StackPanel Orientation="Horizontal">
                    <!-- Same glyph as this tool's own Tools menu entry
                         (MainWindow.xaml, "_Unlock PDFs…") — E785. -->
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE785;" Margin="0,0,8,0"
                               Foreground="{DynamicResource Theme.AccentText}" />
                    <TextBlock Text="Unlock" Style="{StaticResource PrimaryButtonLabel}" />
                </StackPanel>
            </Button>
            <!-- the batch's brake: files already done stay done, the rest
                 report cancelled instead of running on unstoppably -->
            <Button Content="Cancel" Command="{Binding CancelCommand}" Width="96"
                    Margin="0,0,8,0"
                    Visibility="{Binding IsUnlocking, Converter={StaticResource BoolToVis}}" />
            <Button Content="Manage saved…" Click="OnManageSaved" Padding="8,4" Margin="0,0,8,0" />
            <Button Content="Close" Width="96" IsCancel="True" />
        </StackPanel>

        <!-- IsSharedSizeScope: only one FieldRow lives in this window today
             (Password:, below), but it follows the LabelMakerWindow.xaml
             SharedSizeGroup="LabelCol" pattern anyway (spacing-rhythm audit
             B2) so the label sizes to its content instead of a fixed width,
             and so any FieldRow added here later joins the same scope for
             free. -->
        <Grid Grid.IsSharedSizeScope="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="PDFs to unlock:" Style="{StaticResource SectionHeaderFirst}" />
            <Grid Grid.Row="1">
                <ListBox x:Name="FileList" ItemsSource="{Binding Files}"
                         SelectionMode="Extended" MinHeight="120"
                         AutomationProperties.Name="PDFs to unlock"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <!-- Stretch + h-scroll Disabled: the row template below is a
                         DockPanel whose FileName ellipsis only engages when the
                         item is pinned to the viewport width (see RouteList's
                         ItemContainerStyle comment for the BasedOn). -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- The row is an UnlockFileRow (path + readiness-
                                 probe state). FileName and Note used to be one
                                 concatenated DisplayText string; split in two
                                 (status-colour-vocabulary plan, 2026-08-08, Task 1
                                 Step 2) specifically so the NOTE alone can carry a
                                 status colour without tinting the filename next to
                                 it — DisplayText still exists (UnlockViewModel.cs)
                                 only because two test suites assert the combined
                                 string; nothing here binds to it anymore.
                                 ToolTipText is unchanged: the full path, plus the
                                 probe's own message on a second line for the four
                                 states worth mentioning.

                                 BOTH TextBlocks below need their own LOCAL
                                 Foreground binding back to the generated
                                 ListBoxItem: an ItemTemplate assigns to the
                                 container's ContentTemplate as a LOCAL value,
                                 which outranks even Styles.xaml's ListBoxItem
                                 style's own ContentTemplate Setter — so every
                                 element in this template is exactly as exposed to
                                 the "Style Setter outranks inheritance" trap
                                 (Styles.xaml's implicit TextBlock style pins
                                 Foreground=Theme.Text) as the single TextBlock
                                 this template used to be; adding a second element
                                 without its own copy of this binding would have
                                 left it stuck on Theme.Text even when selected
                                 (see Styles.xaml's ListBoxItem comment).

                                 The note's own Style carries no base Foreground
                                 Setter (Note is only ever non-empty for the four
                                 statuses a DataTrigger below covers — Pending and
                                 NotEncrypted stay text-empty, so their fallback
                                 colour is never actually seen) and sets the
                                 vocabulary colour per-Status, with one more
                                 DataTrigger declared LAST: IsSelected=True
                                 re-sets Foreground to Theme.AccentText — the SAME
                                 value Styles.xaml's own ListBoxItem style already
                                 flips the container's Foreground to on selection.
                                 WPF applies every matching trigger in declaration
                                 order and the LAST one wins, so this is what
                                 makes selection win over a fixed status colour
                                 instead of the reverse (the "Two traps this plan
                                 exists to navigate" #2: a status colour left in
                                 place through selection sits on the Accent
                                 background unreadably — measured 1.28-2.51:1
                                 with this trigger removed, see the Task 1
                                 report's teeth-proof). Do not go looking for a
                                 colour that passes against BOTH Theme.Surface and
                                 Theme.Accent instead — that is the exact hunt
                                 this plan says not to make; let selection win.

                                 Unreadable uses Theme.StatusRed, NOT
                                 Theme.Danger: Danger AS FOREGROUND TEXT (its
                                 shipped job elsewhere is a BACKGROUND, paired
                                 with DangerText) measures only 2.69:1 against
                                 Dark.Surface — found while building this note,
                                 the exact Success-shaped problem Step 1 already
                                 fixed once, on a different token. See
                                 ThemePalette.cs's StatusRed field comment. -->
                            <!-- DockPanel, not a horizontal StackPanel: FileName's
                                 ellipsis only engages at a finite width
                                 (TextWrapCoverageTests); the tooltip carries the
                                 full path, and the status Note docks right. -->
                            <DockPanel ToolTip="{Binding ToolTipText}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Note}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}"
                                                             Value="{x:Static vm:ReadinessStatus.Ready}">
                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.StatusGreen}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}"
                                                             Value="{x:Static vm:ReadinessStatus.NeedsPassword}">
                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.StatusAmber}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}"
                                                             Value="{x:Static vm:ReadinessStatus.InUse}">
                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.StatusAmber}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}"
                                                             Value="{x:Static vm:ReadinessStatus.Unreadable}">
                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.StatusRed}" />
                                                </DataTrigger>
                                                <!-- Declared LAST so it wins over whichever
                                                     status trigger above also matches — see
                                                     the template comment above for why. -->
                                                <DataTrigger Binding="{Binding IsSelected,
                                                                 RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                             Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.AccentText}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False" Background="{DynamicResource Theme.Surface}"
                        BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
                        CornerRadius="4" Padding="16">
                    <Border.Visibility>
                        <Binding Path="Files.Count" Converter="{StaticResource ZeroToVis}" />
                    </Border.Visibility>
                    <StackPanel>
                        <ContentControl Template="{StaticResource Illustration.Unlock}"
                                         Height="80" Margin="0,0,0,8" />
                        <TextBlock Text="Drag PDFs anywhere on this window, or press Add files…"
                                   Style="{StaticResource SubtleText}" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <DockPanel Grid.Row="2" Margin="0,8,0,8">
                <Button Content="Add files…" Click="OnAddFiles" Margin="0,0,6,0" />
                <Button Content="Remove selected" Click="OnRemoveSelected" Margin="0,0,6,0"
                        IsEnabled="{Binding IsIdle}" />
                <Button Content="Clear" Command="{Binding ClearCommand}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding AddNote}" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <Grid Grid.Row="3" Style="{StaticResource FieldRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Password:" Style="{StaticResource FieldLabel}" />
                <PasswordBox Grid.Column="1" x:Name="PwBox" PasswordChanged="OnPasswordChanged"
                             AutomationProperties.Name="Password" />
                <TextBox Grid.Column="1" x:Name="PwPlain" Visibility="Collapsed"
                         Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Password (visible)" />
                <CheckBox Grid.Column="2" x:Name="ShowPw" Content="Show" Margin="8,0,0,0"
                          VerticalAlignment="Center" Checked="OnShowPw" Unchecked="OnShowPw" />
            </Grid>

            <!-- direct Grid child on purpose: this used to sit in a horizontal
                 StackPanel, whose infinite-width measure silently defeated the
                 Wrap and ran the sentence off screen (TextWrapCoverageTests) -->
            <TextBlock Grid.Row="4" Style="{StaticResource CaptionText}"
                       TextWrapping="Wrap" Margin="0,0,0,6"
                       Text="Every saved password is tried automatically, in addition to whatever's typed above. The unlocked file keeps its name and place — the locked original is moved to a dated locked_archive folder beside it, nothing is overwritten." />

            <!-- appears only after a run where the TYPED password (not a
                 saved one) unlocked something new — the one-click offer to
                 save it, so it auto-tries next time too -->
            <Border Grid.Row="5" x:Name="SaveBanner" Background="{DynamicResource Theme.Surface}"
                    BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
                    CornerRadius="4" Padding="10,8" Margin="0,0,0,10"
                    IsVisibleChanged="OnSaveBannerVisibilityChanged"
                    Visibility="{Binding SaveBannerVisible, Converter={StaticResource BoolToVis}}">
                <!-- DockPanel, not a horizontal StackPanel: the banner prompt
                     wraps at a finite width instead of pushing the name box and
                     Save off screen (TextWrapCoverageTests) -->
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Save"
                            Command="{Binding SaveBannerCommand}" Margin="8,0,0,0" />
                    <!-- Enter here means Save, never "run the batch again":
                         the Unlock button is IsDefault, and UnlockAsync calls
                         ResetBanner at the start of every run, so falling
                         through would restart the whole batch AND wipe the
                         offer being answered. See OnSaveNameKeyDown. -->
                    <TextBox DockPanel.Dock="Right" Width="150"
                             Text="{Binding SaveBannerName, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Save password as" VerticalAlignment="Center"
                             PreviewKeyDown="OnSaveNameKeyDown" />
                    <TextBlock Text="{Binding SaveBannerText}" VerticalAlignment="Center"
                               TextWrapping="Wrap" Margin="0,0,10,0" />
                </DockPanel>
            </Border>

            <TextBlock Grid.Row="6" Text="{Binding Summary}" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,0,0,4" />
            <Border Grid.Row="7" Background="{DynamicResource Theme.Surface}"
                    BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
                    CornerRadius="4">
                <!-- Ok -> Theme.StatusGreen added (status-colour-vocabulary
                     plan, 2026-08-08, Task 3 Step 1): the vocabulary's
                     "good/ready/done" row. Fail stays Theme.StatusAmber
                     (needs-attention — CopyAndTerminologyTests.cs:183-484
                     locks that meaning for Settings' notes, and this list
                     must not contradict it) and Skip stays
                     Theme.SubtleText (informational).

                     No "let selection win" trigger here, unlike the FileList
                     ListBox above: this is a plain ItemsControl, not a
                     Selector, so its generated containers are bare
                     ContentPresenters with no IsSelected concept at all —
                     verified by reading ItemsControl's own type (Selector,
                     which ListBox/ListBoxItem derive from and which is what
                     actually carries IsSelected, is a DIFFERENT, more
                     derived class ItemsControl does not implement) and by
                     the complete absence of any SelectionMode/IsSelected
                     property on the ItemsControl or DataTemplate above —
                     not assumed from "it looks read-only". A fixed status
                     colour here has no accent background to ever collide
                     with. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,6">
                    <ItemsControl x:Name="ResultList" ItemsSource="{Binding ResultLines}"
                                  AutomationProperties.Name="Results">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}"
                                                             Value="{x:Static vm:UnlockResultKind.Ok}">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource Theme.StatusGreen}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}"
                                                             Value="{x:Static vm:UnlockResultKind.Fail}">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource Theme.StatusAmber}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}"
                                                             Value="{x:Static vm:UnlockResultKind.Skip}">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource Theme.SubtleText}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
