<Window x:Class="OrdoSort.Wpf.Windows.ManageSavedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrdoSort — Manage saved passwords" Width="420" Height="420" MinWidth="380" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource {x:Type Window}}">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Close" Width="96" IsCancel="True" IsDefault="True" />
        </StackPanel>

        <StackPanel>
            <TextBlock Text="Saved passwords" FontWeight="Bold" Margin="0,0,0,6" />
            <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Tried automatically on Unlock. Encrypted for this Windows account — a hand-edited plaintext value is encrypted the next time saved passwords change here (add or remove)." />
            <ListBox ItemsSource="{Binding Saved}" SelectedItem="{Binding SelectedSavedEntry}"
                     Height="150">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Password, Converter={StaticResource PasswordStatus},
                                              StringFormat='   ({0})'}"
                                       Style="{StaticResource SubtleText}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Name (e.g. the sender):" Style="{StaticResource SubtleText}"
                           FontSize="11" Margin="0,0,0,6" />
                <TextBlock Grid.Column="1" Text="Password:" Style="{StaticResource SubtleText}"
                           FontSize="11" Margin="0,0,0,6" />
                <TextBox x:Name="NewPwLabel" Grid.Row="1" Margin="0,0,6,0"
                         AutomationProperties.Name="New password label" />
                <PasswordBox x:Name="NewPwValue" Grid.Row="1" Grid.Column="1" Margin="0,0,6,0"
                             AutomationProperties.Name="New password" />
                <Button Grid.Row="1" Grid.Column="2" Content="Add" Click="OnAddPassword"
                        MinWidth="52" Margin="0,0,6,0" />
                <Button Grid.Row="1" Grid.Column="3" Content="Remove"
                        Command="{Binding RemoveSavedCommand}" />
            </Grid>
            <TextBlock x:Name="PwHint" Style="{StaticResource StatusText}" Margin="0,6,0,0" />
        </StackPanel>
    </DockPanel>
</Window>
