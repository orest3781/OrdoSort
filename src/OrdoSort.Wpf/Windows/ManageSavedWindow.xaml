<Window x:Class="OrdoSort.Wpf.Windows.ManageSavedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrdoSort — Manage saved passwords" Width="420" Height="420" MinWidth="380" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource {x:Type Window}}">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Close" Width="96" IsCancel="True" IsDefault="True" />
        </StackPanel>

        <!-- DockPanel, not a vertical StackPanel: with everything stacked and
             the list at a FIXED height, the Add/Remove row and hint were the
             overflow — clipped off the window bottom at MinHeight and at
             larger app fonts (WindowOverflowTests). The list is the one
             element that scrolls internally, so IT takes the squeeze: entry
             row + hint dock to the bottom and the list fills what's left. -->
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Saved passwords" Style="{StaticResource SectionText}" Margin="0,0,0,6" />
            <!-- x:Name'd so ManageSavedWindowCopyTests can measure it
                 directly off-screen and prove it actually wraps instead of
                 clipping — this window's own vertical panel gives it
                 constrained width, unlike the horizontal-StackPanel trap
                 UnlockWindow.xaml has a documented history of (see that
                 test's own doc comment). -->
            <TextBlock DockPanel.Dock="Top" x:Name="StorageNote" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Tried automatically on Unlock. Stored as plain text in the shared config.json — anyone who can open that file can read them." />
            <TextBlock DockPanel.Dock="Bottom" x:Name="PwHint" Style="{StaticResource StatusText}" Margin="0,6,0,0" />
            <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Name (e.g. the sender):" Style="{StaticResource CaptionText}"
                           Margin="0,0,0,6" />
                <TextBlock Grid.Column="1" Text="Password:" Style="{StaticResource CaptionText}"
                           Margin="0,0,0,6" />
                <!-- PreviewKeyDown on BOTH fields, not a window-level Return
                     KeyBinding: Close carries IsDefault and this window is
                     opened with ShowDialog (UnlockWindow.OnManageSaved), so an
                     unhandled Enter here clicked Close and threw away both
                     typed fields (UI-08). The handler claims Enter for the two
                     boxes only, leaving Close's IsDefault intact everywhere
                     else in the dialog — same shape as UnlockWindow's
                     OnSaveNameKeyDown and Settings' alert-term box. -->
                <TextBox x:Name="NewPwLabel" Grid.Row="1" Margin="0,0,6,0"
                         PreviewKeyDown="OnEntryKeyDown"
                         AutomationProperties.Name="New password label" />
                <PasswordBox x:Name="NewPwValue" Grid.Row="1" Grid.Column="1" Margin="0,0,6,0"
                             PreviewKeyDown="OnEntryKeyDown"
                             AutomationProperties.Name="New password" />
                <Button Grid.Row="1" Grid.Column="2" Content="Add" Click="OnAddPassword"
                        MinWidth="52" Margin="0,0,6,0" />
                <Button Grid.Row="1" Grid.Column="3" Content="Remove"
                        Command="{Binding RemoveSavedCommand}" />
            </Grid>
            <!-- x:Name'd so ManageSavedEnterKeyTests can put keyboard focus
                 somewhere OUTSIDE the entry form and prove Enter there still
                 closes the window — i.e. that the Enter fix claimed the key
                 for the two fields rather than stripping Close's IsDefault. -->
            <ListBox x:Name="SavedList"
                     ItemsSource="{Binding Saved}" SelectedItem="{Binding SelectedSavedEntry}"
                     MinHeight="60"
                     AutomationProperties.Name="Saved passwords">
                <!-- Label gets a LOCAL Foreground bound back to the generated
                     ListBoxItem — see Styles.xaml's ListBoxItem style
                     comment: an ItemTemplate's LOCAL ContentTemplate
                     assignment outranks that style's own ContentTemplate
                     Setter, so only a call-site fix reaches it. The
                     password-status annotation is NOT given that same
                     blanket binding: it also carries
                     Style="{StaticResource SubtleText}" for its
                     de-emphasised at-rest look, and a LOCAL Foreground on
                     the SAME TextBlock as that Style's Setter would outrank
                     it, silently pinning it to full-emphasis Theme.Text
                     whenever the row is unselected (found in the
                     2026-08-02 theme-coverage final review). Fixed with a
                     conditional Style instead: BasedOn SubtleText so its
                     Setter still applies at rest, with a DataTrigger that
                     only overrides Foreground to Theme.AccentText while the
                     row is selected. -->
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                       Foreground="{Binding Foreground,
                                           RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            <TextBlock Text="{Binding Password, Converter={StaticResource PasswordStatus},
                                              StringFormat='   ({0})'}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubtleText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected,
                                                RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Theme.AccentText}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DockPanel>
</Window>
