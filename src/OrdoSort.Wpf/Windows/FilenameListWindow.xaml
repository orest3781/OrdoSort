<Window x:Class="OrdoSort.Wpf.Windows.FilenameListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OrdoSort.Wpf.Views"
        Title="OrdoSort — Filename list" Width="760" Height="560" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" AllowDrop="True"
        DragOver="OnDragOver" Drop="OnDrop"
        Style="{StaticResource {x:Type Window}}">
    <!-- Window-level so Ctrl+Z works with focus anywhere in here, not only on
         the grid — same shape as MainWindow's own Ctrl+Shift+Z. -->
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoRemovalCommand}" />
    </Window.InputBindings>
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Width="96" IsCancel="True" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Copy to clipboard" Click="OnCopy" Margin="0,0,8,0" />
                <!-- Content is BOUND, not literal: Save writes a .csv the moment any
                     data column is on (FilenameListViewModel.SaveLabel), and a
                     button promising ".txt" while the dialog offers ".csv" is the
                     one thing this tool's own rule forbids. PageCountsWindow's
                     identical-looking button keeps its literal correctly — that
                     tool only ever writes .txt. -->
                <Button Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding CountsLine}" VerticalAlignment="Center" Margin="0,0,10,0"
                           Style="{StaticResource SubtleText}" />
                <!-- CaptionText by default, amber only when the view model says the
                     message is a FAILURE (audit FL-06) — this is PageCountsWindow's
                     arrangement for the identical footer slot, which this window was
                     supposed to have followed and didn't. Spending amber on "Copied
                     12 names" left a real save failure looking exactly like a
                     success. TextTrimming rather than StatusText's wrapping also
                     stops a long "Couldn't save: <full path>" from growing the
                     footer and squeezing the grid above it. -->
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                           MaxWidth="240" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsProblem}" Value="True">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource Theme.StatusAmber}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- AddNote docks Right with a MaxWidth cap (the cap keeps its
                 ellipsis working in the infinite-width dock measure), and the
                 button/checkbox group is the WrapPanel fill child so it breaks
                 to a second line at the window's MinWidth instead of marching
                 off screen (WindowOverflowTests) -->
            <DockPanel Margin="0,0,0,10">
                <TextBlock DockPanel.Dock="Right" Text="{Binding AddNote}"
                           Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" MaxWidth="240"
                           TextTrimming="CharacterEllipsis" />
                <WrapPanel>
                    <Button Content="Browse folder…" Command="{Binding BrowseFolderCommand}" Margin="0,0,6,4" />
                    <Button Content="Browse files…" Command="{Binding BrowseFilesCommand}" Margin="0,0,6,4" />
                    <Button Content="Clear" Command="{Binding ClearCommand}" Margin="0,0,14,4" />
                    <CheckBox Content="Include subfolders" IsChecked="{Binding IncludeSubfolders}"
                              VerticalAlignment="Center" Margin="0,4,14,4" />
                    <CheckBox Content="Include extension" IsChecked="{Binding IncludeExtension}"
                              VerticalAlignment="Center" Margin="0,4" />
                </WrapPanel>
            </DockPanel>

            <!-- Its own row, not more items in the toolbar WrapPanel above:
                 that one already carries three buttons and two checkboxes,
                 and five more controls (Find box, Columns menu, sort
                 checkbox, Restore button) would wrap to a THIRD line at the
                 480px MinWidth WindowOverflowTests pins, not a tidy second
                 one. -->
            <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock Text="Find:" VerticalAlignment="Center" Margin="0,4,6,4" />
                <TextBox Width="140" VerticalAlignment="Center" Margin="0,4,14,4"
                         Text="{Binding NameFilter, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Find in this list" />
                <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,4,14,4">
                    <MenuItem Header="Columns ▾">
                        <MenuItem Header="Row number" IsCheckable="True"
                                  IsChecked="{Binding ShowNumber}" StaysOpenOnClick="True" />
                        <MenuItem Header="Pages" IsCheckable="True"
                                  IsChecked="{Binding ShowPages}" StaysOpenOnClick="True" />
                        <MenuItem Header="Size" IsCheckable="True"
                                  IsChecked="{Binding ShowSize}" StaysOpenOnClick="True" />
                        <MenuItem Header="Modified" IsCheckable="True"
                                  IsChecked="{Binding ShowModified}" StaysOpenOnClick="True" />
                        <MenuItem Header="Folder" IsCheckable="True"
                                  IsChecked="{Binding ShowFolder}" StaysOpenOnClick="True" />
                        <MenuItem Header="Full path" IsCheckable="True"
                                  IsChecked="{Binding ShowFullPath}" StaysOpenOnClick="True" />
                    </MenuItem>
                </Menu>
                <CheckBox Content="Z to A" IsChecked="{Binding Descending}"
                          VerticalAlignment="Center" Margin="0,4,14,4" />
                <Button Content="Restore removed" Command="{Binding RestoreRemovedCommand}" Margin="0,4" />
            </WrapPanel>

            <Grid Grid.Row="2" Style="{StaticResource FieldRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Only these types:" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Column="1" Margin="0,0,10,0"
                         Text="{Binding ExtensionFilter, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Only these file types" />
                <TextBlock Grid.Column="2" Text="pdf, docx — blank = all" VerticalAlignment="Center"
                           Style="{StaticResource SubtleText}" TextTrimming="CharacterEllipsis" />
            </Grid>

            <Grid Grid.Row="3">
                <DataGrid x:Name="NamesGrid" ItemsSource="{Binding Rows}"
                          AutomationProperties.Name="File names" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                          SelectionMode="Extended" AlternationCount="{Binding Rows.Count}"
                          AlternatingRowBackground="{x:Null}" CanUserSortColumns="False"
                          ClipboardCopyMode="None"
                          SelectionChanged="OnSelectionChanged" PreviewKeyDown="OnGridKeyDown">
                    <!-- AlternationCount is bound to Rows.Count rather than left at
                         Theme/Styles.xaml's implicit DataGrid style's default (WPF
                         only coerces it to 2 while the property is UNSET, so a
                         local binding here defeats that): the "#" column above
                         needs AlternationIndex to equal the row's actual position,
                         not a value cycling 0/1. That means AlternationIndex can no
                         longer double as a 2-cycle stripe index either — with the
                         count equal to the row total, only row index 1 could ever
                         land on the alternate brush, and every other row would
                         fall through to RowStyle's flat Transparent background,
                         which reads as a rendering bug (a single tinted row) rather
                         than as "striping is off". AlternatingRowBackground is
                         nulled out here so that trade is explicit: the row-number
                         column owns the alternation channel, on purpose, and this
                         grid does not stripe.

                         CanUserSortColumns is off for a different reason: the "#"
                         column's Binding is AlternationIndex, not a FileRow
                         property, so DataGridBoundColumn's derived SortMemberPath
                         for it names a member FileRow doesn't have — clicking that
                         header would throw or silently no-op depending on WPF's
                         mood. It would also be wrong even for a column that DID
                         sort cleanly: this window already has a sort control (the
                         Z to A checkbox above, bound to Descending), and letting
                         the grid's own header-click sorting run at the same time
                         would reorder Rows out from under it, so the on-screen "#"
                         would stop matching the numbering in whatever gets copied
                         or saved. Z to A is this window's only sort surface. -->
                    <!-- Local RowStyle, same shape as BulkRename/MatchMerge's own —
                         Theme.RowHover so the hover tint stays consistent app-wide. -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource Theme.RowHover}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Remove from list" Command="{Binding RemoveSelectedCommand}"
                                      InputGestureText="Del" />
                            <MenuItem Header="Undo last removal" Command="{Binding UndoRemovalCommand}"
                                      InputGestureText="Ctrl+Z" />
                            <Separator />
                            <MenuItem Header="Restore removed"  Command="{Binding RestoreRemovedCommand}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <!-- Rows is ObservableCollection<FilenameList.FileRow>, so each
                         column below binds one of ITS properties (Name, Size, …)
                         rather than the row item itself. Every column keeps BasedOn
                         GridCellTextSelectionAware (Theme/Styles.xaml), not plain
                         GridCellText: no status trigger of its own here, so the
                         shared style's default Foreground plus its own trailing
                         "let selection win" DataTrigger is the whole fix — same
                         shape as ZipToolsWindow's Zip column on its Merge PDFs tab.
                         Measured directly (off-screen, before this fix, plain
                         GridCellText): Theme.Text on Theme.Accent ranged
                         1.26:1-2.14:1 across every scheme, nowhere near the 4.5:1
                         floor — this window shipped with the exact selection-
                         contrast bug GridCellTextSelectionAware exists to prevent,
                         just never switched to it. -->
                    <!-- Five of these six columns are optional (Columns ▾ in the
                         toolbar above) and each carries an x:Name instead of a
                         Visibility binding. That is deliberate, not an oversight:
                         DataGridColumn is NOT part of the visual or logical tree
                         (it lives in DataGrid.Columns, a plain object collection),
                         so it has no DataContext and no ancestor a RelativeSource
                         could walk up to — Visibility="{Binding DataContext.ShowX,
                         RelativeSource={RelativeSource AncestorType=Window}}" on a
                         column binds to nothing, fails SILENTLY (WPF logs a bind
                         error nobody sees outside a debugger's Output window), and
                         the column stays visible forever. Same shape of problem as
                         SelectedPaths above (DataGrid.SelectedItems isn't bindable
                         either) and same shape of answer: the window pushes state
                         down imperatively instead of the column reaching up for
                         it. See the constructor and SyncColumnVisibility in
                         FilenameListWindow.xaml.cs. -->
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="NumberColumn" Header="#" Width="Auto" MinWidth="30"
                                            Binding="{Binding (ItemsControl.AlternationIndex),
                                              RelativeSource={RelativeSource AncestorType=DataGridRow},
                                              Converter={StaticResource PlusOne}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextSelectionAware}" />
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- TextTrimming and the trimmed-only ToolTip both now come
                             from GridCellTextSelectionAware's own base (Theme/
                             Styles.xaml's GridCellText, table-rules Rule 4) — this
                             column used to declare both itself, but its own ToolTip
                             only ever repeated Name, the SAME text the trimming was
                             already showing an ellipsis for, unconditionally (shown
                             even when Name fit and nothing was trimmed at all), which
                             is exactly the noise Rule 4 exists to stop. -->
                        <DataGridTextColumn Header="File name" Binding="{Binding Name}" Width="*" MinWidth="180">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextSelectionAware}" />
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Pages is the only column whose value is not known when the
                             row is built: it costs a PdfReader.Open, so it arrives
                             asynchronously and lands here as a row replacement. Bound to
                             PageCell rather than Pages so one cell can carry the count,
                             the "…" of a count in progress, or the reason a count failed,
                             with the export using that same property.
                             Used to be right-aligned — it is overwhelmingly a column of
                             numbers — but table-rules Rule 1 leaves no column, numeric
                             included, aligned anything but left; GridCellTextSelectionAware's
                             own default already puts it there. TrimmedTextTooltip.Enabled
                             is turned back off here (table-rules Rule 4): this column's
                             ToolTip deliberately shows PageNote, the count failure's OWN
                             reason text, not a repeat of PageCell — a genuinely different
                             field, the same shape as ZipToolsWindow/MergePdfsWindow/
                             PageCountsWindow's own full-PATH tooltips, so it keeps its
                             own unconditional Setter rather than the shared trimmed-only
                             one, which would otherwise silently take over ToolTip for
                             this cell (its own Enabled default is True) and show PageCell
                             a second time instead of PageNote. -->
                        <DataGridTextColumn x:Name="PagesColumn" Header="Pages"
                                            Binding="{Binding PageCell}" Width="Auto" MinWidth="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextSelectionAware}">
                                    <Setter Property="views:TrimmedTextTooltip.Enabled" Value="False" />
                                    <Setter Property="ToolTip" Value="{Binding PageNote}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn x:Name="SizeColumn" Header="Size" Binding="{Binding Size}"
                                            Width="Auto" MinWidth="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextSelectionAware}" />
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn x:Name="ModifiedColumn" Header="Modified" Width="Auto" MinWidth="120"
                                            Binding="{Binding Modified, StringFormat='yyyy-MM-dd HH:mm'}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextSelectionAware}" />
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- TextTrimming and the trimmed-only ToolTip both now come
                             from the shared base (Theme/Styles.xaml's GridCellText,
                             table-rules Rule 4) — see File name's own comment above
                             for why the unconditional same-field ToolTip this column
                             used to declare is gone rather than kept. -->
                        <DataGridTextColumn x:Name="FolderColumn" Header="Folder" Binding="{Binding Folder}"
                                            Width="Auto" MinWidth="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextSelectionAware}" />
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- TextTrimming and the trimmed-only ToolTip both now come
                             from the shared base (Theme/Styles.xaml's GridCellText,
                             table-rules Rule 4) — see File name's own comment above
                             for why the unconditional same-field ToolTip this column
                             used to declare is gone rather than kept. -->
                        <DataGridTextColumn x:Name="FullPathColumn" Header="Full path" Binding="{Binding FullPath}"
                                            Width="Auto" MinWidth="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextSelectionAware}" />
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <!-- Two empty states, distinguished the same way HistoryWindow's
                     are: a listing with nothing in it must not read the same as
                     one whose Find box has hidden every row. Bound to Rows.Count
                     alone (as this was), typing "zzz" in Find told a user with
                     200 files already listed to go and drag some files in. -->
                <TextBlock x:Name="EmptyListText"
                           Text="Drag files or folders here, or browse…"
                           Style="{StaticResource EmptyStateText}"
                           IsHitTestVisible="False">
                    <TextBlock.Visibility>
                        <Binding Path="IsEmpty" Converter="{StaticResource BoolToVis}" />
                    </TextBlock.Visibility>
                </TextBlock>
                <TextBlock x:Name="NoMatchesText"
                           Text="Nothing to show — filtered out, removed, or the folder was empty."
                           Style="{StaticResource EmptyStateText}"
                           IsHitTestVisible="False">
                    <TextBlock.Visibility>
                        <Binding Path="NoMatches" Converter="{StaticResource BoolToVis}" />
                    </TextBlock.Visibility>
                </TextBlock>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
