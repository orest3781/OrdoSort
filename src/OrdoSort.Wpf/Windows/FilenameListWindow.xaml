<Window x:Class="OrdoSort.Wpf.Windows.FilenameListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrdoSort — Filename list" Width="640" Height="560" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" AllowDrop="True"
        DragOver="OnDragOver" Drop="OnDrop"
        Style="{StaticResource {x:Type Window}}">
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Width="96" IsCancel="True" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Copy to clipboard" Click="OnCopy" Margin="0,0,8,0" />
                <Button Content="Save as .txt…" Command="{Binding SaveCommand}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding CountsLine}" VerticalAlignment="Center" Margin="0,0,10,0"
                           Style="{StaticResource SubtleText}" />
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                           Style="{StaticResource StatusText}" MaxWidth="240" />
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- AddNote docks Right with a MaxWidth cap (the cap keeps its
                 ellipsis working in the infinite-width dock measure), and the
                 button/checkbox group is the WrapPanel fill child so it breaks
                 to a second line at the window's MinWidth instead of marching
                 off screen (WindowOverflowTests) -->
            <DockPanel Margin="0,0,0,10">
                <TextBlock DockPanel.Dock="Right" Text="{Binding AddNote}"
                           Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" MaxWidth="240"
                           TextTrimming="CharacterEllipsis" />
                <WrapPanel>
                    <Button Content="Browse folder…" Command="{Binding BrowseFolderCommand}" Margin="0,0,6,4" />
                    <Button Content="Clear" Command="{Binding ClearCommand}" Margin="0,0,14,4" />
                    <CheckBox Content="Include subfolders" IsChecked="{Binding IncludeSubfolders}"
                              VerticalAlignment="Center" Margin="0,4,14,4" />
                    <CheckBox Content="Include extension" IsChecked="{Binding IncludeExtension}"
                              VerticalAlignment="Center" Margin="0,4" />
                </WrapPanel>
            </DockPanel>

            <Grid Grid.Row="1" Style="{StaticResource FieldRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Only these types:" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Column="1" Margin="0,0,10,0"
                         Text="{Binding ExtensionFilter, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="2" Text="pdf, docx — blank = all" VerticalAlignment="Center"
                           Style="{StaticResource SubtleText}" TextTrimming="CharacterEllipsis" />
            </Grid>

            <Grid Grid.Row="2">
                <DataGrid x:Name="NamesGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                          SelectionMode="Extended">
                    <!-- Local RowStyle, same shape as BulkRename/MatchMerge's own —
                         Theme.RowHover so the hover tint stays consistent app-wide. -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource Theme.RowHover}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <!-- Rows is a plain ObservableCollection<string>: the empty
                             Binding path targets the row item itself. BasedOn
                             GridCellTextSelectionAware (Theme/Styles.xaml), not
                             plain GridCellText: no status trigger of its own
                             here, so the shared style's default Foreground plus
                             its own trailing "let selection win" DataTrigger is
                             the whole fix — same shape as ZipToolsWindow's Zip
                             column on its Merge PDFs tab. Measured directly (off-screen, before this
                             fix, plain GridCellText): Theme.Text on Theme.Accent
                             ranged 1.26:1-2.14:1 across every scheme, nowhere
                             near the 4.5:1 floor — this window shipped with the
                             exact selection-contrast bug GridCellTextSelectionAware
                             exists to prevent, just never switched to it. -->
                        <!-- MinWidth: the only column in this grid, so nothing
                             competes for width and this floor never binds today.
                             Stated anyway so every filler in the app declares its
                             floor — the cap formula reads these, and a filler
                             without one silently contributes WPF's 20px default.
                             See PageCountsWindow.xaml. -->
                        <DataGridTextColumn Header="File name" Binding="{Binding}" Width="*" MinWidth="180">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextSelectionAware}">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Drag files or folders here, or browse…"
                           Style="{StaticResource EmptyStateText}"
                           IsHitTestVisible="False">
                    <TextBlock.Visibility>
                        <Binding Path="Rows.Count" Converter="{StaticResource ZeroToVis}" />
                    </TextBlock.Visibility>
                </TextBlock>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
