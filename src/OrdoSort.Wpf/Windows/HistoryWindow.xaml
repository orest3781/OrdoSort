<Window x:Class="OrdoSort.Wpf.Windows.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrdoSort — History" Width="980" Height="640" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource {x:Type Window}}">
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Find:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Find in history" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <!-- IsCancel: Esc closes, like every other tool window -->
            <Button Content="Close" Width="96" IsCancel="True" DockPanel.Dock="Right" />
            <Button Command="{Binding ExportCommand}"
                    DockPanel.Dock="Right" Margin="0,0,8,0"
                    AutomationProperties.Name="Export to spreadsheet">
                <StackPanel Orientation="Horizontal">
                    <!-- Same glyph as the identical File menu command
                         (MainWindow.xaml, "_Export history to
                         spreadsheet…") — E74E. -->
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" Margin="0,0,8,0" />
                    <TextBlock Text="Export to spreadsheet…" />
                </StackPanel>
            </Button>
            <Button Content="Show all" Command="{Binding ShowAllCommand}"
                    DockPanel.Dock="Right" Margin="0,0,8,0"
                    Visibility="{Binding CanShowAll, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding FooterText}" VerticalAlignment="Center"
                       Style="{StaticResource SubtleText}" />
        </DockPanel>

        <Grid>
            <!-- x:Name: HistoryWindow.xaml.cs tracks this grid's own live
                 ActualWidth (DataGridColumnCap.Track) to keep When/Name/
                 Destination's caps correct as the window is resized. -->
            <DataGrid x:Name="HistoryGrid" ItemsSource="{Binding RowsView}"
                      AutomationProperties.Name="Filing history" AutoGenerateColumns="False"
                      IsReadOnly="True" HeadersVisibility="Column"
                      SelectionMode="Single" CanUserAddRows="False">
                <!-- Local RowStyle, BasedOn the shared GridRow style
                     (Theme/Styles.xaml) — GridRow carries the
                     Background="Transparent" Setter and the IsMouseOver→
                     Theme.RowHover trigger this window used to declare
                     itself; only the genuinely local Reverted trigger is
                     left here.

                     The Reverted DataTrigger's Foreground Setter below was
                     DEAD from the day it shipped, the same trap Match & Merge
                     already had fixed once (see MatchMergeWindow.xaml's own
                     comment on this exact mechanism): Styles.xaml's
                     DataGridCell style always sets the CELL's own Foreground
                     via its own Style.Triggers block, which outranks whatever
                     the cell would otherwise inherit from its row — so a
                     Reverted row's text never actually turned SubtleText,
                     ever, only italic (FontStyle isn't touched by
                     DataGridCell's style, so that half worked, which is why
                     nobody noticed the other half didn't). Removed here; the
                     working replacement is each text column's own
                     ElementStyle below (When/Original/Filed as/Name/
                     Destination), the identical per-column technique Match &
                     Merge's Note column and Bulk rename's New name/Note
                     columns already use. No test caught this before —
                     covered now (HistoryWindow tests, hover-tint strength
                     review round 2). -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource GridRow}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Reverted}" Value="True">
                                <Setter Property="FontStyle" Value="Italic" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <!-- Every text column's ElementStyle below is BasedOn plain
                     GridCellText (Theme/Styles.xaml), NOT
                     GridCellTextSelectionAware and not the bare
                     {x:Type TextBlock} style — same shared base
                     MatchMergeWindow/BulkRenameWindow's status-coloured
                     columns use. All five of these columns carry their own
                     Reverted DataTrigger (below), so none of them qualify as
                     "no other Foreground trigger" — each keeps its own
                     trailing "let selection win" DataTrigger too, declared
                     last so it wins over Reverted once selected — see
                     GridCellTextSelectionAware's own doc comment in
                     Theme/Styles.xaml on why that trigger can't just live in
                     the shared base for columns like these. -->
                <DataGrid.Columns>
                    <!-- When: a 16-character timestamp History formats itself
                         — bounded content, so it is sized to itself and left
                         out of DataGridColumnCap's split (2026-08-29); the
                         four text columns below are the participants. -->
                    <DataGridTextColumn x:Name="WhenColumn" Header="When" Binding="{Binding When}"
                                        Width="Auto">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                <Style.Triggers>
                                    <!-- the working replacement for the dead
                                         RowStyle trigger removed above — see
                                         this DataGrid.RowStyle's own comment. -->
                                    <DataTrigger Binding="{Binding Reverted}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Theme.SubtleText}" />
                                    </DataTrigger>
                                    <!-- Let selection win — same trap and same fix
                                         as MatchMergeWindow.xaml's Note column:
                                         a Style Setter on THIS TextBlock always
                                         outranks what it would otherwise inherit
                                         from the DataGridCell's own IsSelected
                                         trigger. Declared last so it overrides
                                         the trigger above once selected. -->
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <Binding Path="IsSelected"
                                                     RelativeSource="{RelativeSource AncestorType=DataGridCell}" />
                                        </DataTrigger.Binding>
                                        <Setter Property="Foreground" Value="{DynamicResource Theme.AccentText}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <!-- MinWidth="120": a DataGridColumn's default MinWidth is
                         20px, and a Show() that's never subsequently resized
                         (this app's own headless Screenshots.cs QA tool; any
                         other headless/CI render) can leave Width="*" columns
                         stuck at that bare 20px forever — WPF only recomputes
                         star-column widths from a genuine later SizeChanged,
                         which a real on-screen window gets for free
                         (WM_SIZE/WM_ACTIVATE) but a headless
                         Show()+UpdateLayout() never does. At this window's
                         DEFAULT size (980px), a real, interactively-shown
                         window is unaffected either way (confirmed:
                         screenshotting the live app resolves these to their
                         fair share, ~222px each, 0 rows and 5 rows alike).
                         This floor is NOT just a QA-harness accommodation,
                         though: measured (2026-08-02 audit-remediation, with
                         the four columns to the right still fixed-pixel then)
                         with a real on-screen resize down to this window's
                         own MinWidth (700px above) — pre-fix, a real user
                         shrinking the window that far fair-shares these two
                         columns down to 82px each; post-fix, the same resize
                         clamps them to this 120px floor instead. That
                         specific on-screen number was NOT re-measured for
                         2026-08-07's change (this session cannot drive a real
                         on-screen resize — see task-1-report.md) but the
                         underlying math only improves it: When/Name/
                         Destination are now capped-Auto rather than always
                         reserving their old full fixed width, so Original/
                         Filed-as have at least as much room to fair-share at
                         any window size as they did before, never less.
                         Since 2026-08-29 the same 120px is also the floor of
                         these two columns' share in DataGridColumnCap's
                         proportional split, and they wrap rather than trim
                         when they give way. -->
                    <DataGridTextColumn Header="Original" Binding="{Binding Original}" Width="*" MinWidth="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Style.Triggers>
                                    <!-- same Reverted/"let selection win" pair as
                                         the When column above. -->
                                    <DataTrigger Binding="{Binding Reverted}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Theme.SubtleText}" />
                                    </DataTrigger>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <Binding Path="IsSelected"
                                                     RelativeSource="{RelativeSource AncestorType=DataGridCell}" />
                                        </DataTrigger.Binding>
                                        <Setter Property="Foreground" Value="{DynamicResource Theme.AccentText}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Filed as" Binding="{Binding FiledAs}" Width="*" MinWidth="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Style.Triggers>
                                    <!-- same Reverted/"let selection win" pair as
                                         the When column above. -->
                                    <DataTrigger Binding="{Binding Reverted}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Theme.SubtleText}" />
                                    </DataTrigger>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <Binding Path="IsSelected"
                                                     RelativeSource="{RelativeSource AncestorType=DataGridCell}" />
                                        </DataTrigger.Binding>
                                        <Setter Property="Foreground" Value="{DynamicResource Theme.AccentText}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <!-- Name and Destination: content-sized; DataGridColumnCap
                         gives each its content width when the four text
                         columns fit and a proportional share — wrapped,
                         never trimmed — when they don't (2026-08-29). -->
                    <DataGridTextColumn x:Name="NameColumn" Header="Name" Binding="{Binding Name}"
                                        Width="Auto">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Style.Triggers>
                                    <!-- same Reverted/"let selection win" pair as
                                         the When column above. -->
                                    <DataTrigger Binding="{Binding Reverted}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Theme.SubtleText}" />
                                    </DataTrigger>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <Binding Path="IsSelected"
                                                     RelativeSource="{RelativeSource AncestorType=DataGridCell}" />
                                        </DataTrigger.Binding>
                                        <Setter Property="Foreground" Value="{DynamicResource Theme.AccentText}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <!-- Header="Destination", Binding=Route (2026-08-02 audit
                         finding I4, Task 9). "Destination" is the word the app
                         shows a user everywhere else — Settings' tab, its
                         buttons and its validation text. "Route" is the
                         INTERNAL name and stays: the `routes` config key, the
                         Route/RouteButtonViewModel types, HistoryRow.Route and
                         the history table's own route_label/route_path
                         columns. The CSV export writes those column names
                         verbatim (History.Columns) and is machine-read, so it
                         does NOT follow this rename. -->
                    <DataGridTextColumn x:Name="DestinationColumn" Header="Destination" Binding="{Binding Route}"
                                        Width="Auto">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Style.Triggers>
                                    <!-- same Reverted/"let selection win" pair as
                                         the When column above. -->
                                    <DataTrigger Binding="{Binding Reverted}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Theme.SubtleText}" />
                                    </DataTrigger>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <Binding Path="IsSelected"
                                                     RelativeSource="{RelativeSource AncestorType=DataGridCell}" />
                                        </DataTrigger.Binding>
                                        <Setter Property="Foreground" Value="{DynamicResource Theme.AccentText}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <!-- Undone: a checkbox glyph plus a five-letter header —
                         Width="Auto" sizes to that on its own with no
                         realistic way to grow large, so it's left uncapped. -->
                    <!-- ElementStyle, not a column-level AutomationProperties.Name: the
                         column header is chrome, and the thing a screen reader lands
                         on is the per-row CheckBox, which otherwise announces only
                         "checkbox, checked" with no idea what was undone (UI-04). -->
                    <DataGridCheckBoxColumn Header="Undone" Binding="{Binding Reverted}" Width="Auto">
                        <DataGridCheckBoxColumn.ElementStyle>
                            <Style TargetType="CheckBox">
                                <Setter Property="AutomationProperties.Name" Value="Undone" />
                            </Style>
                        </DataGridCheckBoxColumn.ElementStyle>
                    </DataGridCheckBoxColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Empty states: distinguished so a history that's never had
                 anything filed into it doesn't read the same as a search
                 that just came up empty. -->
            <TextBlock x:Name="EmptyHistoryText"
                       Text="No filings recorded yet. Documents you file will appear here."
                       Style="{StaticResource EmptyStateText}">
                <TextBlock.Visibility>
                    <Binding Path="IsEmpty" Converter="{StaticResource BoolToVis}" />
                </TextBlock.Visibility>
            </TextBlock>
            <TextBlock x:Name="NoMatchesText"
                       Text="No filings match your search."
                       Style="{StaticResource EmptyStateText}">
                <TextBlock.Visibility>
                    <Binding Path="NoMatches" Converter="{StaticResource BoolToVis}" />
                </TextBlock.Visibility>
            </TextBlock>
        </Grid>
    </DockPanel>
</Window>
