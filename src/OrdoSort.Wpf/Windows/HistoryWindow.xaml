<Window x:Class="OrdoSort.Wpf.Windows.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrdoSort — History" Width="980" Height="640" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}">
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Find:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Find in history" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <!-- IsCancel: Esc closes, like every other tool window -->
            <Button Content="Close" Width="96" IsCancel="True" DockPanel.Dock="Right" />
            <Button Content="Export to spreadsheet…" Command="{Binding ExportCommand}"
                    DockPanel.Dock="Right" Margin="0,0,8,0" />
            <Button Content="Show all" Command="{Binding ShowAllCommand}"
                    DockPanel.Dock="Right" Margin="0,0,8,0"
                    Visibility="{Binding CanShowAll, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding FooterText}" VerticalAlignment="Center"
                       Style="{StaticResource SubtleText}" />
        </DockPanel>

        <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column"
                  SelectionMode="Single" CanUserAddRows="False">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Reverted}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.SubtleText}" />
                            <Setter Property="FontStyle" Value="Italic" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="When" Binding="{Binding When}" Width="140" />
                <!-- MinWidth: a DataGridColumn's default MinWidth is 20px, and
                     a Show() that's never subsequently resized (this app's own
                     headless Screenshots.cs QA tool; any other headless/CI
                     render) can leave Width="*" columns stuck at that bare
                     20px forever — WPF only recomputes star-column widths
                     from a genuine later SizeChanged, which a real on-screen
                     window gets for free (WM_SIZE/WM_ACTIVATE) but a headless
                     Show()+UpdateLayout() never does. A real, interactively-
                     shown window is unaffected either way (confirmed:
                     screenshotting the live app resolves these to their fair
                     share, 0 rows and 5 rows alike) — this floor exists so
                     the one path that IS affected still shows a legible
                     filename prefix instead of hiding it entirely. See
                     .superpowers/sdd/2026-08-02-audit-remediation/task-1-report.md. -->
                <DataGridTextColumn Header="Original" Binding="{Binding Original}" Width="*" MinWidth="120" />
                <DataGridTextColumn Header="Filed as" Binding="{Binding FiledAs}" Width="*" MinWidth="120" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" />
                <DataGridTextColumn Header="Route" Binding="{Binding Route}" Width="120" />
                <DataGridCheckBoxColumn Header="Undone" Binding="{Binding Reverted}" Width="70" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
