<Window x:Class="OrdoSort.Wpf.Windows.ProductionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrdoSort — Production report" Width="960" Height="680" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" AllowDrop="True"
        DragOver="OnDragOver" Drop="OnDrop"
        Style="{StaticResource {x:Type Window}}">
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <!-- Plain Button, not PrimaryButton — same reasoning as
                 TurnaroundWindow.xaml's own Export button: a utility export
                 action, not a commit action. -->
            <Button DockPanel.Dock="Right" Content="Close" Width="96" IsCancel="True" />
            <Button Content="Export to spreadsheet…" Command="{Binding ExportCommand}" />
        </DockPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- source row: same shape as TurnaroundWindow's — browse a
                 folder of sweep CSVs (or drag files/folders onto the window —
                 OnDrop below). -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Browse folder…" Command="{Binding BrowseCommand}" Margin="0,0,14,0" />
                <CheckBox Content="Include subfolders" IsChecked="{Binding IncludeSubfolders}"
                          VerticalAlignment="Center" Margin="0,0,14,0" />
                <Button Content="Clear" Command="{Binding ClearCommand}" Margin="0,0,14,0" />
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                           Style="{StaticResource StatusText}" MaxWidth="420" />
            </StackPanel>

            <!-- datetime column: feeds the derived Date/Hour columns
                 (ProductionReport.WithDerived) that GroupPicks/SumPicks pick
                 up automatically once set. -->
            <Grid Grid.Row="1" Style="{StaticResource FieldRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Date/time column:" Style="{StaticResource FieldLabel}" />
                <ComboBox Grid.Column="1" MinWidth="180"
                          ItemsSource="{Binding Headers}" SelectedItem="{Binding DatetimeColumn}" />
            </Grid>

            <!-- pick lists: Group by / Sum, side by side — same HeaderPick
                 checkbox-list pattern MatchMergeWindow.xaml uses for its own
                 ColumnPicks (Binding Name/IsChosen). Each list scrolls
                 independently rather than growing the window, since a wide
                 sweep can carry a lot of headers. -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
                        CornerRadius="4" Padding="10" MaxHeight="140">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Group by" Style="{StaticResource SectionText}"
                                   Margin="0,0,0,6" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding GroupPicks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChosen}"
                                                  Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
                        CornerRadius="4" Padding="10" MaxHeight="140">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Sum" Style="{StaticResource SectionText}"
                                   Margin="0,0,0,6" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SumPicks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChosen}"
                                                  Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- results: no <DataGrid.Columns> here at all — this is the one
                 grid in this feature whose columns are entirely dynamic
                 (which group/sum columns exist depends on the pick lists
                 above), built in code-behind exactly as TriageWindow.xaml.cs
                 builds Candidates' roster columns. Row/cell styling
                 (ElementStyle BasedOn GridCellText, the trailing "let
                 selection win" DataTrigger) is applied there too, per column,
                 for the same reason TriageWindow's own comment gives: a
                 DataGridColumn isn't part of the visual/logical tree, so it
                 can't pick up a XAML-declared implicit style the way a
                 regular element would. -->
            <DataGrid Grid.Row="3" x:Name="ResultsGrid" ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column" SelectionMode="Extended">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Theme.RowHover}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
