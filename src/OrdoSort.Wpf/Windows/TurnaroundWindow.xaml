<Window x:Class="OrdoSort.Wpf.Windows.TurnaroundWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrdoSort — Turn-around time" Width="900" Height="640" MinWidth="740" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" AllowDrop="True"
        DragOver="OnDragOver" Drop="OnDrop"
        Style="{StaticResource {x:Type Window}}">
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <!-- Plain Button, not PrimaryButton: FilenameListWindow's own
                 Save (and HistoryWindow's Export) — the closest analogues,
                 a utility export/save action rather than MatchMergeWindow's
                 Merge (which actually commits a file rename) — are plain
                 buttons too; PrimaryButton is reserved for that kind of
                 commit action elsewhere in the app. -->
            <Button DockPanel.Dock="Right" Content="Close" Width="96" IsCancel="True" />
            <Button Content="Export to spreadsheet…" Command="{Binding ExportCommand}" />
        </DockPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- source row: browse a folder of PECF report spreadsheets
                 (or drag files/folders onto the window — OnDrop below), same
                 shape as FilenameListWindow's own source row. -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Browse folder…" Command="{Binding BrowseCommand}" Margin="0,0,14,0" />
                <CheckBox Content="Include subfolders" IsChecked="{Binding IncludeSubfolders}"
                          VerticalAlignment="Center" Margin="0,0,14,0" />
                <Button Content="Clear" Command="{Binding ClearCommand}" Margin="0,0,14,0" />
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                           Style="{StaticResource StatusText}" MaxWidth="420" />
                <!-- Add feedback, same placement and style as
                     FilenameListWindow's: a drop that added nothing otherwise
                     reads as the window ignoring you. -->
                <TextBlock Text="{Binding AddNote}" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" Margin="14,0,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- mapping row: which loaded header names the document and
                 (optionally) its category, plus the over-threshold cutoff. -->
            <Grid Grid.Row="1" Style="{StaticResource FieldRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="File name column:" Style="{StaticResource FieldLabel}" />
                <ComboBox Grid.Column="1" MinWidth="160" Margin="0,0,20,0"
                          ItemsSource="{Binding Headers}" SelectedItem="{Binding FilenameColumn}" />
                <TextBlock Grid.Column="2" Text="Category column:" Style="{StaticResource FieldLabel}" />
                <!-- CategoryChoices is "" (no category) plus every loaded
                     header — SelectedItem binds straight to CategoryColumn
                     (a plain string, "" round-trips with no converter
                     needed on the SELECTED value); the ItemTemplate below
                     is display-only, dressing up how "" LOOKS in the
                     dropdown (NoneSentinelConverter — see TurnaroundViewModel
                     .CategoryChoices' own doc comment). -->
                <ComboBox Grid.Column="3" MinWidth="160" Margin="0,0,20,0"
                          ItemsSource="{Binding CategoryChoices}" SelectedItem="{Binding CategoryColumn}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource NoneSentinel}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Column="4" Text="Threshold (days):" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Column="5" Width="60"
                         Text="{Binding ThresholdDays, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <TabControl Grid.Row="2">
                <!-- Documents: one row per computed document, IsOverThreshold
                     rows picked out in Theme.Warning — the row background is
                     ONLY safe to read against Theme.WarningText, never the
                     default Theme.Text (MainWindow's own set-aside/history-
                     backup banners pair the two the same way), so every text
                     column below carries its own IsOverThreshold trigger
                     alongside the usual trailing "let selection win" one —
                     see HistoryWindow.xaml's long GridCellText comment for
                     why a column-level Style Setter is what it takes to beat
                     a DataGridCell's own IsSelected trigger, the same trap
                     this mirrors. -->
                <TabItem Header="Documents">
                    <!-- x:Name: TurnaroundWindow.xaml.cs tracks this grid's own
                         live ActualWidth (DataGridColumnCap.Track) to keep the
                         Category column's cap correct as the window is
                         resized — see that file's own comment for why:
                         Category is user-mappable to ANY loaded header, so
                         unlike Doc date/Upload date/TAT (days) it has no
                         natural bound on its own. -->
                    <DataGrid x:Name="DocumentsGrid" ItemsSource="{Binding Documents}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                              SelectionMode="Extended">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource Theme.RowHover}" />
                                    </Trigger>
                                    <!-- declared AFTER IsMouseOver so an
                                         over-threshold row stays visibly
                                         flagged even while hovered — the
                                         thing this whole tab exists to call
                                         out shouldn't fade under the mouse. -->
                                    <DataTrigger Binding="{Binding IsOverThreshold}" Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource Theme.Warning}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File name" Binding="{Binding FileName}"
                                                Width="*" MinWidth="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding FileName}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverThreshold}" Value="True">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource Theme.WarningText}" />
                                            </DataTrigger>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <Binding Path="IsSelected"
                                                             RelativeSource="{RelativeSource AncestorType=DataGridCell}" />
                                                </DataTrigger.Binding>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource Theme.AccentText}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <!-- x:Name="CategoryColumn": Category is user-
                                 mappable to ANY loaded header — unlike the
                                 four columns around it, its values are
                                 UNBOUNDED, so Width="Auto" alone (no cap)
                                 just grows to fit the longest mapped value
                                 with CharacterEllipsis never engaging,
                                 exactly the shape that produces a horizontal
                                 scrollbar on a wide value. Capped in code —
                                 TurnaroundWindow.xaml.cs, DataGridColumnCap —
                                 the same "content-sized, capped" shape every
                                 other grid's unbounded text column already
                                 uses. -->
                            <DataGridTextColumn x:Name="CategoryColumn" Header="Category"
                                                Binding="{Binding Category}" Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding Category}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverThreshold}" Value="True">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource Theme.WarningText}" />
                                            </DataTrigger>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <Binding Path="IsSelected"
                                                             RelativeSource="{RelativeSource AncestorType=DataGridCell}" />
                                                </DataTrigger.Binding>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource Theme.AccentText}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Doc date" Binding="{Binding DocDateText}" Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                        <Setter Property="ToolTip" Value="{Binding DocDateText}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverThreshold}" Value="True">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource Theme.WarningText}" />
                                            </DataTrigger>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <Binding Path="IsSelected"
                                                             RelativeSource="{RelativeSource AncestorType=DataGridCell}" />
                                                </DataTrigger.Binding>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource Theme.AccentText}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Upload date" Binding="{Binding UploadDateText}" Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                        <Setter Property="ToolTip" Value="{Binding UploadDateText}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverThreshold}" Value="True">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource Theme.WarningText}" />
                                            </DataTrigger>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <Binding Path="IsSelected"
                                                             RelativeSource="{RelativeSource AncestorType=DataGridCell}" />
                                                </DataTrigger.Binding>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource Theme.AccentText}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="TAT (days)" Binding="{Binding TatDaysText}" Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                        <Setter Property="TextAlignment" Value="Right" />
                                        <Setter Property="ToolTip" Value="{Binding TatDaysText}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverThreshold}" Value="True">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource Theme.WarningText}" />
                                            </DataTrigger>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <Binding Path="IsSelected"
                                                             RelativeSource="{RelativeSource AncestorType=DataGridCell}" />
                                                </DataTrigger.Binding>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource Theme.AccentText}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Daily averages">
                    <DataGrid ItemsSource="{Binding Daily}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                              SelectionMode="Extended">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource Theme.RowHover}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Period}" Width="*" MinWidth="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Avg TAT" Width="Auto"
                                                Binding="{Binding AverageDays, StringFormat={}{0:0.0}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                        <Setter Property="TextAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Documents" Binding="{Binding Count}" Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                        <Setter Property="TextAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Weekly averages">
                    <DataGrid ItemsSource="{Binding Weekly}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                              SelectionMode="Extended">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource Theme.RowHover}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Week" Binding="{Binding Period}" Width="*" MinWidth="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Avg TAT" Width="Auto"
                                                Binding="{Binding AverageDays, StringFormat={}{0:0.0}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                        <Setter Property="TextAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Documents" Binding="{Binding Count}" Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                        <Setter Property="TextAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Visibility bound to HasCategories: no real category
                     column means one blank-named group, which is noise, not
                     information — see TurnaroundViewModel.RebuildDisplay's
                     own comment. -->
                <TabItem Header="By category" Visibility="{Binding HasCategories, Converter={StaticResource BoolToVis}}">
                    <DataGrid ItemsSource="{Binding Categories}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                              SelectionMode="Extended">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource Theme.RowHover}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" MinWidth="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding Category}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Avg TAT" Width="Auto"
                                                Binding="{Binding AverageDays, StringFormat={}{0:0.0}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                        <Setter Property="TextAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Documents" Binding="{Binding Count}" Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                        <Setter Property="TextAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Over threshold" Binding="{Binding OverThreshold}" Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                        <Setter Property="TextAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
