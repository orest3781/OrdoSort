<Window x:Class="OrdoSort.Wpf.Windows.ListReformatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OrdoSort.Wpf.ViewModels"
        Title="OrdoSort — List reformatter" Width="620" Height="520" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource {x:Type Window}}">
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Width="96" IsCancel="True" />
            <StackPanel Orientation="Horizontal">
                <Button Click="OnPasteAndCopy" Style="{StaticResource PrimaryButton}"
                        MinWidth="120" Margin="0,0,8,0">
                    <TextBlock Text="Paste &amp; copy" Style="{StaticResource PrimaryButtonLabel}" />
                </Button>
                <Button Content="Copy result" Click="OnCopyResult" Margin="0,0,10,0" />
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                           Style="{StaticResource StatusText}" MaxWidth="240" />
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Paste your list:" Margin="0,0,0,10" />
            <TextBox Grid.Row="1" Margin="0,0,0,10"
                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />

            <!-- WrapPanel, not a horizontal StackPanel: at the window's
                 MinWidth the Clear button used to march off the window edge —
                 wrapping keeps every control on screen (WindowOverflowTests) -->
            <WrapPanel Grid.Row="2" Margin="0,0,0,10">
                <CheckBox Content="Quote each item" IsChecked="{Binding Quote}"
                          VerticalAlignment="Center" Margin="0,4,14,4" />
                <CheckBox Content="Space after separator" IsChecked="{Binding SpaceAfterComma}"
                          VerticalAlignment="Center" Margin="0,4,14,4" />
                <CheckBox Content="Drop duplicates" IsChecked="{Binding Dedupe}"
                          VerticalAlignment="Center" Margin="0,4,14,4" />
                <Button Content="Clear" Command="{Binding ClearCommand}" Margin="0,4" />
            </WrapPanel>

            <!-- Second row of controls rather than more items in the WrapPanel
                 above: the picker and its delimiter box belong together, and
                 splitting them across a wrap would read as two unrelated
                 controls at the window's MinWidth. -->
            <WrapPanel Grid.Row="3" Margin="0,0,0,10" VerticalAlignment="Center">
                <TextBlock Text="Join as:" VerticalAlignment="Center" Margin="0,4,8,4" />
                <ComboBox MinWidth="170" VerticalAlignment="Center" Margin="0,4,14,4"
                          ItemsSource="{x:Static vm:ListReformatViewModel.ShapeChoices}"
                          SelectedValuePath="Key"
                          SelectedValue="{Binding Shape}"
                          ItemTemplate="{StaticResource KvpValueTemplate}" />
                <TextBox Width="70" VerticalAlignment="Center" Margin="0,4,8,4"
                         ToolTip="Text to put between items"
                         Text="{Binding CustomDelimiter, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsCustomDelimiter}" />
            </WrapPanel>

            <DockPanel Grid.Row="4" Margin="0,0,0,10">
                <TextBlock DockPanel.Dock="Left" Text="Result:" Margin="0,0,10,0" />
                <TextBlock Text="{Binding CountsLine}" TextWrapping="Wrap"
                           Style="{StaticResource SubtleText}" />
            </DockPanel>
            <TextBox Grid.Row="5"
                     Text="{Binding OutputText, Mode=OneWay}"
                     IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
        </Grid>
    </DockPanel>
</Window>
