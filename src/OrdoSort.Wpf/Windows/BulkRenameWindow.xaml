<Window x:Class="OrdoSort.Wpf.Windows.BulkRenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrdoSort — Bulk rename" Width="820" Height="640" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" AllowDrop="True"
        DragOver="OnDragOver" Drop="OnDrop"
        Style="{StaticResource {x:Type Window}}">
    <Window.Resources>
        <!-- Chrome shared by the four operation cards below (house card
             style: Theme.Surface fill, Theme.Border edge, 4px corners,
             10/8 padding). Local to this window — BulkRename is presently
             the only place fields are grouped into named cards this way. -->
        <Style x:Key="ParamCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Width="96" IsCancel="True" />
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding RenameCommand}"
                        Style="{StaticResource PrimaryButton}" MinWidth="130" Margin="0,0,8,0"
                        AutomationProperties.Name="{Binding RenameButtonText}">
                    <StackPanel Orientation="Horizontal">
                        <!-- Same glyph as this tool's own Tools menu entry
                             (MainWindow.xaml, "_Bulk rename…") — E8AC. -->
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8AC;" Margin="0,0,8,0"
                                   Foreground="{DynamicResource Theme.AccentText}" />
                        <TextBlock Text="{Binding RenameButtonText}" Style="{StaticResource PrimaryButtonLabel}" />
                    </StackPanel>
                </Button>
                <Button Content="Undo last rename" Command="{Binding UndoCommand}" Margin="0,0,10,0" />
                <!-- the batch's brake, same shape as UnlockWindow's: files
                     already renamed stay renamed and Undo still covers them,
                     the rest are simply not started -->
                <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,10,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                           Style="{StaticResource StatusText}" MaxWidth="360" />
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <CheckBox Content="Review files: rename to &lt;received date&gt;-LAST-FIRST"
                          IsChecked="{Binding ReviewMode}" VerticalAlignment="Center" />
                <TextBlock Text="received:" VerticalAlignment="Center" Margin="12,0,8,0" />
                <DatePicker SelectedDate="{Binding ReceivedDate}"
                            AutomationProperties.Name="Received date"
                            IsEnabled="{Binding ReviewMode}" Width="130" />
            </StackPanel>

            <!-- Row 1: operation-parameter cards (approved mockup,
                 2026-08-09). Replaces the old fixed 6-col/3-row FieldRow
                 Grid, whose Delete-segment row needed a ColumnSpan="3"
                 workaround to borrow width from neighbouring columns it
                 didn't otherwise use — a rigid shared grid can't give one
                 row more room than the others without doing that. Four
                 independently-sized cards in a WrapPanel have no shared
                 column to overflow: each gets whatever width its own
                 content needs, and the row wraps instead of clipping. -->
            <WrapPanel Grid.Row="1">
                <Border Style="{StaticResource ParamCard}" MinWidth="230">
                    <StackPanel>
                        <TextBlock Text="Find &amp; replace" Style="{StaticResource SectionText}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Find:" VerticalAlignment="Center" Margin="0,0,8,6" />
                            <TextBox Grid.Column="1" Width="150" Margin="0,0,0,6"
                                     Text="{Binding Find, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Find text" />
                            <TextBlock Grid.Row="1" Text="Replace with:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Width="150"
                                     Text="{Binding Replace, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Replace with" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ParamCard}" MinWidth="190">
                    <StackPanel>
                        <!-- "Add" carries the card header; the two rows below
                             say only "At start:"/"At end:" (the old row-level
                             labels were "Add at start:"/"Add at end:" — the
                             word the header now carries). -->
                        <TextBlock Text="Add" Style="{StaticResource SectionText}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="At start:" VerticalAlignment="Center" Margin="0,0,8,6" />
                            <TextBox Grid.Column="1" Width="130" Margin="0,0,0,6"
                                     Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Add at start" />
                            <TextBlock Grid.Row="1" Text="At end:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Width="130"
                                     Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Add at end" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ParamCard}" MinWidth="200">
                    <StackPanel>
                        <TextBlock Text="Delete segments" Style="{StaticResource SectionText}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="1" IsChecked="{Binding DeleteSeg1}" Margin="0,4,14,4" />
                            <CheckBox Content="2" IsChecked="{Binding DeleteSeg2}" Margin="0,4,14,4" />
                            <CheckBox Content="3" IsChecked="{Binding DeleteSeg3}" Margin="0,4,14,4" />
                            <CheckBox Content="4" IsChecked="{Binding DeleteSeg4}" Margin="0,4,14,4" />
                            <CheckBox Content="last" IsChecked="{Binding DeleteSegLast}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ParamCard}" MinWidth="150">
                    <StackPanel>
                        <TextBlock Text="Letter case" Style="{StaticResource SectionText}" Margin="0,0,0,8" />
                        <ComboBox Width="150" SelectedIndex="{Binding CaseIndex}"
                                  AutomationProperties.Name="Letter case">
                            <ComboBoxItem Content="Keep case" />
                            <ComboBoxItem Content="UPPERCASE" />
                            <ComboBoxItem Content="lowercase" />
                        </ComboBox>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <DockPanel Grid.Row="2" Margin="0,0,0,8">
                <!-- the counts are also the way in: when files are waiting on a
                     name, this jumps to the first one and opens it for typing -->
                <Button DockPanel.Dock="Right" Click="OnJumpToNextStray"
                        Cursor="Hand" BorderThickness="0" Background="Transparent"
                        Padding="8,4" VerticalAlignment="Center"
                        ToolTip="Go to the next file that still needs a name"
                        AutomationProperties.Name="Go to the next file needing a name">
                    <TextBlock Text="{Binding CountsLine}" Style="{StaticResource SubtleText}" />
                </Button>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="Add files…" Click="OnAddFiles" Margin="0,0,6,0" />
                    <Button Content="Add a folder's files…" Click="OnAddFolder" Margin="0,0,6,0" />
                    <Button Content="Remove selected" Click="OnRemoveSelected" Margin="0,0,6,0"
                            IsEnabled="{Binding IsIdle}" />
                    <Button Content="Clear" Command="{Binding ClearCommand}" Margin="0,0,10,0" />
                </StackPanel>
                <TextBlock Text="{Binding AddNote}" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <Grid Grid.Row="3">
                <DataGrid x:Name="PreviewGrid" ItemsSource="{Binding Preview}" AutoGenerateColumns="False"
                          AutomationProperties.Name="Rename preview"
                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                          CellEditEnding="OnCellEditEnding" SelectionMode="Extended"
                          SelectionChanged="OnSelectionChanged"
                          PreviewKeyDown="OnGridKeyDown">
                    <DataGrid.RowStyle>
                        <!-- Local RowStyle, BasedOn the shared GridRow style
                             (Theme/Styles.xaml) — GridRow carries the
                             Background="Transparent" Setter and the
                             IsMouseOver→Theme.RowHover trigger this window
                             used to declare itself; only what's genuinely
                             local to this grid (ToolTip=Source, the NeedsName
                             tint) is left here. A derived style's own
                             Setters/Triggers apply after its base's, so
                             NeedsName below still layers on top of GridRow's
                             inherited hover trigger exactly as it did when
                             both lived in one Style. -->
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource GridRow}">
                            <Setter Property="ToolTip" Value="{Binding Source}" />
                            <Style.Triggers>
                                <!-- the few files waiting on a person: findable
                                     at a glance among rows that are already right.
                                     Theme.RowHover, NOT Theme.SurfaceHover: this
                                     row's Note column can show StatusAmber (see
                                     BulkRenameViewModel.ApplyPlans — NeedsName
                                     always implies NoteIsProblem) and its New
                                     name column can show SubtleText — exactly
                                     the vocabulary Theme.RowHover is tuned to
                                     protect (ThemePalette.cs's RowHover
                                     comment). -->
                                <DataTrigger Binding="{Binding NeedsName}" Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource Theme.RowHover}" />
                                    <Setter Property="ToolTip"
                                            Value="Needs a name — press F2 or Enter to type one" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <!-- Current name: content-sized; DataGridColumnCap
                             gives it its content width when that fits and a
                             proportional, trimmed share (table-rules Rule 4 —
                             used to say "wrapped" here) when it doesn't —
                             same mechanism and reasoning as
                             MatchMergeWindow's analogous "File" column: this
                             is the file's EXISTING name, the least
                             predictable string in the row, and not what a
                             rename batch exists to verify, so it's capped
                             rather than made the filler.

                             2026-08-07 autofit-columns superseded the prior
                             (2026-08-02 audit-remediation) shape here, which
                             made BOTH this column and New name star with a
                             shared MinWidth="120" floor specifically so
                             neither collapsed to WPF's bare 20px default under
                             a headless Show() (DataGridStarColumnTests still
                             covers that collapse for the one star column
                             remaining below). That reasoning about a
                             120px floor and this window's on-screen MinWidth
                             (700px) no longer applies to THIS column now that
                             it isn't star at all — flagging that explicitly
                             since a stale comment describing sizing the code
                             no longer has is exactly the trap this repo keeps
                             hitting. See New name's own comment below for
                             where that floor reasoning now lives. -->
                        <DataGridTextColumn x:Name="CurrentColumn" Header="Current name" Binding="{Binding Current}"
                                            IsReadOnly="True" Width="Auto">
                            <!-- BasedOn GridCellTextSelectionAware (Theme/
                                 Styles.xaml), not plain GridCellText or the
                                 bare {x:Type TextBlock} style: no status
                                 trigger of its own here, so the shared
                                 style's default Foreground + trailing "let
                                 selection win" DataTrigger is the whole fix —
                                 same bug and same shape as MatchMergeWindow's
                                 File/Becomes columns; see
                                 GridCellTextSelectionAware's own doc comment. -->
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextSelectionAware}" />
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- New name: the filler (Width="*", MinWidth="120" —
                             the same floor HistoryWindow's own star columns
                             use, so a headless Show() clamps rather than
                             collapses it to WPF's bare 20px default; see
                             DataGridStarColumnTests). This is the column the
                             whole window exists to produce, and the one a
                             person edits directly (click or F2), so it gets
                             whatever width Current name and Note don't need —
                             now ALL of the leftover, not half of it, since
                             Current name moved to a capped Auto column above
                             instead of also being star. It is also a
                             participant in DataGridColumnCap's split: when
                             the columns can't all have their content width it
                             gets a proportional share, never under this
                             floor, and trims with an ellipsis (table-rules
                             Rule 4 — used to wrap). -->
                        <DataGridTextColumn Header="New name  ·  click or press F2 to edit"
                                            Binding="{Binding NewName}" Width="*" MinWidth="120">
                            <!-- BasedOn GridCellText for the shared Theme.Text
                                 default — but the Changed="False" DataTrigger
                                 below still needs its own trailing "let
                                 selection win" DataTrigger, same as Note's
                                 (status-colour-vocabulary plan, Task 2 Step 2):
                                 this column's own SubtleText Setter is a Style
                                 Setter on THIS TextBlock, and it outranks
                                 whatever it would otherwise inherit from the
                                 selected DataGridCell just as surely as the
                                 dead RowStyle triggers this repo already fixed
                                 elsewhere — this one had NO override at all
                                 before (unlike Note, which already carried one),
                                 so an unchanged row picked up 1.85:1 SubtleText-
                                 on-Accent the moment it was selected. Declared
                                 last so it overrides both triggers above once
                                 selected. Only this display TextBlock trims
                                 (table-rules Rule 4 — used to wrap) — the
                                 editing TextBox (click or F2) stays the
                                 plain, single-line default DataGridTextColumn
                                 already supplies, which is right for typing a
                                 file name. -->
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Changed}" Value="False">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource Theme.SubtleText}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Manual}" Value="True">
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <Binding Path="IsSelected"
                                                         RelativeSource="{RelativeSource AncestorType=DataGridCell}" />
                                            </DataTrigger.Binding>
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource Theme.AccentText}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- Note: content-sized; DataGridColumnCap gives it its
                             content width when that fits and a proportional,
                             trimmed share (table-rules Rule 4 — used to say
                             "wrapped" here) when it doesn't. Was a
                             fixed 220px regardless of what it held. -->
                        <DataGridTextColumn x:Name="NoteColumn" Header="Note" Binding="{Binding Note}"
                                            IsReadOnly="True" Width="Auto">
                            <!-- BasedOn plain GridCellText, NOT
                                 GridCellTextSelectionAware, for the shared
                                 Theme.Text default; this column's own status
                                 triggers below still need their own trailing
                                 "let selection win" DataTrigger — see
                                 GridCellTextSelectionAware's own doc comment
                                 in Theme/Styles.xaml. -->
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                    <Style.Triggers>
                                        <!-- status-colour-vocabulary plan, Task 2 Step 2. Order
                                             matters: the two subtle triggers are declared first so
                                             NoteIsProblem (declared last) can override BOTH of them
                                             back to amber for the rare row where Plan() reported a
                                             problem AND the ViewModel's own "edited by hand"/
                                             "(no change)" annotation also applies (e.g. a manual
                                             override that collides with another target and gets a
                                             counter appended) — see NoteIsProblem's own doc comment
                                             in BulkRenameViewModel.cs for why Manual/Changed alone
                                             can't tell that case apart from a problem-free one. -->
                                        <DataTrigger Binding="{Binding Manual}" Value="True">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource Theme.SubtleText}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Changed}" Value="False">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource Theme.SubtleText}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NoteIsProblem}" Value="True">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource Theme.StatusAmber}" />
                                        </DataTrigger>
                                        <!-- Let selection win — same measured trap and same fix as
                                             MatchMergeWindow.xaml's Note column; see its comment for
                                             the contrast numbers. Declared last so it overrides
                                             every trigger above once selected. -->
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <Binding Path="IsSelected"
                                                         RelativeSource="{RelativeSource AncestorType=DataGridCell}" />
                                            </DataTrigger.Binding>
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource Theme.AccentText}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Drag files anywhere on this window, or press Add files…"
                           Style="{StaticResource EmptyStateText}"
                           IsHitTestVisible="False">
                    <TextBlock.Visibility>
                        <Binding Path="Preview.Count" Converter="{StaticResource ZeroToVis}" />
                    </TextBlock.Visibility>
                </TextBlock>
            </Grid>

            <TextBlock Grid.Row="4" Style="{StaticResource SubtleText}" Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Text="The Review rename runs first; Find/Replace, the affixes and Letter case apply after it. Double-click a New name to edit it by hand (clear it to go back). Extensions never change." />
        </Grid>
    </DockPanel>
</Window>
