<Window x:Class="OrdoSort.Wpf.Windows.BulkRenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrdoSort — Bulk rename" Width="820" Height="640" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" AllowDrop="True"
        DragOver="OnDragOver" Drop="OnDrop"
        Style="{StaticResource {x:Type Window}}">
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Width="96" IsCancel="True" />
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding RenameCommand}"
                        Style="{StaticResource PrimaryButton}" MinWidth="130" Margin="0,0,8,0"
                        AutomationProperties.Name="{Binding RenameButtonText}">
                    <TextBlock Text="{Binding RenameButtonText}" Style="{StaticResource PrimaryButtonLabel}" />
                </Button>
                <Button Content="Undo last rename" Command="{Binding UndoCommand}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                           Style="{StaticResource StatusText}" MaxWidth="360" />
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <CheckBox Content="Review files: rename to  &lt;received date&gt;-LAST-FIRST"
                          IsChecked="{Binding ReviewMode}" VerticalAlignment="Center" />
                <TextBlock Text="received:" VerticalAlignment="Center" Margin="12,0,6,0" />
                <DatePicker SelectedDate="{Binding ReceivedDate}"
                            IsEnabled="{Binding ReviewMode}" Width="130" />
            </StackPanel>

            <Grid Grid.Row="1" Style="{StaticResource FieldRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Find:" VerticalAlignment="Center" Margin="0,0,6,6" />
                <TextBox Grid.Column="1" Margin="0,0,14,6"
                         Text="{Binding Find, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="2" Text="Replace with:" VerticalAlignment="Center" Margin="0,0,6,6" />
                <TextBox Grid.Column="3" Margin="0,0,14,6"
                         Text="{Binding Replace, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="4" Text="Letter case:" VerticalAlignment="Center" Margin="0,0,6,6" />
                <ComboBox Grid.Column="5" Margin="0,0,0,6" SelectedIndex="{Binding CaseIndex}">
                    <ComboBoxItem Content="Keep case" />
                    <ComboBoxItem Content="UPPERCASE" />
                    <ComboBoxItem Content="lowercase" />
                </ComboBox>
                <TextBlock Grid.Row="1" Text="Add at start:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,14,0"
                         Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Add at end:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Grid.Row="1" Grid.Column="3" Margin="0,0,14,0"
                         Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="2" Text="Delete segment:" VerticalAlignment="Center" Margin="0,6,6,0" />
                <!-- ColumnSpan="3": this row's own five checkboxes measure
                     182px wide (Task 5, 2026-08-03 audit-remediation-finish),
                     12px over column 1's fixed 170px — the width every other
                     row's TextBox/ComboBox in this same Grid legitimately
                     needs, so it can't just be widened for this row alone.
                     Measured (headless, real Theme/Styles.xaml, off-screen
                     Show()+UpdateLayout()): with ColumnSpan="1" the fifth
                     checkbox's own glyph square painted fine (it fits inside
                     170px) but its "last" text painted NOTHING — zero pixels
                     differed from the window background, confirmed both by a
                     column-by-column pixel scan of the whole row and by a
                     WCAG contrast probe reading exactly 1.00 (fg==bg) even
                     though the TextBlock's resolved Foreground DP, Opacity,
                     Visibility and Clip were all completely normal at every
                     level of the visual tree — i.e. NOT the auto-wrap
                     Setter-outranks-inheritance trap this app has hit before
                     elsewhere (that trap still resolves a WRONG but PAINTED
                     colour; this was zero paint at all). Re-rendering the
                     identical bound CheckBox with no surrounding width
                     constraint reproduced it perfectly (49 distinct rendered
                     colours, "last" fully legible) — isolating the cause to
                     this row overflowing its column, not the checkbox itself.
                     Columns 2–3 carry no content on this row (only "Add at
                     end:"/its TextBox use them, on Row 1), so spanning into
                     them costs nothing here and gives ~170+Auto+170px of
                     headroom, comfortably covering the 182px this row needs
                     even at larger configured font sizes. -->
                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                            Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,14,0">
                    <CheckBox Content="1" IsChecked="{Binding DeleteSeg1}" Margin="0,0,8,0" />
                    <CheckBox Content="2" IsChecked="{Binding DeleteSeg2}" Margin="0,0,8,0" />
                    <CheckBox Content="3" IsChecked="{Binding DeleteSeg3}" Margin="0,0,8,0" />
                    <CheckBox Content="4" IsChecked="{Binding DeleteSeg4}" Margin="0,0,8,0" />
                    <CheckBox Content="last" IsChecked="{Binding DeleteSegLast}" />
                </StackPanel>
            </Grid>

            <DockPanel Grid.Row="2" Margin="0,0,0,8">
                <!-- the counts are also the way in: when files are waiting on a
                     name, this jumps to the first one and opens it for typing -->
                <Button DockPanel.Dock="Right" Click="OnJumpToNextStray"
                        Cursor="Hand" BorderThickness="0" Background="Transparent"
                        Padding="6,2" VerticalAlignment="Center"
                        ToolTip="Go to the next file that still needs a name"
                        AutomationProperties.Name="Go to the next file needing a name">
                    <TextBlock Text="{Binding CountsLine}" Style="{StaticResource SubtleText}" />
                </Button>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Add files…" Click="OnAddFiles" Margin="0,0,6,0" />
                    <Button Content="Add a folder's files…" Click="OnAddFolder" Margin="0,0,6,0" />
                    <Button Content="Remove selected" Click="OnRemoveSelected" Margin="0,0,6,0" />
                    <Button Content="Clear" Command="{Binding ClearCommand}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding AddNote}" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="3">
                <DataGrid x:Name="PreviewGrid" ItemsSource="{Binding Preview}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                          CellEditEnding="OnCellEditEnding" SelectionMode="Extended"
                          PreviewKeyDown="OnGridKeyDown">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="ToolTip" Value="{Binding Source}" />
                            <Style.Triggers>
                                <!-- the few files waiting on a person: findable
                                     at a glance among rows that are already right -->
                                <DataTrigger Binding="{Binding NeedsName}" Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource Theme.SurfaceHover}" />
                                    <Setter Property="ToolTip"
                                            Value="Needs a name — press F2 or Enter to type one" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <!-- Current name: content-sized (Width="Auto"), capped
                             in code (BulkRenameWindow.xaml.cs,
                             DataGridColumnCap) to a share of this window's
                             own declared Width — same mechanism and reasoning
                             as MatchMergeWindow's analogous "File" column:
                             this is the file's EXISTING name, the least
                             predictable string in the row, and not what a
                             rename batch exists to verify, so it's capped
                             rather than made the filler.

                             2026-08-07 autofit-columns superseded the prior
                             (2026-08-02 audit-remediation) shape here, which
                             made BOTH this column and New name star with a
                             shared MinWidth="120" floor specifically so
                             neither collapsed to WPF's bare 20px default under
                             a headless Show() (DataGridStarColumnTests still
                             covers that collapse for the one star column
                             remaining below). That reasoning about a
                             120px floor and this window's on-screen MinWidth
                             (700px) no longer applies to THIS column now that
                             it isn't star at all — flagging that explicitly
                             since a stale comment describing sizing the code
                             no longer has is exactly the trap this repo keeps
                             hitting. See New name's own comment below for
                             where that floor reasoning now lives. -->
                        <DataGridTextColumn x:Name="CurrentColumn" Header="Current name" Binding="{Binding Current}"
                                            IsReadOnly="True" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Current}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- New name: the filler (Width="*", MinWidth="120" —
                             the same floor HistoryWindow's own star columns
                             use, so a headless Show() clamps rather than
                             collapses it to WPF's bare 20px default; see
                             DataGridStarColumnTests). This is the column the
                             whole window exists to produce, and the one a
                             person edits directly (click or F2), so it gets
                             whatever width Current name and Note don't need —
                             now ALL of the leftover, not half of it, since
                             Current name moved to a capped Auto column above
                             instead of also being star. -->
                        <DataGridTextColumn Header="New name  ·  click or press F2 to edit"
                                            Binding="{Binding NewName}" Width="*" MinWidth="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding NewName}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Changed}" Value="False">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource Theme.SubtleText}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Manual}" Value="True">
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- Note: content-sized and capped the same way as
                             Current name above. Was a fixed 220px regardless
                             of what it held. -->
                        <DataGridTextColumn x:Name="NoteColumn" Header="Note" Binding="{Binding Note}"
                                            IsReadOnly="True" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Note}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Drag files anywhere on this window, or press Add files…"
                           Style="{StaticResource SubtleText}" Margin="10,36,10,10"
                           IsHitTestVisible="False">
                    <TextBlock.Visibility>
                        <Binding Path="Preview.Count" Converter="{StaticResource ZeroToVis}" />
                    </TextBlock.Visibility>
                </TextBlock>
            </Grid>

            <TextBlock Grid.Row="4" Style="{StaticResource SubtleText}" Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Text="The Review rename runs first; Find/Replace, the affixes and Letter case apply after it. Double-click a New name to edit it by hand (clear it to go back). Extensions never change." />
        </Grid>
    </DockPanel>
</Window>
