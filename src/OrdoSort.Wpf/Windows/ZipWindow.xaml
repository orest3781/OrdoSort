<Window x:Class="OrdoSort.Wpf.Windows.ZipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrdoSort — Zip" Width="640" Height="500" MinWidth="500" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" AllowDrop="True"
        DragOver="OnDragOver" Drop="OnDrop"
        Style="{StaticResource {x:Type Window}}">
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Width="96" IsCancel="True" />
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding CreateCommand}"
                        Style="{StaticResource PrimaryButton}" MinWidth="110" Margin="0,0,8,0"
                        AutomationProperties.Name="{Binding ZipButtonText}">
                    <TextBlock Text="{Binding ZipButtonText}" Style="{StaticResource PrimaryButtonLabel}" />
                </Button>
                <Button Content="Zip to…" Command="{Binding CreateAsCommand}" Margin="0,0,8,0" />
                <!-- The last create attempt's own verdict — "Created x.zip ·
                     3 items" or the failure message — gets StatusText, the
                     same style every other single-shot tool result line
                     uses (e.g. FilenameListWindow's Status). -->
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                           Style="{StaticResource StatusText}" MaxWidth="280" />
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Add files…" Click="OnAddFiles" Margin="0,0,6,0" />
                    <Button Content="Add folder…" Click="OnAddFolder" Margin="0,0,6,0" />
                    <Button Content="Remove selected" Click="OnRemoveSelected" Margin="0,0,6,0" />
                    <Button Content="Clear" Command="{Binding ClearCommand}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding AddNote}" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <DataGrid x:Name="ItemsGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                          SelectionMode="Extended">
                    <!-- Local RowStyle, same shape as ZipMergeWindow/PageCounts/
                         BulkRename's own — Theme.RowHover so the hover tint
                         stays consistent app-wide. -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="ToolTip" Value="{Binding Path}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource Theme.RowHover}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <!-- Item: the filler (Width="*") — the added file or
                             folder's own name. No status trigger of its own,
                             so GridCellTextSelectionAware's shared default
                             (plus its trailing "let selection win"
                             DataTrigger) is the whole style, same as
                             ZipMergeWindow's Zip column — NOT plain
                             GridCellText, which has no such trigger. Measured
                             directly (off-screen, before this fix, when this
                             column was plain GridCellText): Theme.Text on
                             Theme.Accent ranged 1.26:1-2.14:1 across every
                             scheme — this window shipped with the exact
                             selection-contrast bug GridCellTextSelectionAware
                             exists to prevent, just never switched to it. -->
                        <!-- MinWidth: this grid has no capped column today (Kind
                             holds only "file"/"folder"), so nothing competes for
                             width right now — the floor is here so that if one is
                             ever added, the path column already has the floor the
                             cap formula computes against. See PageCountsWindow.xaml. -->
                        <DataGridTextColumn Header="Item" Binding="{Binding Display}" Width="*" MinWidth="180">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextSelectionAware}">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Path}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- Kind: content-sized, "file"/"folder" — a quiet
                             tag rather than a status, so SubtleText rather
                             than GridCellText. SubtleText's own unconditional
                             Foreground Setter is the exact shape
                             GridCellTextSelectionAware's own doc comment
                             warns about (Theme/Styles.xaml): it outranks
                             whatever this TextBlock would otherwise INHERIT
                             from its ancestor DataGridCell, including the
                             Accent/AccentText pair the cell's own IsSelected
                             trigger paints — "this text never changes
                             color" is true in isolation but false once
                             selection is considered. Measured directly
                             (off-screen, before this trailing DataTrigger
                             existed): Theme.SubtleText on Theme.Accent
                             ranged 1.07:1-1.85:1 across every scheme, nowhere
                             near the 4.5:1 floor — a selected row's own
                             file/folder tag unreadable against its own
                             highlight, the same trap Note/Why/History's own
                             per-column fixes close, just never given this
                             column's own copy since it was BasedOn SubtleText
                             rather than GridCellText and so never went
                             through the review that added the others. Can't
                             delegate to GridCellTextSelectionAware (SubtleText
                             is a different base, not GridCellText), so this
                             is a local trailing "let selection win"
                             DataTrigger — same shape and same ancestor
                             (DataGridCell) every other status-coloured column
                             in the app uses. -->
                        <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubtleText}">
                                    <Style.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <Binding Path="IsSelected"
                                                         RelativeSource="{RelativeSource AncestorType=DataGridCell}" />
                                            </DataTrigger.Binding>
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource Theme.AccentText}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Drag files or folders anywhere on this window, or press Add…"
                           Style="{StaticResource SubtleText}" Margin="10,36,10,10"
                           IsHitTestVisible="False">
                    <TextBlock.Visibility>
                        <Binding Path="Rows.Count" Converter="{StaticResource ZeroToVis}" />
                    </TextBlock.Visibility>
                </TextBlock>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
