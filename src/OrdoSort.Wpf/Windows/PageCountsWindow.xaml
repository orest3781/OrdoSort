<Window x:Class="OrdoSort.Wpf.Windows.PageCountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF page counts" Width="700" Height="560" MinWidth="580" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" AllowDrop="True"
        DragOver="OnDragOver" Drop="OnDrop"
        Style="{StaticResource {x:Type Window}}">
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Width="96" IsCancel="True" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Copy to clipboard" Click="OnCopy" Margin="0,0,8,0" />
                <Button Content="Save as .txt…" Command="{Binding SaveCommand}" Margin="0,0,10,0" />
                <!-- The batch's own running verdict — "12 PDFs · 345 pages ·
                     2 unreadable" — gets StatusText, the same style every
                     other batch tool (Unlock's Summary, BulkRename/MatchMerge's
                     Status) uses for its own result line. -->
                <TextBlock Text="{Binding TotalLine}" VerticalAlignment="Center" Margin="0,0,10,0"
                           Style="{StaticResource StatusText}" MaxWidth="320" />
                <!-- Save/Copy feedback is a separate, secondary event from the
                     counting batch itself — CaptionText keeps it from
                     competing with TotalLine for attention, mirroring
                     FilenameListViewModel's own Status/copy plumbing. -->
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                           Style="{StaticResource CaptionText}" MaxWidth="200"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Add PDFs…" Click="OnAddFiles" Margin="0,0,6,0" />
                    <Button Content="Add a folder's PDFs…" Click="OnAddFolder" Margin="0,0,6,0" />
                    <Button Content="Remove selected" Click="OnRemoveSelected" Margin="0,0,6,0" />
                    <Button Content="Clear" Command="{Binding ClearCommand}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding AddNote}" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <DataGrid x:Name="CountsGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                          SelectionMode="Extended">
                    <!-- Local RowStyle, same shape as BulkRename/MatchMerge/
                         FilenameList's own — Theme.RowHover so the hover tint
                         stays consistent app-wide, and matters here because
                         the Note column can show StatusAmber below. -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="ToolTip" Value="{Binding Path}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource Theme.RowHover}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <!-- File: the filler (Width="*") — the source filename,
                             not the least predictable thing on this row (Note
                             carries that), so it gets whatever width Pages and
                             Note don't need. -->
                        <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*">
                            <!-- BasedOn GridCellText (Theme/Styles.xaml), not the
                                 bare {x:Type TextBlock} style: no status trigger
                                 of its own here, so the shared style's default
                                 Foreground + trailing "let selection win"
                                 DataTrigger is the whole fix — same shape as
                                 BulkRenameWindow's Current name / MatchMergeWindow's
                                 File column; see GridCellText's own doc comment. -->
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Path}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- Pages: content-sized and right-aligned — a column of
                             numbers reads fastest lined up on the ones place.
                             Blank for a row that's still Pending or that
                             couldn't be counted at all (Note carries the
                             explanation for the latter). -->
                        <DataGridTextColumn Header="Pages" Binding="{Binding Pages}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- Note: content-sized, amber whenever a row couldn't be
                             counted (PageCounts.Count never puts anything else
                             there) — the base Setter below is amber, reset to
                             plain text only for the common case (Pending or
                             counted cleanly, Note == ""). Same recipe as
                             BulkRenameWindow.xaml's Note column: a base
                             Setter/DataTrigger pair here, PLUS its own trailing
                             "let selection win" DataTrigger — GridCellText's
                             own copy of that trigger doesn't reliably win once
                             this style adds triggers of its own; see
                             GridCellText's and BulkRenameWindow's Note column's
                             doc comments for the measured contrast numbers
                             that recipe exists to fix. -->
                        <DataGridTextColumn x:Name="NoteColumn" Header="Note" Binding="{Binding Note}"
                                            Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Note}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.StatusAmber}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Note}" Value="">
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
                                        </DataTrigger>
                                        <!-- Declared last so it overrides the trigger
                                             above once selected — same measured trap
                                             and same fix as BulkRenameWindow.xaml's
                                             Note column. -->
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <Binding Path="IsSelected"
                                                         RelativeSource="{RelativeSource AncestorType=DataGridCell}" />
                                            </DataTrigger.Binding>
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource Theme.AccentText}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Drag PDFs anywhere on this window, or press Add PDFs…"
                           Style="{StaticResource SubtleText}" Margin="10,36,10,10"
                           IsHitTestVisible="False">
                    <TextBlock.Visibility>
                        <Binding Path="Rows.Count" Converter="{StaticResource ZeroToVis}" />
                    </TextBlock.Visibility>
                </TextBlock>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
