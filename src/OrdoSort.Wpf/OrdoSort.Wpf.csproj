<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OrdoSort</AssemblyName>
    <RootNamespace>OrdoSort.Wpf</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Per-monitor-v2 DPI awareness (with a graceful fallback for older
         Windows) — see app.manifest's own comment for why this is needed. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- also a WPF resource so windows show it when run via the dotnet host -->
    <Resource Include="app.ico" />
    <!-- empty-state illustrations (generated, de-whited, 512px) -->
    <Resource Include="Assets\*.png" />
    <!-- original synthesized alert sounds -->
    <Resource Include="Assets\sounds\*.wav" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copied beside the exe so AboutWindow's "View third-party notices"
         button (Task 1 Step 2) can open the real, shipped file via
         AppContext.BaseDirectory instead of a repo-relative path that
         wouldn't exist on an installed machine. Plain None+CopyToOutputDirectory,
         not a Resource/EmbeddedResource: this needs to be a standalone file
         on disk a shell association can open, not a WPF pack-URI resource. -->
    <None Include="..\..\THIRD-PARTY-NOTICES" Link="THIRD-PARTY-NOTICES"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- the WPF SDK drops the System.IO implicit using (Shapes.Path clash);
         this app is file-plumbing, so bring it back project-wide -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OrdoSort.Core\OrdoSort.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OrdoSort.Wpf.Tests" />
    <InternalsVisibleTo Include="OrdoSort.Smoke" />
  </ItemGroup>

</Project>
