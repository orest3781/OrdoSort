<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OrdoSort</AssemblyName>
    <RootNamespace>OrdoSort.Wpf</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Per-monitor-v2 DPI awareness (with a graceful fallback for older
         Windows) — see app.manifest's own comment for why this is needed. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- A published exe is meant to travel alone. Without this, publish
         copied the WebView2 package's three XML doc-comment files (~815 KB,
         IntelliSense data no user needs) beside the single-file exe
         (DW-81). -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <ItemGroup>
    <!-- also a WPF resource so windows show it when run via the dotnet host -->
    <Resource Include="app.ico" />
    <!-- No Assets\*.png glob: the four empty-state PNGs it used to ship
         (inbox-clear, done, labels-empty, unlock) were replaced by the vector
         ControlTemplates in Theme/Illustrations.xaml, which follow the theme.
         The files stayed behind and kept compiling in as ~353 KB of resources
         nothing referenced. Deleted 2026-08-22 (UI audit UI-03). Re-adding a
         glob here would silently ship whatever lands in Assets\ next; add an
         explicit <Resource Include="..."/> per file instead. -->
    <!-- original synthesized alert sounds -->
    <Resource Include="Assets\sounds\*.wav" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copied so the notices ship beside the exe rather than living only in
         the repo: the MIT terms these packages carry require the notice to
         accompany the distribution, and a build output handed to anyone is
         one. Plain None+CopyToOutputDirectory, not a Resource/EmbeddedResource:
         this needs to be a standalone file on disk that a shell association
         can open, not a WPF pack-URI resource only the app can read. -->
    <None Include="..\..\THIRD-PARTY-NOTICES" Link="THIRD-PARTY-NOTICES" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- the WPF SDK drops the System.IO implicit using (Shapes.Path clash);
         this app is file-plumbing, so bring it back project-wide -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OrdoSort.Core\OrdoSort.Core.csproj" />
    <ProjectReference Include="..\OrdoSort.Ui\OrdoSort.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <!-- The video pane (spec 2026-09-29-media-filing-loop, release 2).
         libVLC is LGPL-2.1+: it ships as separate DLLs in a libvlc folder
         beside the exe, never merged into it. -->
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- libVLC for 64-bit Windows only, and only the plugins that playing a
       local video needs: file access, the common containers, the decoders
       (avcodec covers H.264, HEVC, VP8/9, MPEG-4 and the usual audio; dav1d
       AV1), hardware decoding, video and audio output and the filters that
       rotate and convert. Left out: streaming, encoding, recording, network
       protocols, discs, subtitles, visualisations and Lua (about 110 MB
       down to roughly 50). -->
  <PropertyGroup>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>
  <ItemGroup>
    <VlcWindowsX64IncludeFiles Include="libvlc.dll;libvlccore.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\access\libfilesystem_plugin.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\demux\libmp4_plugin.dll;plugins\demux\libavi_plugin.dll;plugins\demux\libmkv_plugin.dll;plugins\demux\libasf_plugin.dll;plugins\demux\libes_plugin.dll;plugins\demux\libps_plugin.dll;plugins\demux\libts_plugin.dll;plugins\demux\libh26x_plugin.dll;plugins\demux\libogg_plugin.dll;plugins\demux\libmpgv_plugin.dll;plugins\demux\librawvid_plugin.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\codec\libavcodec_plugin.dll;plugins\codec\libdav1d_plugin.dll;plugins\codec\libd3d11va_plugin.dll;plugins\codec\libdxva2_plugin.dll;plugins\codec\libmft_plugin.dll;plugins\codec\libvorbis_plugin.dll;plugins\codec\libopus_plugin.dll;plugins\codec\libmpg123_plugin.dll;plugins\codec\libflac_plugin.dll;plugins\codec\libaraw_plugin.dll;plugins\codec\librawvideo_plugin.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\packetizer\%2A;plugins\video_output\%2A;plugins\video_chroma\%2A;plugins\video_filter\%2A;plugins\d3d11\%2A;plugins\d3d9\%2A;plugins\audio_output\%2A;plugins\audio_filter\%2A;plugins\audio_mixer\%2A;plugins\stream_filter\%2A" />
  </ItemGroup>

  <!-- libVLC stays a folder beside the exe in a single-file publish: the
       bundler would otherwise pack its DLLs into OrdoSort.exe (they are
       native), and LGPL wants them separate and replaceable. The package
       adds them as Content in its own target, so they are marked after it. -->
  <Target Name="KeepLibVlcBesideTheExe" AfterTargets="CollectVlcFilesToCopyWindows">
    <ItemGroup>
      <Content Condition="$([System.String]::Copy('%(Content.Link)').StartsWith('libvlc'))">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="OrdoSort.Wpf.Tests" />
    <InternalsVisibleTo Include="OrdoSort.Smoke" />
  </ItemGroup>

</Project>
