<Window x:Class="OrdoSort.Wpf.ProcessingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:views="clr-namespace:OrdoSort.Wpf.Views"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="OrdoSort — Processing" Width="1280" Height="860" MinWidth="900" MinHeight="600"
        Icon="pack://application:,,,/OrdoSort;component/app.ico"
        WindowStartupLocation="Manual"
        Style="{StaticResource {x:Type Window}}">
    <!-- A filing session in its own window (spec 2026-09-26): the viewer, the
         Processing screen and the Done summary. The dashboard (MainWindow)
         stays up beside it. The session's shortcuts live here, where the
         session is. -->
    <Window.InputBindings>
        <KeyBinding Key="K" Modifiers="Ctrl" Command="{Binding SkipCommand}" />
        <KeyBinding Key="Z" Modifiers="Ctrl+Shift" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Escape" Command="{Binding StopCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ViewerCol" Width="*" MinWidth="320" />
            <ColumnDefinition x:Name="SplitterCol" Width="5" />
            <ColumnDefinition x:Name="PanelCol" Width="430" MinWidth="370" />
        </Grid.ColumnDefinitions>
        <!-- data-entry tab order: the browser would trap Tab in the PDF
             toolbar, and the splitter/ScrollViewer are focus-ring noise —
             Tab goes name box → buttons. Mouse still focuses the viewer for
             keyboard scrolling inside the PDF. -->
        <wv2:WebView2 x:Name="Viewer" Grid.Column="0" Focusable="False"
                      Visibility="{Binding IsDocumentShown, Converter={StaticResource BoolToVis}}" />
        <!-- The video pane (spec 2026-09-29-media-filing-loop, release 2),
             in the Edge pane's place while a video is on screen. VLC draws
             into its own window, which WPF can't paint over, so the timeline
             sits below the picture, not on it; what is on the picture goes in
             the VideoView's own overlay (its Content). -->
        <DockPanel x:Name="VideoPane" Grid.Column="0"
                   Visibility="{Binding IsVideoShown, Converter={StaticResource BoolToVis}}"
                   Background="{DynamicResource Theme.WindowBg}">
            <Border DockPanel.Dock="Bottom" Padding="12,8" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource Theme.Border}" Background="{DynamicResource Theme.Surface}">
                <StackPanel>
                    <Slider x:Name="VideoTimeline" Minimum="0" Maximum="{Binding Video.LengthSeconds}"
                            Value="{Binding Video.PositionSeconds, Mode=TwoWay}"
                            IsMoveToPointEnabled="True" Focusable="False"
                            AutomationProperties.Name="Video position" />
                    <WrapPanel Margin="0,4,0,0">
                        <TextBlock Text="{Binding Video.TimeText}" Typography.NumeralAlignment="Tabular"
                                   FontWeight="SemiBold" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding Video.SpeedText}" Margin="0,0,12,0"
                                   Foreground="{DynamicResource Theme.StatusAmber}" />
                        <TextBlock Text="{Binding Video.MuteText}" Style="{StaticResource SubtleText}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="Alt+K play/pause · Alt+← → 5 s (Shift: 30 s) · Alt+, . one frame · Alt+J L rewind/faster · Alt+1–9 jump · Alt+M sound · wheel scrubs" />
                </StackPanel>
            </Border>
            <vlc:VideoView x:Name="VideoSurface" Background="Black">
                <Grid Background="#01000000" MouseWheel="OnVideoWheel">
                    <TextBlock Text="{Binding Video.Problem}" Foreground="White" FontSize="16"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="24"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Video.HasProblem, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </vlc:VideoView>
        </DockPanel>
        <GridSplitter x:Name="Split" Grid.Column="1" HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                      IsTabStop="False" />
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False"
                      Background="{DynamicResource Theme.WindowBg}">
            <Grid Margin="16,12">
                <Grid.Resources>
                    <!-- screens fade in over 150 ms — enough to soften the
                         switch, never enough to make anyone wait -->
                    <Style x:Key="ScreenFade" TargetType="UserControl">
                        <Style.Triggers>
                            <Trigger Property="Visibility" Value="Visible">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Resources>
                <views:ProcessingView Style="{StaticResource ScreenFade}"
                                      Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}" />
                <views:DoneView Style="{StaticResource ScreenFade}"
                                Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
