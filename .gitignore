# Build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
*.user
*.suo
.vs/

# Publish output
publish/
*.nupkg

# Demo runtime artifacts (generated by DemoReset / a demo run; not source).
# demo/names.txt IS source — the completer seed the demo config reads.
demo/config.json
demo/destinations.json
demo/monitored-folders.json
demo/alerts.json
demo/box-labels.json
demo/backups/
demo/failed/
demo/inbox/
demo/invoices/
demo/statements/
demo/deferred/
demo/publish/
demo/history.sqlite
demo/history.sqlite-*
demo/screenshot.png
# scratch route folders from exploratory filing runs
demo/test*/
# Match & Merge scratch: a run renames these in place (some already carry the
# matched id), so they are consumed input rather than a stable fixture
demo/merge-test/

# The full-size workbench (demo-full.bat regenerates it from scratch)
demo-full/

# Scratch audio: source material for the synthesized alert sounds. The ones
# the app actually ships live in src/OrdoSort.Wpf/Assets/sounds/.
# Anchored: a bare "sounds/" would match a folder of that name at ANY depth —
# including the shipped assets folder named in the line above.
/sounds/

# App runtime files
history.sqlite
history.sqlite-journal
history.sqlite-wal
history.sqlite-shm
crash.log
.env
