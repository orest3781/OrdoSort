# Build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
*.user
*.suo
.vs/

# Publish output
publish/
*.nupkg

# The full-size workbench (demo-full.bat regenerates it from scratch)
demo-full/

# Scratch audio: source material for the synthesized alert sounds. The ones
# the app actually ships live in src/OrdoSort.Wpf/Assets/sounds/.
# Anchored: a bare "sounds/" would match a folder of that name at ANY depth —
# including the shipped assets folder named in the line above.
/sounds/

# App runtime files
history.sqlite
history.sqlite-journal
history.sqlite-wal
history.sqlite-shm
crash.log
.env

# Claude Code session/agent state — never shipped, never reviewed
.claude/

# Real production/TAT exports used to design the report windows against live
# data. These contain REAL PATIENT NAMES and staff account names — they must
# never enter the repo. Kept out of the working tree's staging path entirely
# rather than relying on anyone remembering not to `git add -A`.
.realSamples/

# Agent/skill tooling state dropped into the repo by installers and the
# brainstorming visual companion — local scratch, never reviewed.
.agents/
.superpowers/
skills-lock.json
evidence/

# Playwright MCP artifacts (screenshots/traces from ad-hoc browser testing)
.playwright-mcp/

# Stray screenshots dropped at the repo root by ad-hoc tooling. Real app/site
# image assets live in src/OrdoSort.Wpf/Assets/ and ordosort.com/assets/ (and
# docs/), never at the repo root — this is anchored so those are unaffected.
/*.png
/*.jpg
/*.jpeg
